+    } else {
+      u8g2.drawCircle(4, 4, 2);
+    }
+
+    u8g2.setDrawColor(2);
+    drawTare();
+    drawShutdownFail();
+    drawAbout();
+    drawDebug();
+  } while (u8g2.nextPage());
+}
