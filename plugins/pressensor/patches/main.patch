+  } else {
+    snprintf(weightStr, sizeof(weightStr), "%.1f", weight);
+  }
+  snprintf(flowStr, sizeof(flowStr), "%.1f", flow);
+  snprintf(peakStr, sizeof(peakStr), "peak %.1f", pressensorShot.peakBar);
+  const uint32_t totalSeconds = elapsedMs / 1000;
