+  assert(grinderSettings.enabled == (expected == Mode::Grinder));
+  assert(pressensorSettings.enabled == (expected == Mode::Pressensor));
+}
+
+int main() {
+  settingsPreferences.begin("hds");
+  nvs["hds"][KEY_ACTIVE_INTEGRATION] = {PT_U8, static_cast<uint8_t>(Mode::Drs)};
+  assert(loadIntegrationSelection());
+#if HDS_ENABLE_HDS_DRS
+  assertOwner(Mode::Drs);
+  b_extraction = timerRunning = drsEspressoPrimeTarePending = true;
+  drsWebTarePending = true;
+  b_tareByButton = b_weight_quick_zero = true;
+  drsExtractionWeight = 27.0f;
+  drsContainerCapturedAt = 10;
+  toggleIntegration(Mode::Pressensor);
+  assertOwner(Mode::Pressensor);
+  assert(!b_extraction && !timerRunning && !drsEspressoPrimeTarePending && drsUseDefaultDose);
+  assert(!drsWebTarePending);
+  assert(!b_tareByButton && !b_weight_quick_zero);
+  assert(drsExtractionWeight == 0.0f && f_weight_dose == 18.0f && drsContainerCapturedAt == 0);
+  assert(sensorStarts == 1 && pressensorShot.pressureReady);
+
+  const int previousDetaches = sensorDetaches;
+  toggleIntegration(Mode::Grinder);
+  assertOwner(Mode::Grinder);
+  assert(sensorDetaches == previousDetaches + 1 && grinderStarts == 1 && grinderRuntime.menuPaused);
+
+  const int previousResets = grinderResets, previousSnapshots = snapshotUpdates;
+  grinderRuntime.relayOn = true;
+  toggleIntegration(Mode::Drs);
+  assertOwner(Mode::Grinder);
+  assert(blockedCount == 1 && grinderResets == previousResets && snapshotUpdates == previousSnapshots);
+
+  grinderRuntime.relayOn = false;
