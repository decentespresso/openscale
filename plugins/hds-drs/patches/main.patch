+            [compiler, "-std=c++17", "-Wall", "-Wextra", "-Werror", "-x", "c++", "-", "-o", str(binary)],
+            input=source, text=True, check=True,
+        )
+        subprocess.run([str(binary)], check=True)
+    print("hds-drs extraction runtime tests passed")
+
+
+if __name__ == "__main__":
+    main()
