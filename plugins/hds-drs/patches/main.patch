+  toggleIntegration(Mode::Pressensor);
+  assertOwner(Mode::Drs);
+  assert(drsContainerCapture && drsContainerCaptureStableSince == 300 && drsContainerCaptureLast == 25.0f);
+  saveFails = false;
+  toggleIntegration(Mode::Drs);
+  assertOwner(Mode::None);
