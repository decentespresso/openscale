diff --git a/include/hds_drs.h b/include/hds_drs.h
new file mode 100644
index 0000000..3ec7d7c
--- /dev/null
+++ b/include/hds_drs.h
@@ -0,0 +1,365 @@
+#ifndef HDS_DRS_H
+#define HDS_DRS_H
+
+#include "config.h"
+
+#if HDS_ENABLE_HDS_DRS
+
+#include "declare.h"
+#include "parameter.h"
+#include "scale_drift.h"
+#include "storage.h"
+
+constexpr float HDS_DRS_POUR_START_MIN_G = 1.0f;
+constexpr unsigned long HDS_DRS_POUR_START_DELAY_MS = 3000;
+constexpr float HDS_DRS_POUR_STABLE_G = 0.2f;
+constexpr unsigned long HDS_DRS_POUR_STABLE_MS = 1000;
+constexpr float HDS_DRS_POUR_CUP_REMOVED_G = 50.0f;
+constexpr float HDS_DRS_ESPRESSO_CUP_MIN_G = 30.0f;
+constexpr float HDS_DRS_ESPRESSO_STABLE_G = 0.5f;
+constexpr float HDS_DRS_ESPRESSO_NEGATIVE_TARE_G = -0.5f;
+constexpr unsigned long HDS_DRS_FLOW_INTERVAL_MS = 1000;
+
+inline void hdsDrsResetPourDetection() {
+  drsPourLastWeight = 0.0f;
+  drsPourStableWeight = 0.0f;
+  drsPourStableSince = 0;
+  drsPourStable = false;
+}
+
+inline void hdsDrsClearStamps() {
+  t_extraction_begin = 0;
+  t_extraction_first_drop = 0;
+  t_extraction_first_drop_num = 0;
+  t_extraction_last_drop = 0;
+  tareCounter = 0;
+  t_auto_tare = 0;
+  t_auto_stop = 0;
+  t_scale_stable = 0;
+  t_time_out = 0;
+  t_last_weight_adc = 0;
+  aWeight = 0.0f;
+}
+
+inline void hdsDrsSetSmoothWeight(float value) {
+  f_weight_smooth = value;
+}
+
+inline float hdsDrsDefaultDose() {
+  return b_mode ? INPUTCOFFEEESPRESSO : INPUTCOFFEEPOUROVER;
+}
+
+inline void hdsDrsAdjustModeDose(int mode, float delta) {
+  mode = mode ? 1 : 0;
+  float &dose = mode ? INPUTCOFFEEESPRESSO : INPUTCOFFEEPOUROVER;
+  dose += delta;
+  if (dose < 1.0f) dose = 1.0f;
+  if (dose > 100.0f) dose = 100.0f;
+  storagePutFloat(mode ? KEY_ESPRESSO : KEY_POUROVER, dose);
+  if (!b_extraction && b_mode == mode) {
+    f_weight_dose = dose;
+  }
+}
+
+inline void hdsDrsRefreshSnapshots() {
+  g_drsExtraction = b_extraction;
+  g_drsMode = b_mode;
+  g_drsFlow = f_flow_rate;
+  g_drsDose = f_weight_dose;
+  float ratio = f_weight_dose > 0.1f ? f_displayedValue / f_weight_dose : 0.0f;
+  if (ratio < 0.0f) ratio = 0.0f;
+  g_drsRatio = ratio;
+}
+
+inline void hdsDrsResetFlow() {
+  f_flow_rate = 0.0f;
+  f_flow_rate_last_weight = f_displayedValue;
+  t_flow_rate = millis();
+  dtostrf(f_flow_rate, 7, i_decimal_precision, c_flow_rate);
+  dtostrf(0.0f, 7, i_decimal_precision, c_brew_ratio);
+}
+
+inline void hdsDrsRequestEspressoCupTare() {
+  b_weight_quick_zero = true;
+  t_quickZeroStart = millis();
+  b_tareByButton = true;
+  t_tareByButton = millis();
+}
+
+inline void hdsDrsEnterExtraction() {
+  if (!b_drsEnabled || b_extraction) return;
+  b_extraction = true;
+  f_weight_dose = f_displayedValue;
+  hdsDrsClearStamps();
+  hdsDrsResetPourDetection();
+  hdsDrsSetSmoothWeight(f_displayedValue);
+  hdsDrsResetFlow();
+  resetDriftCompensation();
+  resetTracking();
+  resetStableOutput();
+  stopWatch.stop();
+  stopWatch.reset();
+  b_ready_to_brew = false;
+  b_weight_quick_zero = false;
+  b_minus_container = false;
+  t_ready_to_brew = 0;
+  if (b_mode == 1) {
+    hdsDrsRequestEspressoCupTare();
+  }
+  recordEnergyActivity();
+  hdsDrsRefreshSnapshots();
+}
+
+inline void hdsDrsExitExtraction() {
+  if (!b_extraction) return;
+  b_extraction = false;
+  stopWatch.stop();
+  stopWatch.reset();
+  b_ready_to_brew = false;
+  b_weight_quick_zero = false;
+  hdsDrsResetPourDetection();
+  resetDriftCompensation();
+  resetTracking();
+  resetStableOutput();
+  f_flow_rate = 0.0f;
+  recordEnergyActivity();
+  hdsDrsRefreshSnapshots();
+}
+
+inline void hdsDrsToggleExtraction() {
+  if (!b_drsEnabled) return;
+  if (b_extraction) {
+    hdsDrsExitExtraction();
+  } else {
+    hdsDrsEnterExtraction();
+  }
+}
+
+inline void hdsDrsCancelContainerCapture();
+
+inline void hdsDrsSetEnabled(bool enabled) {
+  b_drsEnabled = enabled;
+  storagePutBool(KEY_DRS_ENABLED, enabled);
+  if (!enabled) {
+    hdsDrsExitExtraction();
+    hdsDrsCancelContainerCapture();
+  }
+  hdsDrsRefreshSnapshots();
+}
+
+inline void hdsDrsCancelContainerCapture() {
+  drsContainerCapture = false;
+  drsContainerCaptureStableSince = 0;
+  drsContainerCaptureLast = 0.0f;
+}
+
+inline void hdsDrsStartContainerCapture() {
+  if (!b_drsEnabled) return;
+  if (b_extraction) hdsDrsExitExtraction();
+  drsContainerCapture = true;
+  drsContainerCaptureAt = millis();
+  drsContainerCaptureStableSince = 0;
+  drsContainerCaptureLast = 0.0f;
+  drsContainerCapturedAt = 0;
+}
+
+inline void hdsDrsServiceContainerCapture() {
+  if (!drsContainerCapture) return;
+  const unsigned long now = millis();
+  if (now - drsContainerCaptureAt > 60000) {
+    hdsDrsCancelContainerCapture();
+    return;
+  }
+  if (b_tareByButton) return;
+  const float weight = f_displayedValue;
+  if (fabsf(weight - drsContainerCaptureLast) <= 0.2f) {
+    if (drsContainerCaptureStableSince == 0) {
+      drsContainerCaptureStableSince = now;
+      return;
+    }
+    if (now - drsContainerCaptureStableSince < 1000) return;
+    if (weight < -0.5f) {
+      b_tareByButton = true;
+      t_tareByButton = millis();
+      drsContainerCaptureStableSince = 0;
+      drsContainerCaptureLast = 0.0f;
+      return;
+    }
+    if (weight >= 1.0f) {
+      drsContainerWeight = weight;
+      storagePutFloat(KEY_DRS_CONTAINER, drsContainerWeight);
+      drsContainerCapture = false;
+      drsContainerCapturedAt = now;
+      return;
+    }
+    drsContainerCaptureStableSince = 0;
+  } else {
+    drsContainerCaptureLast = weight;
+    drsContainerCaptureStableSince = 0;
+  }
+}
+
+inline void hdsDrsSetMode(int mode) {
+  mode = mode ? 1 : 0;
+  if (b_mode == mode) {
+    hdsDrsRefreshSnapshots();
+    return;
+  }
+  b_mode = mode;
+  storagePutInt(KEY_MODE, b_mode);
+  if (b_extraction) {
+    hdsDrsClearStamps();
+    hdsDrsResetPourDetection();
+    resetDriftCompensation();
+    resetTracking();
+    resetStableOutput();
+    stopWatch.stop();
+    stopWatch.reset();
+    b_ready_to_brew = false;
+    b_weight_quick_zero = false;
+    f_flow_rate = 0.0f;
+    if (b_mode == 1) {
+      hdsDrsRequestEspressoCupTare();
+    }
+  }
+}
+
+inline void hdsDrsToggleMode() {
+  hdsDrsSetMode(b_mode ? 0 : 1);
+}
+
+inline void hdsDrsOnTareComplete() {
+  hdsDrsResetPourDetection();
+  if (!b_extraction) return;
+  hdsDrsSetSmoothWeight(0.0f);
+  t_extraction_first_drop = 0;
+  t_extraction_first_drop_num = 0;
+  t_extraction_last_drop = 0;
+  tareCounter = 0;
+  aWeight = 0.0f;
+  b_ready_to_brew = true;
+  t_ready_to_brew = millis();
+  f_flow_rate_last_weight = 0.0f;
+  t_flow_rate = millis();
+}
+
+inline void hdsDrsUpdateFlow(unsigned long now) {
+  if (now - t_flow_rate < HDS_DRS_FLOW_INTERVAL_MS) return;
+  f_flow_rate = f_displayedValue - f_flow_rate_last_weight;
+  if (f_flow_rate < 0.0f) f_flow_rate = 0.0f;
+  f_flow_rate_last_weight = f_displayedValue;
+  t_flow_rate = now;
+  dtostrf(f_flow_rate, 7, i_decimal_precision, c_flow_rate);
+}
+
+inline void hdsDrsUpdatePour(unsigned long now) {
+  if (f_weight_dose < 3.0f) f_weight_dose = INPUTCOFFEEPOUROVER;
+  if (!stopWatch.isRunning() && stopWatch.elapsed() == 0) {
+    hdsDrsResetPourDetection();
+  }
+  if (b_ready_to_brew && !b_weight_quick_zero &&
+      f_displayedValue > HDS_DRS_POUR_START_MIN_G &&
+      now - t_ready_to_brew > HDS_DRS_POUR_START_DELAY_MS) {
+    stopWatch.start();
+    b_ready_to_brew = false;
+    hdsDrsResetPourDetection();
+  }
+  if (!stopWatch.isRunning()) return;
+  if (fabsf(f_displayedValue - drsPourLastWeight) <= HDS_DRS_POUR_STABLE_G) {
+    if (drsPourStableSince == 0) drsPourStableSince = now;
+    if (!drsPourStable && now - drsPourStableSince >= HDS_DRS_POUR_STABLE_MS) {
+      drsPourStable = true;
+      drsPourStableWeight = f_displayedValue;
+    }
+  } else {
+    drsPourLastWeight = f_displayedValue;
+    drsPourStableSince = 0;
+  }
+  if (drsPourStable &&
+      f_displayedValue < drsPourStableWeight - HDS_DRS_POUR_CUP_REMOVED_G) {
+    stopWatch.stop();
+    drsPourStable = false;
+  }
+}
+
+inline void hdsDrsUpdateEspresso(unsigned long now) {
+  if (f_weight_dose < 3.0f) f_weight_dose = INPUTCOFFEEESPRESSO;
+  if (now - t_scale_stable < (unsigned long)scaleStableInterval) return;
+  t_scale_stable = now;
+  if (fabsf(aWeight - f_weight_smooth) >= HDS_DRS_ESPRESSO_STABLE_G) {
+    if (t_extraction_begin > 0) {
+      if (tareCounter <= 3) {
+        tareCounter++;
+      } else if (t_extraction_first_drop == 0) {
+        t_extraction_first_drop = now;
+      }
+    }
+    aWeight = f_weight_smooth;
+    return;
+  }
+  aWeight = f_weight_smooth;
+  if (now - t_auto_tare < (unsigned long)autoTareInterval) return;
+  if (t_extraction_begin > 0 && tareCounter > 3 &&
+      t_extraction_first_drop != 0) {
+    if (t_extraction_last_drop == 0) t_extraction_last_drop = now;
+    if (t_extraction_last_drop - t_extraction_first_drop <
+        (unsigned long)i_extraction_minimium_timer * 1000UL) {
+      t_extraction_last_drop = 0;
+    } else if (b_ready_to_brew && stopWatch.isRunning()) {
+      stopWatch.stop();
+      b_ready_to_brew = false;
+    }
+  }
+  if (stopWatch.isRunning() || stopWatch.elapsed() != 0) return;
+  t_auto_tare = now;
+  if (f_displayedValue > HDS_DRS_ESPRESSO_CUP_MIN_G && !b_minus_container) {
+    scale.tare();
+    tareCounter = 0;
+    t_extraction_last_drop = 0;
+    t_extraction_first_drop = 0;
+    t_extraction_first_drop_num = 0;
+    stopWatch.reset();
+    stopWatch.start();
+    b_ready_to_brew = true;
+    t_extraction_begin = millis();
+    t_auto_tare = millis();
+    aWeight = 0.0f;
+    f_displayedValue = 0.0f;
+    hdsDrsSetSmoothWeight(0.0f);
+    hdsDrsResetPourDetection();
+    return;
+  }
+  if (f_displayedValue < HDS_DRS_ESPRESSO_NEGATIVE_TARE_G) {
+    scale.tare();
+    b_ready_to_brew = true;
+    f_displayedValue = 0.0f;
+    hdsDrsSetSmoothWeight(0.0f);
+  }
+}
+
+inline void hdsDrsSample(float driftCorrectedWeight) {
+  f_weight_smooth = driftCorrectedWeight;
+  if (f_weight_smooth >= f_displayedValue - OledTolerance &&
+      f_weight_smooth <= f_displayedValue + OledTolerance) {
+    if (f_weight_smooth > -0.1f && f_weight_smooth < 0.1f) {
+      f_displayedValue = 0.0f;
+    }
+  } else {
+    f_displayedValue = f_weight_smooth;
+  }
+  float ratio = f_weight_dose > 0.1f ? f_displayedValue / f_weight_dose : 0.0f;
+  if (ratio < 0.0f) ratio = 0.0f;
+  dtostrf(ratio, 7, i_decimal_precision, c_brew_ratio);
+  const unsigned long now = millis();
+  if (b_mode == 1) {
+    hdsDrsUpdateEspresso(now);
+  } else {
+    hdsDrsUpdatePour(now);
+  }
+  hdsDrsUpdateFlow(now);
+  hdsDrsRefreshSnapshots();
+}
+
+#endif
+
+#endif
