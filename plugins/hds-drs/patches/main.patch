+import os
+import re
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+PREFERENCES = r"""
+#pragma once
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <string>
+#include <variant>
+
+using NvsValue = std::variant<uint8_t, float, bool>;
+std::map<std::string, NvsValue> drsNvs;
+bool canOpen = true, namespaceExists = true, canWrite = true;
+int opens = 0;
+
+class Preferences {
+  bool readOnly = false;
+
+  template<typename T> T get(const char *key, T fallback) const {
+    assert(readOnly);
+    const auto found = drsNvs.find(key);
+    if (found == drsNvs.end()) return fallback;
+    const auto value = std::get_if<T>(&found->second);
+    return value ? *value : fallback;
+  }
+
+  template<typename T> size_t put(const char *key, T value) {
+    assert(!readOnly);
+    if (!canWrite) return 0;
+    drsNvs[key] = value;
+    return sizeof(T);
+  }
+
+ public:
+  bool begin(const char *name, bool read) {
+    assert(std::strcmp(name, "hds-drs") == 0);
+    ++opens;
+    readOnly = read;
+    return canOpen && (!readOnly || namespaceExists);
+  }
+  uint8_t getUChar(const char *key, uint8_t fallback) const { return get(key, fallback); }
+  float getFloat(const char *key, float fallback) const { return get(key, fallback); }
+  bool getBool(const char *key, bool fallback) const { return get(key, fallback); }
+  size_t putUChar(const char *key, uint8_t value) { return put(key, value); }
+  size_t putFloat(const char *key, float value) { return put(key, value); }
+  size_t putBool(const char *key, bool value) { return put(key, value); }
+};
+"""
+
+HARNESS = r"""
+#include <cmath>
+#include <limits>
+
+#define CONFIG_H
+#define PARAMETER_H
+#define HDS_ENABLE_HDS_DRS 1
+
+constexpr float OVER_WEIGHT = 1500.0f;
+DRS_DEFAULTS
+bool b_extraction = true, drsUseDefaultDose = true;
+float f_weight_dose = 16.0f;
+const char *actionMessage, *actionMessage2;
+void menuActionMessageChanged() {}
+void showStoredAction(const char *, bool, bool) {}
+
+#include "hds_drs_storage.h"
+
+CALLERS
+
+void expectDefaults() {
+  assert(drsBrewMode == 0 && drsPourDose == 16.0f && drsEspressoDose == 18.0f);
+  assert(drsContainerWeight == 0.0f && !drsContainerEnabled);
+}
+
+int main() {
+  namespaceExists = false;
+  hdsDrsLoadSettings();
+  expectDefaults();
+  assert(drsNvs.empty());
+  namespaceExists = true;
+  hdsDrsLoadSettings();
+  expectDefaults();
+
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  const float infinity = std::numeric_limits<float>::infinity();
+  drsNvs = {{drsContainerEnabledKey, true}};
+  for (const auto &invalidMode : {NvsValue{uint8_t{2}}, NvsValue{uint8_t{255}}, NvsValue{nan}}) {
+    drsNvs[drsModeKey] = invalidMode;
+    for (float invalid : {-1.0f, 0.99f, 1500.1f, infinity, -infinity, nan}) {
+      drsNvs[drsPourDoseKey] = invalid;
+      drsNvs[drsEspressoDoseKey] = invalid;
+      drsNvs[drsContainerKey] = invalid;
+      hdsDrsLoadSettings();
+      expectDefaults();
+    }
+  }
+
+  const int opensBeforeReject = opens;
+  for (float invalid : {0.99f, 100.01f, infinity, -infinity, nan}) {
+    assert(!hdsDrsStoreDose(0, invalid));
+  }
+  for (float invalid : {0.99f, OVER_WEIGHT + 0.1f, infinity, -infinity, nan}) {
+    assert(!hdsDrsStoreContainer(invalid));
+  }
+  assert(opens == opensBeforeReject);
+
+  assert(hdsDrsStoreMode(-1) && std::get<uint8_t>(drsNvs.at(drsModeKey)) == 0);
+  assert(hdsDrsStoreMode(1));
+  assert(hdsDrsStoreDose(0, 1.0f) && hdsDrsStoreDose(1, 100.0f));
+  assert(hdsDrsStoreContainer(1.0f) && hdsDrsStoreContainer(OVER_WEIGHT));
+  assert(hdsDrsStoreContainerEnabled(true));
+  hdsDrsLoadSettings();
+  assert(drsBrewMode == 1 && drsPourDose == 1.0f && drsEspressoDose == 100.0f);
+  assert(drsContainerWeight == OVER_WEIGHT && drsContainerEnabled);
+
+  const auto persisted = drsNvs;
+  f_weight_dose = drsEspressoDose;
+  canWrite = false;
+  assert(!hdsDrsStoreMode(0) && !hdsDrsStoreContainer(100.0f));
+  assert(!hdsDrsAdjustModeDose(1, -0.5f));
+  assert(drsEspressoDose == 100.0f && f_weight_dose == 100.0f);
+  toggleDrsContainer();
+  assert(drsContainerEnabled && drsNvs == persisted);
+  canOpen = false;
+  assert(!hdsDrsStoreDose(0, 17.0f) && !hdsDrsStoreContainerEnabled(false));
+  assert(drsNvs == persisted);
+}
+"""
+
+
+def main():
+    compiler = os.environ.get("CXX") or shutil.which("g++") or shutil.which("clang++")
+    assert compiler, "g++ or clang++ required"
+    include = ROOT / "include"
+    base = (include / "storage.h").read_text(encoding="utf-8")
+    assert re.search(r"\b(?:KEY_DRS_\w*|hdsDrs\w*|hds_drs_\w*|drs\w*)\b", base) is None, (
+        "Keep DRS keys and migration/default logic out of base storage"
+    )
+    parameters = (include / "parameter.h").read_text(encoding="utf-8")
+    defaults = []
+    for name in ("drsBrewMode", "drsPourDose", "drsEspressoDose", "drsContainerWeight", "drsContainerEnabled"):
+        defaults.append(re.search(rf"^(?:int|float|bool) {name} = [^;\n]+;", parameters, re.M).group())
+    callers = []
+    for file, function in (("hds_drs.h", "hdsDrsAdjustModeDose"), ("menu.h", "toggleDrsContainer")):
+        source = (include / file).read_text(encoding="utf-8")
+        pattern = rf"^(?:inline )?\w+ {function}\([^;\n]*\) \{{.*?^\}}"
+        callers.append(re.search(pattern, source, re.M | re.S).group())
+    with tempfile.TemporaryDirectory(prefix="hds-drs-storage-") as directory:
+        temp = Path(directory)
+        (temp / "Preferences.h").write_text(PREFERENCES, encoding="utf-8")
+        binary = temp / ("storage.exe" if os.name == "nt" else "storage")
+        subprocess.run(
+            [compiler, "-std=c++17", "-Wall", "-Wextra", "-Werror", "-I", directory,
+             "-I", str(include), "-x", "c++", "-", "-o", str(binary)],
+            input=HARNESS.replace("CALLERS", "\n".join(callers)).replace("DRS_DEFAULTS", "\n".join(defaults)),
+            text=True, check=True,
+        )
+        subprocess.run([str(binary)], check=True)
+    print("hds-drs storage tests passed")
+
+
+if __name__ == "__main__":
+    main()
