+    source = setup + "\nint grinderResets = 0, sensorDetaches = 0, blockedCount = 0, failedSaves = 0;\n" + callbacks
+    source = source.replace("void grinderRuntimeReset() {", "void grinderRuntimeReset() { ++grinderResets;")
+    source = source.replace("void pressensorApplyLinkTarget() {",
+                            "void pressensorApplyLinkTarget() { sensorDetaches += !pressensorSettings.enabled;")
+    source += r'''
+#if HDS_ENABLE_HDS_DRS
