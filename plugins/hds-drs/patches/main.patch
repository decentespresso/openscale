diff --git a/include/hds_drs.h b/include/hds_drs.h
new file mode 100644
index 0000000000000000000000000000000000000000..45d10831abc9774391c2e65c6ea61b79755ed876
--- /dev/null
+++ b/include/hds_drs.h
@@ -0,0 +1,372 @@
+#ifndef HDS_DRS_H
+#define HDS_DRS_H
+
+#include "config.h"
+
+#if HDS_ENABLE_HDS_DRS
+
+#include "declare.h"
+#include "hds_drs_storage.h"
+#include "parameter.h"
+
+inline bool hdsDrsIsActive() {
+  return activeIntegration == IntegrationMode::Drs;
+}
+
+constexpr float HDS_DRS_POUR_START_MIN_G = 1.0f;
+constexpr unsigned long HDS_DRS_POUR_START_DELAY_MS = 3000;
+constexpr float HDS_DRS_POUR_STABLE_G = 0.2f;
+constexpr unsigned long HDS_DRS_POUR_STABLE_MS = 1000;
+constexpr float HDS_DRS_POUR_CUP_REMOVED_G = 50.0f;
+constexpr float HDS_DRS_MIN_MEASURED_DOSE_G = 3.0f;
+constexpr float HDS_DRS_ESPRESSO_CUP_MIN_G = 30.0f;
+constexpr float HDS_DRS_ESPRESSO_STABLE_G = 0.5f;
+constexpr float HDS_DRS_ESPRESSO_FLOW_STABLE_G = 0.2f;
+constexpr float HDS_DRS_ESPRESSO_NEGATIVE_TARE_G = -0.5f;
+constexpr unsigned long HDS_DRS_ESPRESSO_SETTLED_MS = 1000;
+constexpr unsigned long HDS_DRS_FLOW_INTERVAL_MS = 1000;
+
+inline void hdsDrsResetPourDetection() {
+  drsPourLastWeight = 0.0f;
+  drsPourStableWeight = 0.0f;
+  drsPourStableSince = 0;
+  drsPourStable = false;
+}
+
+inline void hdsDrsResetExtractionStamps() {
+  t_extraction_begin = 0;
+  t_extraction_first_drop = 0;
+  t_extraction_last_drop = 0;
+  t_scale_stable = millis();
+  aWeight = drsExtractionWeight;
+}
+
+inline bool hdsDrsContainerApplies(float gross) {
+  return drsContainerEnabled && drsContainerWeight >= 1.0f &&
+         gross >= drsContainerWeight - NegativeTolerance &&
+         gross <= drsContainerWeight + PositiveTolerance;
+}
+
+inline float hdsDrsPureWeight(float gross) {
+  if (!hdsDrsContainerApplies(gross)) return gross;
+  const float net = gross - drsContainerWeight;
+  return fabsf(net) < 0.05f ? 0.0f : net;
+}
+
+inline float hdsDrsBrewRatio() {
+  return b_extraction && f_weight_dose > 0.1f && drsExtractionWeight > 0.0f
+             ? drsExtractionWeight / f_weight_dose : 0.0f;
+}
+
+inline float hdsDrsDefaultDose() {
+  return drsBrewMode ? drsEspressoDose : drsPourDose;
+}
+
+inline bool hdsDrsAdjustModeDose(int mode, float delta) {
+  float &dose = mode ? drsEspressoDose : drsPourDose;
+  const float updated = fminf(100.0f, fmaxf(1.0f, dose + delta));
+  if (updated != dose && !hdsDrsStoreDose(mode, updated)) return false;
+  dose = updated;
+  if (b_extraction && drsUseDefaultDose && drsBrewMode == mode) {
+    f_weight_dose = updated;
+  }
+  return true;
+}
+
+inline void hdsDrsRefreshSnapshots() {
+  const bool enabled = hdsDrsIsActive();
+  const bool extraction = enabled && b_extraction;
+  const float pureWeight = enabled ? hdsDrsPureWeight(f_displayedValue) : f_displayedValue;
+  const float weight = extraction ? drsExtractionWeight : pureWeight;
+  const float flow = extraction ? f_flow_rate : 0.0f;
+  const float ratio = extraction ? hdsDrsBrewRatio() : 0.0f;
+  const float dose = extraction ? f_weight_dose : hdsDrsDefaultDose();
+  const DrsStatusSnapshot snapshot{
+    enabled,
+    extraction,
+    drsBrewMode,
+    isfinite(weight) ? weight : 0.0f,
+    isfinite(flow) ? flow : 0.0f,
+    isfinite(ratio) ? ratio : 0.0f,
+    isfinite(dose) ? dose : 0.0f,
+    stopWatch.elapsed(),
+    stopWatch.isRunning()
+  };
+  portENTER_CRITICAL(&drsStatusMux);
+  drsStatusSnapshot.enabled = snapshot.enabled;
+  drsStatusSnapshot.extraction = snapshot.extraction;
+  drsStatusSnapshot.mode = snapshot.mode;
+  drsStatusSnapshot.weight = snapshot.weight;
+  drsStatusSnapshot.flow = snapshot.flow;
+  drsStatusSnapshot.ratio = snapshot.ratio;
+  drsStatusSnapshot.dose = snapshot.dose;
+  drsStatusSnapshot.timer = snapshot.timer;
+  drsStatusSnapshot.timerRunning = snapshot.timerRunning;
+  portEXIT_CRITICAL(&drsStatusMux);
+}
+
+inline DrsStatusSnapshot hdsDrsReadSnapshot() {
+  portENTER_CRITICAL(&drsStatusMux);
+  const DrsStatusSnapshot snapshot{
+    drsStatusSnapshot.enabled, drsStatusSnapshot.extraction,
+    drsStatusSnapshot.mode, drsStatusSnapshot.weight, drsStatusSnapshot.flow,
+    drsStatusSnapshot.ratio, drsStatusSnapshot.dose, drsStatusSnapshot.timer,
+    drsStatusSnapshot.timerRunning
+  };
+  portEXIT_CRITICAL(&drsStatusMux);
+  return snapshot;
+}
+
+inline void hdsDrsResetFlow() {
+  f_flow_rate = 0.0f;
+  f_flow_rate_last_weight = drsExtractionWeight;
+  t_flow_rate = millis();
+}
+
+inline void hdsDrsTimerStop() {
+  stopWatch.stop();
+  b_ready_to_brew = false;
+  hdsDrsResetPourDetection();
+  recordEnergyActivity();
+}
+
+inline void hdsDrsTimerReset() {
+  hdsDrsTimerStop();
+  stopWatch.reset();
+  hdsDrsResetExtractionStamps();
+  hdsDrsResetFlow();
+}
+
+inline void hdsDrsTimerStart() {
+  hdsDrsTimerReset();
+  if (drsBrewMode) t_extraction_begin = t_scale_stable;
+  stopWatch.start();
+}
+
+inline void hdsDrsPrepareManualTare() {
+  if (!b_extraction) return;
+  drsEspressoPrimeTarePending = false;
+  if (stopWatch.isRunning()) hdsDrsTimerStop();
+  else hdsDrsTimerReset();
+}
+
+inline void hdsDrsApplyEspressoPrimeTare() {
+  if (!drsEspressoPrimeTarePending) return;
+  drsEspressoPrimeTarePending = false;
+  tareScaleWhenAdcReady("DRS espresso setup tare");
+}
+
+inline void hdsDrsEnterExtraction() {
+  if (!hdsDrsIsActive() || b_extraction || drsContainerCapture || b_menu ||
+      b_calibration || b_ota || b_softSleep || chargingUiActive() || b_bootTare ||
+      b_adc_recovery_active || !isfinite(f_displayedValue) || f_displayedValue > OVER_WEIGHT) return;
+  b_extraction = true;
+  const float dose = hdsDrsPureWeight(f_displayedValue);
+  drsUseDefaultDose = dose < HDS_DRS_MIN_MEASURED_DOSE_G;
+  f_weight_dose = drsUseDefaultDose ? hdsDrsDefaultDose() : dose;
+  drsEspressoPrimeTarePending = drsBrewMode != 0;
+  drsExtractionWeight = drsEspressoPrimeTarePending ? 0.0f : f_displayedValue;
+  hdsDrsTimerReset();
+  hdsDrsRefreshSnapshots();
+}
+
+inline void hdsDrsExitExtraction() {
+  if (!b_extraction) return;
+  b_extraction = false;
+  drsExtractionWeight = 0.0f;
+  drsUseDefaultDose = true;
+  drsEspressoPrimeTarePending = false;
+  f_weight_dose = hdsDrsDefaultDose();
+  hdsDrsTimerReset();
+  hdsDrsRefreshSnapshots();
+}
+
+inline void hdsDrsToggleExtraction() {
+  if (b_extraction) {
+    hdsDrsExitExtraction();
+  } else {
+    hdsDrsEnterExtraction();
+  }
+}
+
+inline void hdsDrsCancelContainerCapture() {
+  drsContainerCapture = false;
+  drsContainerCaptureStableSince = 0;
+  drsContainerCaptureLast = 0.0f;
+}
+
+inline void hdsDrsStartContainerCapture() {
+  if (!hdsDrsIsActive()) return;
+  if (b_extraction) hdsDrsExitExtraction();
+  drsContainerCapture = true;
+  drsContainerCaptureAt = millis();
+  drsContainerCaptureStableSince = 0;
+  drsContainerCaptureLast = 0.0f;
+  drsContainerCapturedAt = 0;
+  drsContainerSaveFailedAt = 0;
+}
+
+inline void hdsDrsServiceContainerCapture(bool freshSample) {
+  if (!drsContainerCapture) return;
+  const unsigned long now = millis();
+  if (now - drsContainerCaptureAt > 60000) {
+    hdsDrsCancelContainerCapture();
+    return;
+  }
+  if (!freshSample || b_tareByButton || b_weight_quick_zero || b_bootTare || b_adc_recovery_active) return;
+  const float weight = f_displayedValue;
+  if (fabsf(weight - drsContainerCaptureLast) <= 0.2f) {
+    if (drsContainerCaptureStableSince == 0) {
+      drsContainerCaptureStableSince = now;
+      return;
+    }
+    if (now - drsContainerCaptureStableSince < 1000) return;
+    if (weight < -0.5f) {
+      tareScaleWhenAdcReady("DRS container zero");
+      drsContainerCaptureStableSince = 0;
+      drsContainerCaptureLast = 0.0f;
+      return;
+    }
+    if (hdsDrsContainerValid(weight)) {
+      hdsDrsCancelContainerCapture();
+      if (hdsDrsStoreContainer(weight)) {
+        drsContainerWeight = weight;
+        drsContainerCapturedAt = now;
+      } else {
+        drsContainerSaveFailedAt = now;
+      }
+      return;
+    }
+    drsContainerCaptureStableSince = 0;
+  } else {
+    drsContainerCaptureLast = weight;
+    drsContainerCaptureStableSince = 0;
+  }
+}
+
+inline bool hdsDrsSetMode(int mode, bool persist = true) {
+  if (!hdsDrsIsActive()) return false;
+  mode = mode ? 1 : 0;
+  if (persist && !hdsDrsStoreMode(mode)) return false;
+  if (drsBrewMode == mode) return true;
+  drsBrewMode = mode;
+  if (!b_extraction || drsUseDefaultDose) f_weight_dose = hdsDrsDefaultDose();
+  if (b_extraction) {
+    drsEspressoPrimeTarePending = drsBrewMode != 0;
+    if (drsEspressoPrimeTarePending) drsExtractionWeight = 0.0f;
+    hdsDrsTimerReset();
+  }
+  hdsDrsRefreshSnapshots();
+  return true;
+}
+
+inline bool hdsDrsToggleMode() {
+  return hdsDrsSetMode(drsBrewMode ? 0 : 1);
+}
+
+inline void hdsDrsOnTareComplete(bool espressoCupTared) {
+  if (!b_extraction) return;
+  drsExtractionWeight = 0.0f;
+  aWeight = 0.0f;
+  if (espressoCupTared) {
+    hdsDrsTimerStart();
+  } else if (!stopWatch.isRunning()) {
+    hdsDrsResetPourDetection();
+    hdsDrsResetFlow();
+    b_ready_to_brew = true;
+    t_ready_to_brew = millis();
+    t_scale_stable = t_ready_to_brew;
+  } else {
+    hdsDrsResetFlow();
+  }
+}
+
+inline void hdsDrsUpdateFlow(unsigned long now) {
+  const unsigned long elapsed = now - t_flow_rate;
+  if (elapsed < HDS_DRS_FLOW_INTERVAL_MS) return;
+  const float gained = drsExtractionWeight - f_flow_rate_last_weight;
+  f_flow_rate = gained > 0.0f ? gained * (1000.0f / elapsed) : 0.0f;
+  f_flow_rate_last_weight = drsExtractionWeight;
+  t_flow_rate = now;
+}
+
+inline void hdsDrsUpdatePour(unsigned long now) {
+  if (!stopWatch.isRunning()) {
+    if (b_ready_to_brew && drsExtractionWeight > HDS_DRS_POUR_START_MIN_G &&
+        now - t_ready_to_brew >= HDS_DRS_POUR_START_DELAY_MS) {
+      hdsDrsTimerStart();
+    } else {
+      return;
+    }
+  }
+  if (drsPourStable && drsPourStableWeight - drsExtractionWeight >= HDS_DRS_POUR_CUP_REMOVED_G) {
+    hdsDrsTimerStop();
+    return;
+  }
+  if (drsPourStableSince == 0 ||
+      fabsf(drsExtractionWeight - drsPourLastWeight) > HDS_DRS_POUR_STABLE_G) {
+    drsPourLastWeight = drsExtractionWeight;
+    drsPourStableSince = now;
+  } else if (now - drsPourStableSince >= HDS_DRS_POUR_STABLE_MS) {
+    drsPourStable = true;
+    drsPourStableWeight = drsPourLastWeight;
+  }
+}
+
+inline void hdsDrsTrackEspressoFlow(unsigned long now) {
+  const float change = drsExtractionWeight - aWeight;
+  if (!t_extraction_first_drop) {
+    if (change >= HDS_DRS_ESPRESSO_STABLE_G) {
+      t_extraction_first_drop = now;
+      aWeight = drsExtractionWeight;
+    }
+    return;
+  }
+  if (fabsf(change) >= HDS_DRS_ESPRESSO_FLOW_STABLE_G) {
+    aWeight = drsExtractionWeight;
+    t_extraction_last_drop = 0;
+  } else if (t_extraction_last_drop == 0) {
+    t_extraction_last_drop = now;
+  } else if (now - t_extraction_last_drop >= HDS_DRS_ESPRESSO_SETTLED_MS &&
+             now - t_extraction_first_drop >= (unsigned long)i_extraction_minimium_timer * 1000UL) {
+    hdsDrsTimerStop();
+  }
+}
+
+inline bool hdsDrsUpdateEspresso(unsigned long now) {
+  if (now - t_scale_stable < (unsigned long)scaleStableInterval) return false;
+  t_scale_stable = now;
+  if (stopWatch.isRunning()) {
+    hdsDrsTrackEspressoFlow(now);
+    return false;
+  }
+  if (!b_ready_to_brew) return false;
+  const bool stable = fabsf(drsExtractionWeight - aWeight) < HDS_DRS_ESPRESSO_STABLE_G;
+  aWeight = drsExtractionWeight;
+  if (!stable) return false;
+  if (drsExtractionWeight > HDS_DRS_ESPRESSO_CUP_MIN_G && drsExtractionWeight <= OVER_WEIGHT) {
+    return tareScaleWhenAdcReady("DRS espresso cup tare");
+  }
+  if (drsExtractionWeight < HDS_DRS_ESPRESSO_NEGATIVE_TARE_G) {
+    tareScaleWhenAdcReady("DRS espresso negative tare");
+  }
+  return false;
+}
+
+inline bool hdsDrsSample(float driftCorrectedWeight) {
+  if (drsEspressoPrimeTarePending || b_weight_quick_zero || b_bootTare) {
+    drsExtractionWeight = 0.0f;
+    return false;
+  }
+  if (!isfinite(driftCorrectedWeight)) return false;
+  drsExtractionWeight = fabsf(driftCorrectedWeight) < 0.1f ? 0.0f : driftCorrectedWeight;
+  const unsigned long now = millis();
+  const bool espressoCupTareRequested = drsBrewMode && hdsDrsUpdateEspresso(now);
+  if (!drsBrewMode) hdsDrsUpdatePour(now);
+  hdsDrsUpdateFlow(now);
+  return espressoCupTareRequested;
+}
+
+#endif
+
+#endif
diff --git a/include/hds_drs_storage.h b/include/hds_drs_storage.h
new file mode 100644
index 0000000000000000000000000000000000000000..f38e3df8d1c7f7fb5712e3327c773b8218255809
--- /dev/null
+++ b/include/hds_drs_storage.h
@@ -0,0 +1,68 @@
+#ifndef HDS_DRS_STORAGE_H
+#define HDS_DRS_STORAGE_H
+
+#include "config.h"
+
+#if HDS_ENABLE_HDS_DRS
+#include <Preferences.h>
+#include "parameter.h"
+
+constexpr const char *drsStorageNamespace = "hds-drs";
+constexpr const char *drsPourDoseKey = "pour_dose";
+constexpr const char *drsEspressoDoseKey = "esp_dose";
+constexpr const char *drsContainerKey = "container";
+constexpr const char *drsContainerEnabledKey = "container_on";
+constexpr const char *drsModeKey = "mode";
+
+inline bool hdsDrsDoseValid(float dose) {
+  return dose >= 1.0f && dose <= 100.0f;
+}
+
+inline bool hdsDrsContainerValid(float weight) {
+  return weight >= 1.0f && weight <= OVER_WEIGHT;
+}
+
+inline void hdsDrsLoadSettings() {
+  Preferences preferences;
+  if (!preferences.begin(drsStorageNamespace, true)) return;
+  const auto mode = preferences.getUChar(drsModeKey, 0);
+  const float pour = preferences.getFloat(drsPourDoseKey, drsPourDose);
+  const float espresso = preferences.getFloat(drsEspressoDoseKey, drsEspressoDose);
+  const float container = preferences.getFloat(drsContainerKey, 0.0f);
+  drsBrewMode = mode == 1 ? 1 : 0;
+  if (hdsDrsDoseValid(pour)) drsPourDose = pour;
+  if (hdsDrsDoseValid(espresso)) drsEspressoDose = espresso;
+  if (hdsDrsContainerValid(container)) {
+    drsContainerWeight = container;
+    drsContainerEnabled = preferences.getBool(drsContainerEnabledKey, false);
+  }
+}
+
+inline bool hdsDrsStoreMode(int mode) {
+  Preferences preferences;
+  return preferences.begin(drsStorageNamespace, false) &&
+    preferences.putUChar(drsModeKey, mode == 1 ? 1 : 0) == sizeof(uint8_t);
+}
+
+inline bool hdsDrsStoreDose(int mode, float dose) {
+  if (!hdsDrsDoseValid(dose)) return false;
+  Preferences preferences;
+  return preferences.begin(drsStorageNamespace, false) &&
+    preferences.putFloat(mode ? drsEspressoDoseKey : drsPourDoseKey, dose) == sizeof(float);
+}
+
+inline bool hdsDrsStoreContainer(float weight) {
+  if (!hdsDrsContainerValid(weight)) return false;
+  Preferences preferences;
+  return preferences.begin(drsStorageNamespace, false) &&
+    preferences.putFloat(drsContainerKey, weight) == sizeof(float);
+}
+
+inline bool hdsDrsStoreContainerEnabled(bool enabled) {
+  Preferences preferences;
+  return preferences.begin(drsStorageNamespace, false) &&
+    preferences.putBool(drsContainerEnabledKey, enabled) == sizeof(bool);
+}
+
+#endif
+#endif
