@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+import json
+import re
+from pathlib import Path
+
+from test_usb_text_actions_contract import block_after
+
+ROOT = Path(__file__).resolve().parents[1]
+PLUGIN = ROOT / "plugins" / "hds-drs"
+
+
+def require(condition, message):
+    assert condition, message
+
+
+def gated_lines(lines):
+    stack = []
+    for number, line in enumerate(lines.splitlines(), 1):
+        stripped = line.strip()
+        if stripped.startswith("#if"):
+            stack.append(stripped == "#if HDS_ENABLE_HDS_DRS")
+        elif stripped.startswith("#elif"):
+            stack[-1] = stripped == "#elif HDS_ENABLE_HDS_DRS"
+        elif stripped.startswith("#else"):
+            stack[-1] = False
+        elif stripped.startswith("#endif"):
+            stack.pop()
+        else:
+            yield number, line, any(stack)
+
+
+def check_gate():
+    config = (ROOT / "include" / "config.h").read_text(encoding="utf-8")
+    require(
+        "#ifndef HDS_ENABLE_HDS_DRS\n"
+        "#if HDS_CUSTOM_BUILD\n"
+        "#define HDS_ENABLE_HDS_DRS 1\n"
+        "#else\n"
+        "#define HDS_ENABLE_HDS_DRS 0\n"
+        "#endif\n"
+        "#endif" in config,
+        "config.h is missing the HDS_ENABLE_HDS_DRS gate",
+    )
+
+    targets = {
+        "include/hds_drs.h": ("hdsDrs", "drsStatus", "DrsStatusSnapshot"),
+        "include/hds_drs_storage.h": ("hdsDrs", "drsStorageNamespace", "drsModeKey"),
+        "include/parameter.h": ("DrsStatusSnapshot", "drsStatus", "drsWebTarePending",
+                                "drsBrewMode", "drsPour", "drsEspresso", "drsUseDefaultDose",
+                                "drsExtraction", "drsContainer", "WSP_DRS_"),
+        "include/finger_detection.h": ("hdsDrs", '"hds_drs.h"'),
+        "include/tap_detection.h": ("hdsDrs",),
+        "include/menu.h": ("menuDrs", "drsMenu", "hdsDrs", "drsWebTarePending"),
+        "include/usbcomm.h": ("hdsDrs", '"hds_drs.h"'),
+        "include/websocket.h": ("hdsDrs", "WSP_DRS_", "DrsStatusSnapshot", "drsWebTarePending"),
+        "src/hds.ino": ("hdsDrs", "drawDrs", "drsWebTarePending", "drsContainer", "drsExtraction"),
+    }
+    legacy_keys = re.compile(r"\bKEY_(MODE|POUROVER|ESPRESSO)\b")
+    for relative, markers in targets.items():
+        source = (ROOT / relative).read_text(encoding="utf-8")
+        for number, line, gated in gated_lines(source):
+            require(gated or not any(marker in line for marker in markers),
+                    f"ungated DRS integration at {relative}:{number}")
+            require(not (gated and legacy_keys.search(line)),
+                    f"DRS uses a legacy storage key at {relative}:{number}")
+
+
+def check_storage_and_owner():
+    include = ROOT / "include"
+    base = (include / "storage.h").read_text(encoding="utf-8")
+    storage = (include / "hds_drs_storage.h").read_text(encoding="utf-8")
+    drs = (include / "hds_drs.h").read_text(encoding="utf-8")
+    menu = (include / "menu.h").read_text(encoding="utf-8")
+    require(not re.search(r"hds[-_]?drs|key_drs_|\bdrs", base, re.IGNORECASE),
+            "DRS must not extend the base settings schema")
+    require('drsStorageNamespace = "hds-drs";' in storage and
+            set(re.findall(r"\.begin\(\s*([^,\s)]+)", storage)) == {"drsStorageNamespace"},
+            "DRS settings must use its dedicated hds-drs NVS namespace")
+    require("settingsPreferences" not in drs + storage, "DRS must not access base NVS directly")
+    require("return activeIntegration == IntegrationMode::Drs;" in block_after(drs, "hdsDrsIsActive()"),
+            "DRS must use the selected runtime integration owner")
+    require("toggleIntegration(IntegrationMode::Drs);" in block_after(menu, "void toggleDrsEnabled() {"),
+            "the DRS menu must use the shared persisted integration selector")
+
+
+def check_websocket_snapshot():
+    include = ROOT / "include"
+    drs = (include / "hds_drs.h").read_text(encoding="utf-8")
+    websocket = (include / "websocket.h").read_text(encoding="utf-8")
+    for signature in ("hdsDrsRefreshSnapshots()", "hdsDrsReadSnapshot()"):
+        body = block_after(drs, signature)
+        before, entry, rest = body.partition("portENTER_CRITICAL(&drsStatusMux);")
+        locked, exit_lock, after = rest.partition("portEXIT_CRITICAL(&drsStatusMux);")
+        require(entry and exit_lock and "drsStatusSnapshot." in locked and
+                "drsStatusSnapshot." not in before + after,
+                f"{signature} must access the DRS snapshot inside its critical section")
+    for signature in ("void sendWebsocketStatus(", "void sendWebsocketWeightAll("):
+        require("hdsDrsReadSnapshot()" in block_after(websocket, signature),
+                f"{signature} must use the synchronized DRS snapshot")
+    commands = block_after(websocket, 'if (websocketEqualsIgnoreCase(command, "drs"))')
+    require("WSP_DRS_TARE" in commands and "requestRemoteTare" not in commands and
+            not re.search(r"\bWSP_TIMER_", commands),
+            "DRS dashboard commands must not enqueue stock tare or timer actions")
+
+
+def check_environment():
+    ini = (ROOT / "platformio.ini").read_text(encoding="utf-8")
+    require(
+        "[env:esp32s3-hds-drs]\nextends = env:esp32s3\nbuild_flags =\n"
+        "  ${env:esp32s3.build_flags}\n  -DHDS_ENABLE_HDS_DRS=1" in ini,
+        "platformio.ini is missing the esp32s3-hds-drs environment",
+    )
+
+
+def check_menu_contract():
+    contract = (ROOT / "tools" / "test_menu_memory_contract.py").read_text(encoding="utf-8")
+    require('"menuDrs": "menuDrsBack"' in contract,
+            "menu memory contract is missing the menuDrs link")
+
+
+def check_manifest():
+    if not (PLUGIN / "plugin.json").exists():
+        return
+    manifest = json.loads((PLUGIN / "plugin.json").read_text(encoding="utf-8"))
+    require(re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", manifest["id"]) is not None,
+            "plugin id must be lowercase kebab-case")
+    require(manifest["id"] == "hds-drs", "plugin id must stay hds-drs")
+    require(set(manifest["firmware_refs"]) == {"main", "v3.1.17"},
+            "firmware_refs must list main and v3.1.17")
+    require(set(manifest["patches"]) == set(manifest["firmware_refs"]),
+            "each firmware ref needs a patch mapping")
+    for reference, relative in manifest["patches"].items():
+        require((PLUGIN / relative).is_file(), f"missing patch for {reference}")
+    for key, value in manifest["budget"].items():
+        require(type(value) is int and value >= 0, f"invalid budget value {key}")
+    require({"webserver", "websocket", "littlefs"} <= set(manifest["requires"]),
+            "web app dependencies are incomplete")
+    require(not (PLUGIN / "webapp").exists(), "use assets/ instead of webapp/")
+    index = PLUGIN / "assets" / "index.html"
+    require(index.is_file(), "assets/index.html is required for the web app")
+    html = index.read_text(encoding="utf-8")
+    require('href="./style.css"' in html and 'src="./app.js"' in html,
+            "web app resources must use relative paths")
+    require("http://" not in html and "https://" not in html,
+            "web app must not reference remote resources")
+
+
