+    source += "void toggleIntegration(IntegrationMode mode) {" + block_after(
+        menu, "void toggleIntegration(IntegrationMode mode)") + "}\n"
+    source += r'''
+using Mode = IntegrationMode;
+
+void assertOwner(Mode expected) {
