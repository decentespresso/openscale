diff --git a/include/app_prompt.h b/include/app_prompt.h
new file mode 100644
index 0000000..840a10c
--- /dev/null
+++ b/include/app_prompt.h
@@ -0,0 +1,97 @@
+#ifndef APP_PROMPT_H
+#define APP_PROMPT_H
+
+#include "app_prompt_state.h"
+
+inline AppPromptState readAppPromptLocked() {
+  AppPromptState state;
+  state.connectionHandle = appPromptState.connectionHandle;
+  state.cancelled = appPromptState.cancelled;
+  state.active = appPromptState.active;
+  state.heartbeatAt = appPromptState.heartbeatAt;
+  for (size_t index = 0; index < sizeof(state.text); ++index) state.text[index] = appPromptState.text[index];
+  return state;
+}
+
+inline void storeAppPromptLocked(const AppPromptState &state) {
+  appPromptState.connectionHandle = state.connectionHandle;
+  appPromptState.cancelled = state.cancelled;
+  appPromptState.active = state.active;
+  appPromptState.heartbeatAt = state.heartbeatAt;
+  for (size_t index = 0; index < sizeof(state.text); ++index) appPromptState.text[index] = state.text[index];
+}
+
+inline void setAppPromptConnection(uint16_t handle) {
+  portENTER_CRITICAL(&appPromptMux);
+  const unsigned long now = millis();
+  storeAppPromptLocked(appPromptConnection(handle, now));
+  portEXIT_CRITICAL(&appPromptMux);
+}
+
+inline void syncAppPromptConnection(uint16_t handle) {
+  portENTER_CRITICAL(&appPromptMux);
+  const unsigned long now = millis();
+  if (appPromptState.connectionHandle != handle) storeAppPromptLocked(appPromptConnection(handle, now));
+  portEXIT_CRITICAL(&appPromptMux);
+}
+
+inline void recordAppPromptHeartbeat(const uint8_t *bytes, size_t length) {
+  if (!appPromptIsHeartbeat(bytes, length)) return;
+  portENTER_CRITICAL(&appPromptMux);
+  const unsigned long now = millis();
+  storeAppPromptLocked(appPromptHeartbeat(readAppPromptLocked(), now));
+  portEXIT_CRITICAL(&appPromptMux);
+}
+
+inline void processAppPromptSession() {
+  portENTER_CRITICAL(&appPromptMux);
+  const unsigned long now = millis();
+  const AppPromptState state = readAppPromptLocked();
+  storeAppPromptLocked(b_ota || !b_ble_enabled
+    ? appPromptConnection(APP_PROMPT_NO_CONNECTION, now)
+    : appPromptExpire(state, now));
+  portEXIT_CRITICAL(&appPromptMux);
+}
+
+inline AppPromptState snapshotAppPrompt() {
+  portENTER_CRITICAL(&appPromptMux);
+  const AppPromptState state = readAppPromptLocked();
+  portEXIT_CRITICAL(&appPromptMux);
+  return state;
+}
+
+inline bool cancelAppPrompt() {
+  portENTER_CRITICAL(&appPromptMux);
+  const unsigned long now = millis();
+  const AppPromptState state = appPromptExpire(readAppPromptLocked(), now);
+  const bool cancelled = state.active;
+  if (cancelled) storeAppPromptLocked(appPromptCancel(state));
+  portEXIT_CRITICAL(&appPromptMux);
+  return cancelled;
+}
+
+class AppPromptCallbacks : public BLECharacteristicCallbacks {
+  void onRead(BLECharacteristic *characteristic) override {
+    uint8_t capabilities[] = {1, APP_PROMPT_MAX_BYTES, APP_PROMPT_TIMEOUT_MS / 1000};
+    characteristic->setValue(capabilities, sizeof(capabilities));
+  }
+
+  void onWrite(BLECharacteristic *characteristic) override {
+    const size_t length = characteristic->getLength();
+    if (length > APP_PROMPT_MAX_BYTES + 1) return;
+    const uint8_t *bytes = characteristic->getData();
+    portENTER_CRITICAL(&appPromptMux);
+    const unsigned long now = millis();
+    storeAppPromptLocked(appPromptCommand(readAppPromptLocked(), bytes, length, now));
+    portEXIT_CRITICAL(&appPromptMux);
+  }
+};
+
+inline void setupAppPromptCharacteristic(BLEService *service) {
+  BLECharacteristic *characteristic = service->createCharacteristic(
+    "8b8dc7c0-6bf7-4bdf-9a2c-0ba9cb9a4a01",
+    BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_WRITE);
+  characteristic->setCallbacks(new AppPromptCallbacks());
+}
+
+#endif
diff --git a/include/app_prompt_state.h b/include/app_prompt_state.h
new file mode 100644
index 0000000..dcec4dc
--- /dev/null
+++ b/include/app_prompt_state.h
@@ -0,0 +1,75 @@
+#ifndef APP_PROMPT_STATE_H
+#define APP_PROMPT_STATE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+static constexpr size_t APP_PROMPT_MAX_BYTES = 18;
+static constexpr uint16_t APP_PROMPT_NO_CONNECTION = UINT16_MAX;
+static constexpr unsigned long APP_PROMPT_TIMEOUT_MS = 10000;
+
+struct AppPromptState {
+  uint16_t connectionHandle = APP_PROMPT_NO_CONNECTION;
+  bool cancelled = false;
+  bool active = false;
+  unsigned long heartbeatAt = 0;
+  char text[APP_PROMPT_MAX_BYTES + 1] = {};
+};
+
+inline AppPromptState appPromptConnection(uint16_t handle, unsigned long now) {
+  AppPromptState state;
+  state.connectionHandle = handle;
+  state.heartbeatAt = now;
+  return state;
+}
+
+inline AppPromptState appPromptExpire(const AppPromptState &state, unsigned long now) {
+  AppPromptState next = state;
+  if (state.connectionHandle == APP_PROMPT_NO_CONNECTION || now - state.heartbeatAt >= APP_PROMPT_TIMEOUT_MS) {
+    next.active = false;
+    memset(next.text, 0, sizeof(next.text));
+  }
+  return next;
+}
+
+inline AppPromptState appPromptHeartbeat(const AppPromptState &state, unsigned long now) {
+  AppPromptState next = appPromptExpire(state, now);
+  if (state.connectionHandle != APP_PROMPT_NO_CONNECTION) next.heartbeatAt = now;
+  return next;
+}
+
+inline AppPromptState appPromptCancel(const AppPromptState &state) {
+  AppPromptState next = state;
+  next.cancelled = true;
+  next.active = false;
+  memset(next.text, 0, sizeof(next.text));
+  return next;
+}
+
+inline AppPromptState appPromptCommand(const AppPromptState &state, const uint8_t *bytes,
+                                      size_t length, unsigned long now) {
+  AppPromptState next = appPromptExpire(state, now);
+  if (bytes == nullptr || length == 0 || state.connectionHandle == APP_PROMPT_NO_CONNECTION || state.cancelled) return next;
+  if (length == 1 && bytes[0] == 0) {
+    next.active = false;
+    memset(next.text, 0, sizeof(next.text));
+    return next;
+  }
+  if (bytes[0] != 1 || length < 2 || length > APP_PROMPT_MAX_BYTES + 1 ||
+      now - state.heartbeatAt >= APP_PROMPT_TIMEOUT_MS) return next;
+  for (size_t index = 1; index < length; ++index) {
+    if (bytes[index] < 0x20 || bytes[index] > 0x7e) return next;
+  }
+  memset(next.text, 0, sizeof(next.text));
+  memcpy(next.text, bytes + 1, length - 1);
+  next.active = true;
+  return next;
+}
+
+inline bool appPromptIsHeartbeat(const uint8_t *bytes, size_t length) {
+  const uint8_t heartbeat[] = {0x03, 0x0a, 0x03, 0xff, 0xff, 0x00, 0x0a};
+  return bytes != nullptr && length == sizeof(heartbeat) && memcmp(bytes, heartbeat, sizeof(heartbeat)) == 0;
+}
+
+#endif
