        //toreturn = "<div class='print-only'>" + dt("NOT AVAILABLE") + "</div><div id=\"buy_" + sku + "\" style='display:inline'><a onclick=\"javascript:void('')\" class=\"button special no-print icon fa-times-circle\">" + dt("NOT AVAILABLE") + "</a></li></div>"
