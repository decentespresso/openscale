            // check that their selected shipper exists.
            // this can happen if the shipper list changed since they last visited us
            var found_shipper = 0;
            for (var shipper in rates_for_this_sku) {
                //decent_log(" - " + shipper + "==" + selected_shipper);
                if (shipper == selected_shipper || selected_shipper == "own" || selected_shipper == "ss" || selected_shipper == "pickup") {
                    found_shipper = 1;
                    //decent_log("Found shipper: "+ shipper);
                    break;
                }
            }            
            if (found_shipper == 0) {
                //decent_log("Unable to find shipper " + selected_shipper + " so defaulting to cheapest: " + cheapest_shipper);
                selected_shipper = cheapest_shipper;
