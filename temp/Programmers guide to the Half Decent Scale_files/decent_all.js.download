            var photo = skudata.url_photo.replace(/\.jpg/, "_1760x1136.avif");
            imagesrc = "/img/small/" + skudata.url_photo + "_1760x1136.avif";
        } else if (skudata.url_photo_white != undefined) {
            //var photo = skudata.url_photo_white.replace(/\.jpg/, "-grey_880x568.jpg");
            var photo = skudata.url_photo_white.replace(/\.jpg/, "_1760x1136.jpg");
            imagesrc = "/img/small/" + photo;
        }


        if (skudata.url_shop != undefined) {
            href = "/" + skudata.url_shop
        }

        href = "/photos/" + alt;        

        html = product_img_html_markdown(href, altx, imagesrc);

        if (divname.includes("_white") != true) {
            // Multi-photo SKUs get a < / > carousel; single-photo cards unchanged.
            var carousel = product_carousel_html(alt, altx, dimgloc + imagesrc, skudata.morephotos);
            if (carousel != "") {
                html = carousel;
            }
        }

    } else {
        html = product_img_html_markdown(href, alt, imagesrc);
    }

    document.getElementById(divname).innerHTML = html;

}

function update_img_cache_html() {
//disabled, not used any more
return;
    if (images_to_cache.length == 0) {
        return
    }
    //decent_log("update_img_cache_html: " + images_to_cache);
    var img;
    var newhtml = "";

    images_to_cache = sort_array_unique(images_to_cache);
    
    for ( var i = 0, l = images_to_cache.length; i < l; ++i ) {
        img = images_to_cache[i];
        if (img == undefined || img == "")  { continue; };
        newhtml += "<img src='" + dimgloc + img + "' xwidth=5% xheight=1 xwidth=1>";
        //decent_log("Loading image :'" + img + "'");
    }
    var id = document.getElementById('imagecache');
    if (id == undefined) {
        decent_log("Warning, no imagecache on this page");
    } else {
        id.innerHTML = newhtml;
    }
    preload_has_run = 1;
}

function hping(url, async) {
    if (xmlHttp) {
        try {
            xmlHttp.open("GET", url, async);
        } catch (e) {}
        try {
            xmlHttp.send(null);
        } catch (e) {}
    }
}

function createXMLHttpRequest() {
    xmlHttp = null;
    if (typeof XMLHttpRequest != "undefined") {
        xmlHttp = new XMLHttpRequest();
    } else if (typeof window.ActiveXObject != "undefined") {
        try {
            xmlHttp = new ActiveXObject("Msxml2.XMLHTTP.4.0");
        } catch (e) {
            try {
                xmlHttp = new ActiveXObject("MSXML2.XMLHTTP");
            } catch (e) {
                try {
                    xmlHttp = new ActiveXObject("Microsoft.XMLHTTP");
                } catch (e) {
                    xmlHttp = null;
                }
            }
        }
    }
    return xmlHttp;
}

var object_to_shake, shake = 10,
    shake_interval, final_shake;

function start_shake() {
    shake = shake - 1;
    object_to_shake.style.padding = "0px " + shake + "px";
    if (shake <= 5) {
        object_to_shake.style.padding = final_shake;
        clearInterval(shake_interval)
    }
}

function shake_object(objectid) {
    object_to_shake = objectid;
    final_shake = object_to_shake.style.padding;
    shake = 20;
    clearInterval(shake_interval);
    shake_interval = setInterval("start_shake()", 5);

}

function validateEmail(email) {
    var re = /\S+@\S+\.\S+/;
    return re.test(email);
}


function decent_news_join(listname) {

    var email = document.getElementById('email').value;
    if (email == "") {
        shake_object(document.getElementById('email'));
        return
    }
    if (validateEmail(email) != true) {
        shake_object(document.getElementById('email'));
        return
    }


    var xmlHttp = createXMLHttpRequest();
    var url = "/subscribe?email=" + escape(email) + "&listname=" + escape(listname);
    hping(url, true);

    var newhtml = "Thank you! You'll be receiving occasional email news to \"" + email + "\"";

    if (listname == "decent-espresso-noticias") {
        newhtml = "Gracias"
    }
    if (listname == "decent-espresso-aktualitaeten") {
        newhtml = "Vielen Dank - wir werden Dich ab jetzt &uuml;ber tolle Neuheiten aus der Welt des Espressos und &uuml;ber unsere Maschine informiert halten!"
    }
    if (listname == "decent-espresso-nouveautes") {
        newhtml = "Merci!"
    }
    if (listname == "decent-espresso-notizie") {
        newhtml = "Grazie, ora sei iscritto alla nostra newsletter."
    }
    if (listname == "decent-espresso-news-chinese-simplified") {
        newhtml = "&#38750;&#24120;&#24863;&#35874;&#65292;&#24744;&#24050;&#32463;&#35746;&#38405;&#25105;&#20204;&#30340;&#37038;&#20214;&#12290;"
    }
    if (listname == "decent-espresso-news-chinese-traditional") {
        newhtml = "&#38750;&#24120;&#24863;&#35613;&#65292;&#24744;&#24050;&#32147;&#35330;&#38321;&#20102;&#25105;&#20497;&#30340;&#37109;&#20214;&#12290;"
    }



    document.getElementById('newsletter').innerHTML = newhtml;

}

