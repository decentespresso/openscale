function uncommentdiv(divname) {
    var sect = document.getElementById(divname);

    var commented = sect.innerHTML;
    var firstbit = commented.substr(0,4);
    /* hack below is for ie6 which otherwise thinks there is a comment in the javascript */
    if (firstbit == '<' + '!' + '--') {
        var uncommented = commented.substr(4, commented.length - 7);
        sect.innerHTML = uncommented;
    }
    sect.style.display = 'block';
}

function unhide(item, index) {
    //decent_log("unhide " + item);    
    if (document.getElementById(item) == null) {
        decent_log("Unable to find element named: '" + item + "'");
        debugger;
    }
    
    document.getElementById(item).style.display = "block";
}

function hide(item, index) {

    if (document.getElementById(item) == undefined) {
        decent_log("Undefined item to hide: '" + item + "'");
        debugger;
        return;
    }

    document.getElementById(item).style.display = "none";
}

function numberWithCommas(x) {
    if (mylang == "ar") {
        // no commas are added to Arabic numbers
        return x
    }

    x = x.toString();
    var pattern = /(-?\d+)(\d{3})/;
    while (pattern.test(x))
        x = x.replace(pattern, "$1,$2");
    return x;
}

function removeDuplicates(originalArray, prop) {
     var newArray = [];
     var lookupObject  = {};

     for(var i in originalArray) {
        lookupObject[originalArray[i][prop]] = originalArray[i];
     }

     for(i in lookupObject) {
         newArray.push(lookupObject[i]);
     }
      return newArray;
 }


// for sorting function
// sorts DE1 at the top
// and puts replacement parts after the DE1
// and puts accessories at the end
function sku_compare(a,b) {

    var skudata1 = decent_products[a.sku];
    var skudata2 = decent_products[b.sku];


    if (skudata1 == undefined || skudata2 == undefined) {
        var sort1 = a.sku;
        var sort2 = b.sku;

    } else {

        var sort1 = dt(skudata1["one_liner"]);
        var sort2 = dt(skudata2["one_liner"]);


        //var sort1 = a.one_liner;
        //var sort2 = b.one_liner;

        var found1 = false;
        var found2 = false;

        if (sku_is_espresso_machine(a.sku) == 1) {
            sort1 = "0" + sort1;
            found1 = true
        } 

        if (sku_is_espresso_machine(b.sku) == 1) {
            sort2 = "0" + sort2;
            found2 = true
        }

        if (found1 == false) {
            if (a.replaces != undefined) {
                sort1 = "1" + sort1;
                found1 = true
            } else {
                sort1 = "2" + sort1;
                found1 = true
            }
        }
        

        if (found2 == false) {
            if (b.replaces != undefined) {
                sort2 = "1" + sort2;
                found2 = true
            } else {
                sort2 = "2" + sort2;
                found2 = true
            }
        }
    }


    if (sort1 < sort2) {
        return -1;
    }

    if (sort1 > sort2) {
        return 1;
    }

    return 0;
}

var images_to_cache = [];
function preload_this_image (img) {
    if (preload_has_run == 1) {
        return
    }

    if (img == "") {
        return
    }
    images_to_cache.push(img);
    //decent_log("preloading this image: '" + img + "'");
}


