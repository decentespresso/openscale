function all_skus () {
    return all_keys(decent_products);
}

function convert_skunum_to_sku(skunum) {
    if (skunum == "") {
        return ""
    }


    var string_to_find = zeropad(skunum, 5);
    var allskus = all_skus();
    for (var i = 0, length = allskus.length; i < length; i++) {    
        var this_sku = allskus[i];
        if (this_sku.indexOf(string_to_find) != -1) {
            return this_sku
        }
    }
    // not found
    return ""
}

var shopping_cart_display_all_products_yes = 0;
function shopping_cart_display_all_products() {
    shopping_cart_display_all_products_yes = 1;
    shopping_cart_table_update();
}
function shopping_cart_display_some_products() {
    shopping_cart_display_all_products_yes = 0;
    shopping_cart_table_update();
}

function is_sku_in_cart (cart, sku) {
    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];
        if (item.sku == sku) {
            return 1;
        }
    }
    return 0
}

function sku_is_espresso_machine (sku) {

    // de1
    if (sku.search("DE-DE1") != -1) {
        return 1
    }

    // bengle
    if (sku.search("DE-BE1") != -1) {
        //return 1
    }

    if (sku.search("DE-BUILDBE1") != -1) {
        return 1
    }

    return 0
}

function cart_has_accessories (cart) {

    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];

        if (item.quantity == 0) {
            continue
        }


        if (sku_is_espresso_machine(item.sku) == 0) { 

            var skudata = decent_products[item.sku];

            if (skudata == undefined) {
                decent_log("unknown SKU: "+item.sku);
                continue
            }

            if (skudata.shippable == "no") {
                //decent_log("Ok to have unshippable item " + item.sku + " on cart");
                continue
            }

            if (skudata.free_shipping == "no") {
                //decent_log("Ok to have unshippable item " + item.sku + " on cart");
                continue
            }

            if (item.replaces != undefined) {
                //decent_log("Ok to have replacement item " + item.sku + " on cart");
                continue
            }
            //debugger

            return 1;
        }
    }
    return 0
}

function cart_has_which_de1 (cart) {

    if (cart == undefined) {
        return ""
    }

    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];

        if (item.quantity == 0) {
            continue
        }


        if (sku_is_espresso_machine(item.sku) == 1) {
            var skudata = decent_products[item.sku];
            if (skudata == undefined) {
                decent_log("unknown SKU: "+item.sku);
                continue
            }

            if (skudata.shippable == "no") {
                decent_log("Ok to have unshippable item " + item.sku + " on cart");
                continue
            }
            //debugger

            return item.sku;
        }
    }
    return ""
}


function cart_has_de1 (cart) {
    if (cart == undefined) {
        return 0
    }

    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];

        if (item.quantity == 0) {
            continue
        }


        if (sku_is_espresso_machine(item.sku) == 1) {


            var skudata = decent_products[item.sku];
            if (skudata == undefined) {
                decent_log("unknown SKU: "+item.sku);
                continue
            }

            if (skudata.shippable == "no") {
                decent_log("Ok to have unshippable item " + item.sku + " on cart");
                continue
            }
            //debugger

            return 1;
        }
    }
    return 0
}

function cart_has_de1_how_many (cart) {
    var count = 0
    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];

        if (item.quantity == 0) {
            continue
        }

        if (sku_is_espresso_machine(item.sku) == 1) {


            var skudata = decent_products[item.sku];
            if (skudata == undefined) {
                decent_log("unknown SKU: "+item.sku);
                continue
            }

            if (skudata.shippable == "no") {
                decent_log("Ok to have unshippable item " + item.sku + " on cart");
                continue
            }

            count += item.quantity
        }
    }
  
    return count
}


function cart_has_warranty_shipping (cart) {
    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];

        if (item.quantity == 0) {
            continue
        }

        if (item.sku.search("DE-WARRANTYSHIPPING") != -1) {
            return 1;
        }
    }
    return 0
}


function replacer(match, p1, p2, p3, offset, string) {
  // p1 is non-digits, p2 digits, and p3 non-alphanumerics
    //debugger
    //console.log(p1)
    var t = ""
    try {
        t = dt(p1)
    } catch {}

    return t;

  //return [p1, p2, p3].join(" - ");
}

// paragraph (multiple tcl [dt "xyz"] translation parts
function dtfromtcl (str)  {

    str = str.replaceAll(/\[dt {(.*?)}\]/g, replacer);
    str = str.replaceAll(/\[dt "(.*?)"\]/g, replacer);
    //str = str.replaceAll(/\[dt {(.*?)}\]/g, replacer);

    //debugger
    return str
}

function replaceDtOccurrences(input, replacementFunction) {
    const regex = /\[dt .*?\]/;
    let match;
    
    while ((match = regex.exec(input)) !== null) {
        const replacement = replacementFunction(match[0]);
        input = input.substring(0, match.index) + replacement + input.substring(match.index + match[0].length);
        // Update the regex.lastIndex to continue searching after the last replacement
        regex.lastIndex = match.index + replacement.length;
    }
    
    return input;
}

function dt (str)  {
    if (str == "" || mylang == "en") {        
        return str;
    }

    var trans = decent_translation[str];
    if (trans != undefined) {
        return trans
    }

    //debugger
    //decent_log(str);
    //var x = (typeof decent_translation)
    //debugger;
    if ((typeof decent_translation) == "undefined" || Object.keys(decent_translation) == 0 ) {
        trans = str
    } else {
        if (trans == undefined) {
            //decent_log("No translation for '" + str + "'");

            var sample = "\"" + str + "\" : \"<%= [dtq {" + str + "}] %>\",";

            // only indicate missing translation items to the javascript console when connected via localhost
            //if (location.hostname === "localhost" || location.hostname === "127.0.0.1") {
                decent_log(sample);
            //}
            //return "[<b>" + str + "</b>]";
            return str;
        }
    }
    return trans;
}

function dt_list (inlist)  {
    var outlist = [];
    var materials_translated = [];
    for (var i = 0, length = inlist.length; i < length; i++) {
        outlist.push(dt(inlist[i]));
    }
    return outlist;
}

