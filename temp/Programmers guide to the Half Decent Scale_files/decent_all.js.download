                additional_text = additional_text + "<br><li>" + my_currency_price(nt(shipping_cost)) + " " + dt("shipping") + " + " + my_currency_price(nt(tax)) + " " + dt("tax") + " = " + my_currency_price(nt(convert_number_from_hkd_to_curency(+shipment_costs['total_charge'], my_currency()))) + " " + dt("total");

                //additional_text = additional_text + "<br>= " + my_currency_price(nt(convert_number_from_hkd_to_curency(+shipment_costs['total_charge'], my_currency())));
