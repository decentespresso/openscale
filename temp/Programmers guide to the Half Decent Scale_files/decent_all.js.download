}




function array_kv_keys (arr) {
    var toreturn = [];

    for (var i = 0, length = arr.length; i < length; i++) {    
        var k = arr[i];
        toreturn.push(k);
        i++;
    }

    return toreturn;
}


function array_kv_vals (arr) {
    var toreturn = [];

    for (var i = 0, length = arr.length; i < length; i++) {    
        i++;
        var k = arr[i];
        toreturn.push(k);
    }

    return toreturn;
}


function zeropad(num, size) {
    var s = num+"";
    while (s.length < size) s = "0" + s;
    return s;
}

function all_keys (arr) {
    var keys = [];
    for (var key in arr) {
      if (arr.hasOwnProperty(key)) {
        keys.push(key);
      }
    }
    return keys;
}

