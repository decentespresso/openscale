function pretty_date (cdate) {

    var months = new Array(12);
    months[0] = dt("January");
    months[1] = dt("February");
    months[2] = dt("March");
    months[3] = dt("April");
    months[4] = dt("May");
    months[5] = dt("June");
    months[6] = dt("July");
    months[7] = dt("August");
    months[8] = dt("September");
    months[9] = dt("October");
    months[10] = dt("November");
    months[11] = dt("December");

    var current_date = new Date(cdate);
    month_value = current_date.getMonth();
    day_value = current_date.getDate();
    year_value = current_date.getFullYear();

    var pretty = months[month_value] + " " + day_value + ", " + year_value;

    if (mylang == "fr" || mylang == "it") {    
        pretty = day_value + " " + months[month_value] + " " + year_value;
    } else if (mylang == "de") {    
        pretty = day_value + ". " + months[month_value] + " " + year_value;
    } else if (mylang == "es") {    
        pretty = day_value + " de " + months[month_value] + " " + year_value;
    } else if (mylang == "zh-hans" || mylang == "zh-hant") {    
        pretty = year_value + "&#x5E74;" + (1+month_value) + "&#x6708;" + day_value + "&#x65E5;";
    }

    return pretty;
}



function change_class_to_display_inline (classname) {

    var elems = document.getElementsByClassName(classname);
    for (i in elems) {
        if (elems[i].style != undefined) {
            elems[i].style.display = "inline";
        }
    }
}

function change_class_to_not_hidden (classname) {

    var elems = document.getElementsByClassName(classname);
    for (i in elems) {
        if (elems[i].style != undefined) {
            elems[i].style.visibility = "visible";

            //style.visibility = "hidden"
        }
    }
}


function change_class_to_display_none (classname) {

    var elems = document.getElementsByClassName(classname);
    for (i in elems) {
        if (elems[i].style != undefined) {
            elems[i].style.display = "none";
        }
    }
}


function change_class_to_display_blank (classname) {

