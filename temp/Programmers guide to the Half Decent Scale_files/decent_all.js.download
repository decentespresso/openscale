            ship_warning_html += "<div style='display:inline' class='includesvat'><br>&nbsp;<i style=\"font-size: " + title_sub_font_size + ";color:#444444\" class=\"icon fa-user-circle\">&nbsp;" + dt("VAT and duty fees will be prepaid for you.") + "</i></div>";
