var decentliveserver = true;

var dimgloc = "http://localhost:8000"

// redirect to https if on live server
if (decentliveserver == 1) {
    dimgloc = "//fast.decentespresso.com"

    if (window.location.protocol != "https:") {
        var x = window.location.hostname;
        if (window.location.hostname == "decentespresso.hk" || window.location.hostname == "decentespresso.com.hk" || window.location.hostname == "www.decentespresso.hk" || window.location.hostname == "www.decentespresso.com.hk") {
            // no https at the moment
        } else {
            window.location.href = "https:" + window.location.href.substring(window.location.protocol.length);
        }
    }
}
