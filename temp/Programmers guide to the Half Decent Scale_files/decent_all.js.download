                    additional_text = additional_text + " " + dt("The espresso machine hardware is physically shipped, while the software is supplied separately online and is not included in the shipment.");
                    additional_text = additional_text + " " + dt("The hardware value stated on the shipping invoice is shown separately during payment and in your order documentation.");
                    additional_text = additional_text + " " + dt("Depending on the destination and customer type, additional tax obligations may apply.");

                    if (my_country == "AU") {
