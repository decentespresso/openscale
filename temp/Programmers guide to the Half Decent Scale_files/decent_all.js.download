                break
            }

            for (fi = 0; fi < filter_values.length; fi++) {
                this_filter_value = filter_values[fi]

                
                if (skudata.one_liner.toLowerCase().search(this_filter_value) != -1) {
                    match_count = match_count + 1;
                    //decent_log("matched one liner: " + this_filter_value);
                } else if (item.sku.toLowerCase().search(this_filter_value) != -1) {
                    match_count = match_count + 1;
                    
                    //decent_log("matched sku: " + this_filter_value);
                
                } else if (skudata.attributes != undefined) {

                    if (skudata.attributes.toLowerCase().search(this_filter_value) != -1) {
                        
                        match_count = match_count + 1;
        
                    }
                    //decent_log("matched sku: " + this_filter_value);
                } else if (skudata.multi_liner != undefined) {

                    if (skudata.multi_liner.toLowerCase().search(this_filter_value) != -1) {
                        
                        match_count = match_count + 1;
        
                    }
                    //decent_log("matched sku: " + this_filter_value);
                }
        
            }
            

            // this handles searching for multiple words, and only returns cases where all the words were found
            if (match_count == filter_values.length) {
                skip_this = 0;
            }
        

            if (mylang != "en") {            
                if (dt(skudata.one_liner).toLowerCase().search(filter_value) != -1) {
                    skip_this = 0
                    //debugger
                }
            }

