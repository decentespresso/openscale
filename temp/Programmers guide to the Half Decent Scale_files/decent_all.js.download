        var page_hits = "";

        var filter_values  = filter_value.split(/[ \.,:\-]/), i;
        
        var match_count = 0;
        var page_hit_count = 0
        var this_filter_value;


        // Guard against a missing per-language search data file (e.g. an absent
        // quickstart_<lang>.js) leaving one of these vars undefined, which would
        // otherwise throw a ReferenceError and break the whole cart page.
        var _search_page = (typeof decent_page_search !== "undefined") ? decent_page_search : {};
        var _search_blog = (typeof search_blog !== "undefined") ? search_blog : {};
        var _search_docs = (typeof search_docs !== "undefined") ? search_docs : {};
        var _search_quickstart = (typeof search_quickstart !== "undefined") ? search_quickstart : {};

        for (const [key, value] of Object.entries(_search_page).concat(Object.entries(_search_blog),Object.entries(_search_docs),Object.entries(_search_quickstart))) {

            match_count = 0;
            for (i = 0; i < filter_values.length; i++) {
                this_filter_value = filter_values[i]
                if (key.search(this_filter_value) != -1 || value.toLowerCase().search(this_filter_value) != -1) {
                    //debugger
                    match_count = match_count + 1;
                }
            }

            // this handles searching for multiple words, and only returns cases where all the words were found
            if (match_count == filter_values.length) {
                page_hit_count++;
                //debugger
                page_hits += "<li><a href='/" + key + "'>" + value + "</a>"
            }
        }

        if (page_hits != "") {
            if (page_hit_count == 1) {
                tablehtml += "<tr><td colspan=3><h4>" + dt("Your search matches this web page:") + "</h4><ul style=\"list-style-type: '&blk12;'\">"
                tablehtml += page_hits            
                tablehtml += "</ul></td></tr>"
