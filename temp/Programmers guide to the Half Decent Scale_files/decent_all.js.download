function load_default_shopping_image (img, sku) {
    //swap_hrefed_image_radio(img, '', '/img/small/' + sku + '_880x568.jpg', '/img/' + sku + '.jpg', sku)
    swap_hrefed_image_radio(img, '', '/img/small/' + sku + '_880x568.avif', '/img/' + sku + '.jpg', sku)
    //debugger
    //swap_hrefed_image_radio(img, '', '/img/small/' + sku + '-grey_440x284.avif', 'img/' + sku + '.jpg', sku)
}

function shopping_cart_url_version(cart, freeremove) {
    var skunumbers = [];
    var skuquantities = [];
    var urlparts = [];
    var count = 0;
    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];
        var quantity = item.quantity;
        if (cart[i].free == 1) {
            continue;
        }
        if (cart[i].quantity == 0) {
            continue;
        }
        if (cart[i] == undefined) {
            decent_log("No item in cart for item #: " + i);
            continue
        }
        count += cart[i].quantity;

        var skuumber_text = item.sku.slice(-5);
        var skunumber = +skuumber_text;

        skuquantities.push(quantity);
        skunumbers.push(skunumber);
        
        if (cart[i].replaces != undefined) {
            // replacements are handled as a -sku appended to the quantity
            var rskuumber_text = item.replaces.slice(-5);
            var rskunumber = +rskuumber_text;
            quantity = "-" + rskunumber;
            //debugger
        }

        urlparts.push(skunumber);
        urlparts.push(quantity);
    } 

    //var url = "s="+ skunumbers.join('+') + "&q=" + skuquantities.join('+');
    var url = "";
    if (urlparts.length > 0) {
        url = "?s="+ urlparts.join('+');
    }
    //decent_log("my url: " + url);
    return url;
}


function shopping_cart_item_count() {
    var cart = Cookies.getJSON('cart'); 
    if (cart == undefined) { return 0 };
    var count = 0;
    for (var i = 0, length = cart.length; i < length; i++) {
    if (cart[i] == undefined) {
        decent_log("(shopping_cart_item_count) No item in cart for item #: " + i);
        continue
    }

        count += cart[i].quantity;
    } 

    return count;
}


