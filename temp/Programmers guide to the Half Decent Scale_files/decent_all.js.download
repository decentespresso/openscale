    }

    return toreturn;
}



function add_item_to_cart (cart, newitem) {

    var skudata = decent_products[newitem.sku];

    if (skudata != undefined) {

        if (skudata.showall_hide == "yes" && is_admin() != 1) {
            if (newitem.replaces == undefined) {
                // we do allow replacements though
                decent_log("SKU can only be ordered by a Decent Admin: " + newitem);
                return cart;
            }
        }

        //if (skudata.sale_item != undefined && is_admin() != 1) {
        //    decent_log("SKU can only be ordered by a Decent Admin: " + newitem);
        //    return cart;
        //	}


    }

    var newcart = [];
    var found = false;
    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];

        if (item == undefined) {
            decent_log("cart item " + i + " is undefined, skipping");
            continue
        }

        if (item.sku == undefined) {
            decent_log("cart item " + i + " has no sku, skipping");
            continue
        }
        if (newitem.sku == undefined) {
            decent_log("new item has no sku, skipping");
            continue
        }
        if (item.sku == newitem.sku) {
            found = true;

            if (item.replaces != undefined) {
                // items that are replacements cannot be added more than quantity=1
                item.quantity = 1
            } else {
                item.quantity += newitem.quantity;
            }
            
        }
        newcart.push(item);
    }

    if (found == false)  {
        newitem.time = seconds_since_epoch();
        newcart.push(newitem);
    }

    newcart.sort(sku_compare);

    //decent_log("new cart 1: " + newcart);
    return newcart;

}

function shopping_cart_update_quantities() {
    var cart = Cookies.getJSON('cart'); 

    var newcart = [];
    // build a new cart
    for (var i = 0, length = cart.length; i < length; i++) {
        newcart = add_item_to_cart(newcart, cart[i]);
    } 

    var result = JSON.stringify(newcart);
    //decent_log("new cart: " + result);
    Cookies.set('cart', result, { expires: 365 });
}

