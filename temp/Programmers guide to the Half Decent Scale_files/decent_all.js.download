                        important_note += dt("In most cases, this allows your package to arrive faster and at a lower tax rate for you.");

                        important_note += "<br><br>";
                        important_note += dt("We recommend you buy the espresso machine alone, with no other products in the same order.") + " ";
                        important_note += dt("This is because we always ship the espresso machine alone.") + " ";
                        important_note += dt("If customs eventually asks for proof of payment, this way your credit card statement will exactly match the shipment.");
                        
                        additional_text += important_note + "<br><br>";
                    }

                } else if (item.sku.search('DE1') != -1 && tax != 0 && (my_country == "CN")) {
