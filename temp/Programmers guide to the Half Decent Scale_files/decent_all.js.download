function update_shipto_country () {
    var newcountry = document.getElementById('country').value;
    Cookies.set('my_country', newcountry, { expires: 365 });
    Cookies.set('selected_shipper', "", { expires: -1 });
    Cookies.set('shipping_fees', "", { expires: -1 });
    Cookies.set('shipping_taxes', "", { expires: -1 });
    Cookies.set('currency', "", { expires: -1 });
    my_country = newcountry;

    var currency = country_to_currency(my_country);
    //if (currency != "") {
    //    Cookies.set('currency', currency, { expires: 365 });  
        //debugger;
    //}

    //////////
    // power cable change check

    var cart = Cookies.getJSON('cart'); 

    if (cart == undefined) {
        decent_log("empty cart");
        //return
    }  else {

        for (var i = 0, length = cart.length; i < length; i++) {
            var item = cart[i];
            var sku = item.sku
            
            if (sku_is_espresso_machine(sku) == 1) {

                var skudata = decent_products[sku];
                if (skudata == undefined) {
                    decent_log("Undefined SKU found '" + sku + "'");
                } else {

                    var is_110v = skudata.one_liner.search("110")

                    if (is_110v == -1) {

                        var is_pro = sku.search("DE-DE1PRO")

                        if (is_pro == -1) {
                            // DE1XL/XXL
                            //remove_replacements_from_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278")
                        } else {
                            // DE1PRO
                            //remove_replacements_from_shopping_cart ("DE-PWRCORDEUC136FTVDE-73273")
                        }
                            remove_replacements_from_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278")
                            remove_replacements_from_shopping_cart ("DE-PWRCORDEUC136FTVDE-73273")
                        add_appropriate_220v_power_cable(sku)
                    }
                }


            }

        }

    }
    //if (found == false)  {
        //newcart.push(item);
    //}

    //shopping_cart_table_update();

    window.location.reload(false); 
}

function add_appropriate_220v_power_cable (sku) {

    var is_pro = sku.search("DE-DE1PRO")

    if (is_pro == -1) {
        // 220V XL/XXL machines
        if (my_country == "AU" || my_country == "CN") {
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDAUSRAC136FTUL_R1-73284") 
            
        } else if (my_country == "CH") {
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDSWITRAC136FTUL_R1-73286") 
            
        } else if (my_country == "IL") {
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDISRRAC136FTVDE_R1-73285") 
            
        } else if (my_country == "US") {
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDNEMA615RAC136FTUL_R1-73287") 
            
        } else if (my_country == "UK" || my_country == "HK" || my_country == "CY" || my_country == "IE" || my_country == "MO" || my_country == "SA" || my_country == "SG" || my_country == "KW" || my_country == "AE" || my_country == "QA") {
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDUKRAC136FTVDE_R1-73282") 
        }
    } else {

        // 220V PRO machines
        if (my_country == "AU" || my_country == "CN") {
            //add_to_shopping_cart ("DE-PWRCORDEUC136FTVDE-73273", 1, "DE-PWRCORDAUSC136FTSAA-73274") 
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDAUSRAC136FTUL_R1-73284") 
            
        } else if (my_country == "CH") {
            //add_to_shopping_cart ("DE-PWRCORDEUC136FTVDE-73273", 1, "DE-PWRCORDSWITC136FTVDE-73275") 
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDSWITRAC136FTUL_R1-73286") 
            
        } else if (my_country == "IL") {
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDISRC136FTIEC-73276") 
            
        } else if (my_country == "US") {
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDNEMA615RAC136FTUL_R1-73287") 
            
        } else if (my_country == "UK" || my_country == "HK" || my_country == "CY" || my_country == "IE" || my_country == "MO" || my_country == "SA" || my_country == "SG" || my_country == "KW" || my_country == "AE" || my_country == "QA") {
            //add_to_shopping_cart ("DE-PWRCORDEUC136FTVDE-73273", 1, "DE-PWRCORDUKC136FTBS-73272") 
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDUKRAC136FTVDE_R1-73282") 
        } else  {
            // angled EU cable, instead of straight EU cable, for DE1PRO
            add_to_shopping_cart ("DE-PWRCORDEURAC136FTVDE-73278", 1, "DE-PWRCORDEUC136FTVDE-73273") 
        }

    }
}    

function buy_button_do (sku, customizations) {

    if (sku_is_espresso_machine(sku) == 1) {
        //if (is_mena_warranty_country(my_country) == 1) {
            // for arab countries, add the warranty by default, letting them remove it later
            //add_to_shopping_cart("DE-WARRANTYSHIPPING_PUR-00114", 1);
        //} 

        var skudata = decent_products[sku];
        if (skudata == undefined) {
            decent_log("Undefined SKU found '" + sku + "'");
        } else {

            var is_110v = skudata.one_liner.search("110")

            if (is_110v == -1) {
                add_appropriate_220v_power_cable (sku)
            }
        }

        if (document.getElementById('de1_buy') != undefined) {
            document.getElementById('de1_buy').innerHTML = "";
        }

        var cart = Cookies.getJSON('cart'); 
        var already_has_de1 = cart_has_which_de1(cart);
        if (already_has_de1 != "") {
            // we don't want them to have more than 1 DE1 on their cart at a time
            remove_from_shopping_cart (already_has_de1, 99)
            remove_replacements_from_shopping_cart("*")
        }

        var do_this = 0;
        if (sku.search('V7') != -1) {

            if (Cookies.get('my_country') != "CN" && do_this == 1) {
                // v1.45 DE1 have space for accessories in the suitcase
                add_to_shopping_cart ("DE-SPOT4TAMPER-75782", 1, "DE-TAMPERV5ALUH-00466") 
                add_to_shopping_cart ("DE-SPOT4MILKJUG-75779", 1, "DE-MILKJUG600V3-00152") 
                add_to_shopping_cart ("DE-SPOT4BASKET-75776", 1, "DE-BASKET15V1-00006") 
                add_to_shopping_cart ("DE-SPOT4BASKET2-75777", 1, "DE-BASKET20V1-00008") 
                add_to_shopping_cart ("DE-SPOT4RAKE-75781", 1, "DE-PUCKRAKENATURAL_R2-75751") 
                add_to_shopping_cart ("DE-SPOT4FUNNEL-75778", 1, "DE-PFUNNELV3-00409") 
                add_to_shopping_cart ("DE-INCLUDED2YEARWARRANTY-00994", 1, "DE-FOURYEARWARRANTYEXTEND-00991") 
                
                if (Cookies.get('my_country') != "US") {
                    add_to_shopping_cart ("DE-SPOT4THERMO-75780", 1, "DE-DTHERMCV1-00033") 
                } else {
                    add_to_shopping_cart ("DE-SPOT4THERMO-75780", 1, "DE-DTHERMFV1-00034") 
                }
            }
        }
    }

    buy_button_really_do (sku);

    if (customizations != null) {

        var getvars = customizations;
        
        if (getvars != undefined) {
            var urlget_skus = array_kv_keys(getvars.split('+'));
            var urlget_quantities = array_kv_vals(getvars.split('+'));
            var urlget_quantity = array_sum(urlget_quantities);
            
            shoppingcart_quantity_changed = 0;

            var newcart2 = [];
            var has_de1 = 0;
            for (var i = 0, length = urlget_skus.length; i < length; i++) {

                var getskunum = urlget_skus[i];

                var getreplaces = ""
                var getquantity = urlget_quantities[i];
                if (getquantity < 0) {
                    // replacements are indicated with a negative quantity which is actually the replacement sku
                    var replaces = getquantity.substring(1);
                    getquantity = 1
                    getreplaces = convert_skunum_to_sku(replaces);
                }

                var getsku = convert_skunum_to_sku(getskunum);

                if (getsku != "") {

                    if (sku_is_espresso_machine(getsku) == 1) {            
                        has_de1 = 1
                    }

                    var item2 = {};                    
                    item2.sku = getsku;
                    item2.quantity = +getquantity;

                    if (getreplaces != "") {
                        item2.replaces = getreplaces;
                        add_to_shopping_cart(item2.replaces, item2.quantity, item2.sku);

                    } else {
                        add_to_shopping_cart(item2.sku, item2.quantity);
                    }
                }
            }

            //if (newcart2.length != 0) {
            //    debugger
            //    newcart = newcart2;
            //    newcart.sort(sku_compare);
            //    cart_quantity = shopping_cart_total_quantity_count(newcart);
            //    var cart_json = JSON.stringify(newcart);
            //    Cookies.set('cart', cart_json, { expires: 365 });
            //    decent_log('cart reset by url');
            //}
            //window.location = "/cart"
            
        }
    }
    ////////////////////////////////////////////////////



}



function buy_button_really_do (sku) {

    check_free_shipping_disabled()
    var total_item_quantity = add_to_shopping_cart(sku, 1);

    change_class_to_display_none('discountoffer');
    //decent_log("q: " + total_item_quantity);
    var nextoffer = "";

    //var free_glass_list = get_free_glass_list();

    var total_quantity = shopping_cart_free_shipping_item_count_from_cookie();
    if (total_quantity == 0) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("(buy 3 accessories and they'll be shipped for free)");
        }
    } else if (total_quantity == 1) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("(buy 2 more accessories and get free shipping)");
        }
        nextoffer += " " + dt("(or buy 4 more accessories and get 10% off)");
    } else if (total_quantity == 2) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("(buy 1 more accessory and get free shipping)");
        }
        nextoffer += " " + dt("(or buy 3 more accessories and get 10% off)");
    } else if (total_quantity == 3) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("<b>Hurrah! You're getting free shipping!</b><br>(Next: buy 2 more accessories and <br>get 10% off your accessories order)");
        }
    } else if (total_quantity < 5) {
        var to_go = 5 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 10% off)");
        } else {
            nextoffer = dt("(buy ") + to_go + dt(" more accessories and <br>get 10% off your accessories purchase)");
        }
    } else if (total_quantity == 5) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("<b>Cool! You're getting 10% off your <br>accessories order and free shipping!</b><br>(next: buy 5 more accessories and get 15% off)");
        }
    } else if (total_quantity < 10) {
        var to_go = 10 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 15% off our accessories purchase)");
        } else {
            nextoffer = dt("(buy") + " " + to_go + " " + dt("more accessories and <br>get 15% off your accessories purchase)");
        }
    } else if (total_quantity == 10) {
        nextoffer = dt("<b>Cool! You're getting 15% off your accessories order, and free shipping!</b><br>(next: buy 10 more accessories and 20% off)");
    } else if (total_quantity < 20) {
        var to_go = 20 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 20% off your accessories order.</a>)");
        } else {
            nextoffer = dt("(buy") + " " + to_go + " " + dt("more accessories and <br>get 20% off your accessories order)");
        }
    } else if (total_quantity == 20) {
        nextoffer = dt("<b>What a great day!<br>You're getting free shipping and 20% off your accessories order!</b><br>(next: buy 15 more accessories and get 25% off.");
    } else if (total_quantity < 40) {
        var to_go = 40 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 25% off our accessories purchase)");
        } else {
            nextoffer = dt("(buy") + " " + to_go + " " + dt("more accessories and <br>get 25% off your accessories purchase)");
        }
    } else if (total_quantity == 40) {
        nextoffer = dt("<b>Wicked! You're getting free shipping and 25% off your accessories order!</b><br>(next: buy 40 more accessories and <br>get 30% off your accessories order)");
    } else if (total_quantity < 80) {
        var to_go = 80 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 30% off your accessories order)");
        } else {
            nextoffer = dt("(buy") + " " + to_go + " " + dt("more accessories and <br>get 30% off your accessories order)");
        }
    } else if (total_quantity == 80) {
        nextoffer = dt("<b>Time to celebrate! You're getting free shipping and 30% off your accessories order! Pop open the champagne!</b>");
    } else if (total_quantity > 80) {
        nextoffer = dt("<b>You're getting 30% off your accessories order)");
    }

    var skudata = decent_products[sku];
    if (skudata == undefined) {
        decent_log("Undefined SKU found '" + sku + "'");
    }

    if (typeof skudata.discountable == undefined) {
        skudata.discountable = "yes";
    }

    if (skudata.free_shipping == "no" || skudata.discountable == "no") {
        // if this item does not have free shipping, then don't tell the customer about a free shipping offer, it just confuses them
        nextoffer = "";
    }

    if (free_shipping_disabled == 1) { 
        //nextoffer = nextoffer + "<br>" + dt("Free shipping is temporarily unavailable, due to international postal services suspension.")
    }

    var price = sku_to_price(sku);
    var pricestr = nt(price);
    var total_item_quantitystr = nt(total_item_quantity);

    //decent_log("total_item_quantitystr: " + total_item_quantitystr);
    var new_button_text = "<a id=\"buy_" + sku + "\" onclick=\"javascript:buy_button_do('" + sku + "')\" class=\"button icon fa-check-square\">" + dt("ADDED! Quantity:") + " " + total_item_quantitystr + " X " + my_currency_price(pricestr) + "</a></li><div style='display:inline' class='discountoffer'><br><div style=\"font-size: 90%;display:inline;line-height:160%\">" + nextoffer + "</font><br><br><a class=\"button small icon fa-shopping-cart\" href=\"cart\"> " + dt("view shopping cart") + "</a></div></div>";

	if (skudata.maxquantity != undefined &&  total_item_quantity >= skudata.maxquantity) {
		//new_button_text = "";
		//new_button_text = "<div class='print-only'>" + dt("You've bought all of them") + "</div><div id=\"buy_" + sku + "\" style='display:inline'><a href='cart' class=\"button no-print icon fa-times-circle\">" + dt("No more") + " (" + my_currency_symbol() + pricestr + ")</a></li></div>"
		new_button_text = "<a id=\"buy_" + sku + "\" href=\"/cart\" class=\"button icon fa-check-square\">" + dt("No more! Quantity:") + " " + total_item_quantitystr + " X " + my_currency_price(pricestr) + "</a></li><div style='display:inline' class='discountoffer'><br><div style=\"font-size: 90%;display:inline;line-height:160%\">" + nextoffer + "</font><br><br><a class=\"button small icon fa-shopping-cart\" href=\"cart\"> " + dt("view shopping cart") + "</a></div></div>";
	}

    var button_key = "buy_" + sku;
    if (document.getElementById(button_key) != null) {
        document.getElementById(button_key).innerHTML = new_button_text;
    }
}


function replace_button_do (sku, replacedby, button_key) {

    // first remove any replacements of this sku that already exist
    remove_replacements_from_shopping_cart(sku)

    // then remove any purchases of the replacement sku
    remove_from_shopping_cart (replacedby, 999);

    var cart = Cookies.getJSON('cart'); 

    if (cart == undefined) {
        decent_log("empty cart");
        //debugger
        //cart = [];
        return
    } 

    if (cart_has_de1(cart) != 1) {
        return
    }
    
    // now save this replacement
    var total_item_quantity = 1;
    if (sku != replacedby) {
        total_item_quantity = add_to_shopping_cart(sku, 1, replacedby);
    } else {
        update_shopping_cart_menu(1);
    }

    change_class_to_display_none('discountoffer');
    //decent_log("q: " + total_item_quantity);
    var nextoffer = "";

    //var free_glass_list = get_free_glass_list();

    var total_quantity = shopping_cart_free_shipping_item_count_from_cookie();
    if (total_quantity == 0) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("(buy 3 accessories and they'll be shipped for free)");
        }
    } else if (total_quantity == 1) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("(buy 2 more accessories and get free shipping)");
        }
        nextoffer += " " + dt("(or buy 4 more accessories and get 10% off)");
    } else if (total_quantity == 2) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("(buy 1 more accessory and get free shipping)");
        }
        nextoffer += " " + dt("(or buy 3 more accessories and get 10% off)");
    } else if (total_quantity == 3) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("<b>Hurrah! You're getting free shipping!</b><br>(Next: buy 2 more accessories and <br>get 10% off your accessories order)");
        }
    } else if (total_quantity < 5) {
        var to_go = 5 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 10% off)");
        } else {
            nextoffer = dt("(buy ") + to_go + dt(" more accessories and <br>get 10% off your accessories purchase)");
        }
    } else if (total_quantity == 5) {
        if (free_shipping_disabled != 1) { 
            nextoffer = dt("<b>Cool! You're getting 10% off your <br>accessories order and free shipping!</b><br>(next: buy 5 more accessories and get 15% off)");
        }
    } else if (total_quantity < 10) {
        var to_go = 10 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 15% off our accessories purchase)");
        } else {
            nextoffer = dt("(buy") + " " + to_go + " " + dt("more accessories and <br>get 15% off your accessories purchase)");
        }
    } else if (total_quantity == 10) {
        nextoffer = dt("<b>Cool! You're getting 15% off your accessories order, and free shipping!</b><br>(next: buy 10 more accessories and 20% off)");
    } else if (total_quantity < 20) {
        var to_go = 20 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 20% off your accessories order.</a>)");
        } else {
            nextoffer = dt("(buy") + " " + to_go + " " + dt("more accessories and <br>get 20% off your accessories order)");
        }
    } else if (total_quantity == 20) {
        nextoffer = dt("<b>What a great day!<br>You're getting free shipping and 20% off your accessories order!</b><br>(next: buy 15 more accessories and get 25% off.");
    } else if (total_quantity < 40) {
        var to_go = 40 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 25% off our accessories purchase)");
        } else {
            nextoffer = dt("(buy") + " " + to_go + " " + dt("more accessories and <br>get 25% off your accessories purchase)");
        }
    } else if (total_quantity == 40) {
        nextoffer = dt("<b>Wicked! You're getting free shipping and 25% off your accessories order!</b><br>(next: buy 40 more accessories and <br>get 30% off your accessories order)");
    } else if (total_quantity < 80) {
        var to_go = 80 - total_quantity;
        if (to_go == 1) {
            nextoffer = dt("(buy 1 more accessory and <br>get 30% off your accessories order)");
        } else {
            nextoffer = dt("(buy") + " " + to_go + " " + dt("more accessories and <br>get 30% off your accessories order)");
        }
    } else if (total_quantity == 80) {
        nextoffer = dt("<b>Time to celebrate! You're getting free shipping and 30% off your accessories order! Pop open the champagne!</b>");
    } else if (total_quantity > 80) {
        nextoffer = dt("<b>You're getting 30% off your accessories order)");
    }

    var skudata = decent_products[sku];
    if (skudata == undefined) {
        decent_log("Undefined SKU found '" + sku + "'");
    }

    if (typeof skudata.discountable == undefined) {
        skudata.discountable = "yes";
    }

    if (skudata.free_shipping == "no" || skudata.discountable == "no") {
        // if this item does not have free shipping, then don't tell the customer about a free shipping offer, it just confuses them
        nextoffer = "";
    }

    //if (free_shipping_disabled == 1) { 
        //nextoffer = nextoffer + "<br>" + dt("Free shipping is temporarily unavailable, due to international postal services suspension.")
    //}

    var price = sku_to_price(sku);
    var pricestr = nt(price);
    var total_item_quantitystr = nt(total_item_quantity);
    //decent_log("total_item_quantitystr: " + total_item_quantitystr);

    var new_button_text = "";

    if (sku != replacedby) {

        var price = price_replaces(sku, replacedby);
        var price_string = nt(price);

        new_button_text = "<a style='background-color: #c5ffb7; box-shadow: 0px 0px;' id=\"buy_" + sku + "\" xonclick=\"javascript:void()\" class=\"button icon fa-check-square\">" + dt("Replacement saved")  + " : " + my_currency_price(price_string) + "</a></li></font></div>";
    } else {
        //var toreturn = "<div class='print-only'>" + txt + " " + my_currency_price(price_string) + "</div><div id=\"buy_" + replacedby + "\" style='display:inline;'><a xonclick=\"javascript:void();\" style='background-color: #EEEEEE; box-shadow: 0px 0px;' class=\"button no-print icon " + fontawesomeicon + "\">" + txt + "</a></li>" + ship_warning_html + "</div>"

        new_button_text = "<a style='background-color: #EEEEEE; box-shadow: 0px 0px;' id=\"buy_" + sku + "\" xonclick=\"javascript:void()\" class=\"button icon fa-long-arrow-down\">" + dt("choose a replacement") + "&nbsp;<i class='icon fa-long-arrow-down'></i>" + "</a></li></font></div>";
          
    }
    //var new_button_text = "<div class='print-only'>" + txt + " " + my_currency_price(price_string) + "</div><div id=\"buy_" + replacedby + "\" style='display:inline'><a onclick=\"javascript:void()\" style='background-color: #c5ffb7; box-shadow: 0px 0px;' class=\"button no-print icon undo\">" + txt + "</a></li>" + ship_warning_html + "</div>"

    if (skudata.maxquantity != undefined &&  total_item_quantity >= skudata.maxquantity) {
        //new_button_text = "";
        //new_button_text = "<div class='print-only'>" + dt("You've bought all of them") + "</div><div id=\"buy_" + sku + "\" style='display:inline'><a href='cart' class=\"button no-print icon fa-times-circle\">" + dt("No more") + " (" + my_currency_symbol() + pricestr + ")</a></li></div>"
        new_button_text = "<a id=\"buy_" + sku + "\" href=\"/cart\" class=\"button icon fa-check-square\">" + dt("No more! Quantity:") + " " + total_item_quantitystr + " X " + my_currency_price(pricestr) + "</a></li><div style='display:inline' class='discountoffer'><br><div style=\"font-size: 90%;display:inline;line-height:160%\">" + nextoffer + "</font><br><br><a class=\"button small icon fa-shopping-cart\" href=\"cart\"> " + dt("view shopping cart") + "</a></div></div>";
    }
//debugger;
    //var button_key = "0_btn";
    document.getElementById(button_key).innerHTML = new_button_text;
}


function set_buy_sale_btn(divname, sku, maxquantity) {
    if (sku == undefined) {
        debugger
    }
    if (maxquantity == undefined) {
        debugger
    }

    if (decent_products[sku] == undefined) {
        decent_log("can't find sku for set_buy_sale_btn: '" + sku + "' for quantity: '" + maxquantity + "'");
        return ""
        debugger
    }

	decent_products[sku].maxquantity  = maxquantity;
	return set_buy_btn(divname, sku);
}

function buy_bundle(skustring) {

    var skus = skustring.split(' ');

    for (var i = 0, length = skus.length; i < length; i++) {
        var sku = skus[i];
        add_to_shopping_cart (sku, 1);
    }

    window.location.href = "/cart";

}

function set_buy_btn(divname, sku, customizations) {


    var skudata = decent_products[sku];
    if (skudata == undefined) {
        decent_log("Undefined SKU for set_buy_btn: '" + sku + "'");
        //return;
    }

    //decent_log("Buy button for " + divname + " set to sku: " + sku  + " '" + skudata.one_liner + "'");

    var no_instock_display = 0
    if (divname.includes("_simple") == true) {
        no_instock_display = 1
    }

    var newcontent = btn_add_to_shopping(sku, customizations, no_instock_display);
    if (document.getElementById(divname) == null) {
        debugger;
    }
    document.getElementById(divname).innerHTML = newcontent;
}

function set_buy_btn2(divname, varvalue, skus) {
    var sku = skus[varvalue];

    if (sku == null || sku == "") {
        decent_log("Cannot find index " + varvalue + " in '" + skus + "'"); 
    }

    var skudata = decent_products[sku];
    if (skudata == undefined) {
        decent_log("Undefined SKU for set_buy_btn2: '" + sku + "'");
        debugger
        return;
    }

    //decent_log("Buy button for " + divname + " set to sku: " + sku  + " '" + skudata.one_liner + "'");

    var no_instock_display = 0
    if (divname.includes("_simple") == true) {
        no_instock_display = 1
    }

    var newcontent = btn_add_to_shopping(sku, "", no_instock_display);
    document.getElementById(divname).innerHTML = newcontent;
}

function set_replace_btn(divname, varvalue, skus, replacedby) {
        
    var sku = skus[varvalue];
    var replacesku = skus[replacedby];
    //var sku = varvalue;

    if (sku == null || sku == "") {
        //decent_log("Cannot find index " + varvalue + " in '" + skus + "'"); 
    }

    var skudata = decent_products[sku];
    if (skudata == undefined) {
        decent_log("Undefined SKU for set_replace_btn: '" + sku + "'");
        return;
    }

    var skudata2 = decent_products[replacesku];
    if (skudata2 == undefined) {
        decent_log("Undefined SKU2 for set_replace_btn: '" + replacesku + "'");
        return;
    }
    //debugger


    //decent_log("Buy button for " + divname + " set to sku: " + sku  + " '" + skudata.one_liner + "'");

    var newcontent = btn_replace_to_shopping(sku, replacesku, divname);

    //var newcontent = btn_add_to_shopping(sku);
    //debugger

    document.getElementById(divname).innerHTML = newcontent;
}



function after_page_loads () {
    update_shopping_cart_menu(0);
    update_img_cache_html();

    var reload = getUrlVars()['reload'];
    if (reload != undefined) {
        decent_log("redirecting user to new URL '" + reload + "'");
        window.location = reload;
    }

}

function price_compare(a,b) {
  if (a.price < b.price)
    return -1;
  if (a.price > b.price)
    return 1;
  return 0;
}

function filter_reset() {
    ChangeUrl(dt('Show all'), '?show=all')
    var filter_field = document.getElementById("filter");
    var filter_value = "";
    if (filter_field != undefined) {
        filter_field.value = ""
    }

}

function filter_get () {
    var filter_field = document.getElementById("filter");
    var filter_value = "";
    if (filter_field != undefined) {
        filter_value = filter_field.value.toLowerCase();
        if (filter_value != "") {
            ChangeUrl(dt('Show all'), '?filter='+filter_value)
        }
    }

    if (filter_value == "") {
        if (getUrlVars()['filter'] != undefined) {
            filter_value = getUrlVars()['filter'].toLowerCase();
        };

        if (filter_value != "") {
            ChangeUrl(dt('Show all'), '?filter='+filter_value)
        } else {
            //ChangeUrl(dt('Show all'), '?show=all')
    //debugger;
        }

    }

    return filter_value;

}

function set_shipper_to_cheapest_if_unset () {

    var selected_shipper = Cookies.get('selected_shipper'); 
    var cheapest_shipper = Cookies.get('cheapest_shipper'); 

    if (selected_shipper == undefined || selected_shipper == "") {
        selected_shipper = cheapest_shipper;
        Cookies.set('selected_shipper', selected_shipper, { expires: 365 });
    }
}

function check_free_shipping_disabled () {

//"VN",
    //const hkpost = [ "ID", "JP", "KR", "SG", "TH", "PH", "IN", "TW", "AT", "BE", "HR", "DK", "FI", "GR", "HU", "LU", "NL", "NO", "PL", "PT", "RO", "SI", "ES", "SE", "CH", "GB", "UK", "DE", "US", "FR", "AU", "NZ", "CA", "AE", "IE", "DK", "IT", "SI", "BN", "MY", "MO"];

    if (hk_post_countries.indexOf(my_country) > -1) {
        //decent_log(my_country + " has hkpost service");
        free_shipping_disabled = 0;
    } else if (economiq_countries.indexOf(my_country) > -1) {
        free_shipping_disabled = 0;
    }

}


function shopping_cart_table_update_html() {

    check_free_shipping_disabled()

    // load their shopping cart
    var cart = Cookies.getJSON('cart'); 
    if (cart == undefined || cart == "undefined" || cart == "") {
        cart = [];
    } 

    var filter_value = filter_get();
    if (filter_value != "") {
        shopping_cart_display_all_products_yes = 1;
    }

    //free_glass_list = get_free_glass_list();
    cart.sort(sku_compare);

    var newcart = cart;
    var tablehtml = "";
    var running_total = 0;
    var total_quantity = 0;
    var discountable_quantity = 0;
    var discountable_total = 0;
    var minwidth = 980;
    var title_font_size = "size=+1";
    var title_sub_font_size = "90%";
    var side_margin = "10%";
    var plusminusbtnsize = "100%";
    //var plusminusseparator = "&nbsp;&nbsp;&nbsp;&nbsp;";
    var plusminusseparator = "";
    var shopping_table_id = document.getElementById("shoppingtable");
    var extrabrdisplay = "inline";
    var verynarrow = 0;
    var searchwidth = 10;
    var carttitle = dt("Shopping Cart");
    //decent_log("window width: " + window.innerWidth);
    if (window.innerWidth < minwidth) {
        verynarrow = 1;
        decent_log("narrow screen mode");
        searchwidth = 5;
        shopping_table_id.style["width"] = "100%";
        shopping_table_id.style["margin-left"] = "0%";
        shopping_table_id.style["margin-right"] = "0%";
        shopping_table_id.style["padding"] = ".1em .1em;";
        shopping_table_id.style["margin-right"] = "0%";
        shopping_table_id.style["line-height"] = " 130%";
        shopping_table_id.className = "alt";
        title_font_size = "size=+0;";
        title_sub_font_size = "80%";
        plusminusbtnsize = "100%";
        plusminusseparator = "&nbsp;";
        extrabrdisplay = "none";
        carttitle = dt("Cart");
    }
    shopping_table_id.style["margin"] = "0 0 0 0;";

    // if notes are passed in the url then save them to a cookie
    if (getUrlVars()['notes'] != undefined) {
        Cookies.set('notes', getUrlVars()['notes'], { expires: 365 });
        decent_log("setting notes cookie to: '" + getUrlVars()['notes'] + "'");
    }

    ////////////////////////////////////////////////////
    // check for a pasted-in shopping cart URL
    var cart_quantity = shopping_cart_total_quantity_count(newcart);
    var cart__free_shipping_quantity = shopping_cart_free_shipping_item_count_from_cookie();
    var showall = getUrlVars()['show'];
    var filter = getUrlVars()['filter'];
    if (filter != null) {
        showall = "all"
    }

    var getvars = getUrlVars()['s'];
    
    if (getvars != undefined) {
        var urlget_skus = array_kv_keys(getvars.split('+'));
        var urlget_quantities = array_kv_vals(getvars.split('+'));
        var urlget_quantity = cart_url_array_sum(urlget_quantities);
        
        if (urlget_quantity != 0 && urlget_quantity != cart_quantity && shoppingcart_quantity_changed != 1) {
            shoppingcart_quantity_changed = 0;

            // the URL was pasted in with a shopping cart, and so we need to reset the shopping cart to whatever is in the url
            decent_log("URL pasted into cart");            

            var newcart2 = [];
            var has_de1 = 0;
            for (var i = 0, length = urlget_skus.length; i < length; i++) {

                var getskunum = urlget_skus[i];

                var getreplaces = ""
                var getquantity = urlget_quantities[i];
                if (getquantity < 0) {
                    // replacements are indicated with a negative quantity which is actually the replacement sku
                    var replaces = getquantity.substring(1);
                    getquantity = 1
                    getreplaces = convert_skunum_to_sku(replaces);
                    //debugger
                }

                var getsku = convert_skunum_to_sku(getskunum);

                if (getsku != "") {

                    if (sku_is_espresso_machine(getsku) == 1) {            
                        has_de1 = 1
                    }

                    var item2 = {};                    
                    item2.sku = getsku;
                    item2.quantity = +getquantity;

                    if (getreplaces != "" && has_de1 == 1) {
                        item2.replaces = getreplaces;
                        add_to_shopping_cart(item2.replaces, item2.quantity, item2.sku);

                    } else {
                        add_to_shopping_cart(item2.sku, item2.quantity);
                    }
                }
            }

            if (newcart2.length != 0) {
                newcart = newcart2;
                newcart.sort(sku_compare);
                cart_quantity = shopping_cart_total_quantity_count(newcart);
                var cart_json = JSON.stringify(newcart);
                Cookies.set('cart', cart_json, { expires: 365 });
                decent_log('cart reset by url');
            }
            window.location = "/cart"
        }
    }
    ////////////////////////////////////////////////////


    ////////////////////////////////////////////////////
    // add free glasses to the shopping cart
    var freeremove = Cookies.getJSON('freeremove'); 
    if (freeremove == undefined || freeremove == "") {
        Cookies.set('freeremove', [], { expires: 365 });  
        freeremove = [];
    }

    var free_glasses_count = Math.floor(cart__free_shipping_quantity / 7);
    if (free_glasses_count > 5) {
        free_glasses_count = 5;
    }
    //free_glasses_count = 0;

    var give_free_glasses = 0;
    if (give_free_glasses == 1) {
        for (var g = 0; g < free_glasses_count; g++) {
            var free_glass_sku = free_glass_list[g];
            //decent_log("free glass: " + free_glass_sku);
            var newitem = {};
            newitem.sku = free_glass_sku;
            newitem.quantity = 1;
            newitem.free = 1;

            if (freeremove.indexOf(newitem.sku) == -1) {
                newcart.push(newitem);
            } else {
                //decent_log("Gift " + newitem.sku + " has been removed");
            }
        }
    }

    if (newcart.length == 0) {
        //Cookies.set('freeremove', [], { expires: 365 });  
        //decent_log("Empty shopping cart")
    }

    var reseller = Cookies.get('reseller'); 

    if (shopping_cart_display_all_products_yes == 1) {
        //var allskus = all_skus().sort((a, b) => (a.retail_price_usd > b.retail_price_usd) ? 1 : -1);
        var allskus = all_skus();
        //allskus.sort((a, b) => (a.retail_price_usd > b.retail_price_usd) ? 1 : -1);

        for (var i = 0, length = allskus.length; i < length; i++) {    
            var sku = allskus[i];
            if (is_sku_in_cart(newcart, sku) == 0) {
                if (sku.search("RESALE") != -1 && reseller != "yes") {
                    continue
                }

                skudata = decent_products[sku];

                if (skudata.url_shop == "factorycafe") {
                    // don't display items that can only be purchased in person
                    continue
                }
                //if (skudata.one_liner.toLowerCase().search("sale") != -1) {
                    //if (skudata.inventory_at_de != undefined && skudata.inv_date != undefined) {
                    // now showing sale items in searches, as of 2-5-22
                        //debugger
                        //continue
                    //}
                //}
                if (skudata.one_liner.toLowerCase().search("discount") != -1) {
                    //continue
                }
                if (skudata.one_liner.toLowerCase().search("refurb") != -1) {
                    // now showing these items in searches, as of 26-6-23
                    //continue
                    //if (skudata.inventory_at_de != undefined) {
                    // now showing sale items in searches, as of 2-5-22
                        //continue
                    //}
                }
                //debugger;
                //if (sku.search("SALE30") != -1 || sku.search("SALE50") != -1 ) {
                    //continue
                //}

                
                
                //if (decent_products[sku].showall_hide == "yes" && is_admin() != 1) {
                    //decent_log("Skipping SKU that is only interesting to tech support: " + sku);
                    //continue
                //}

                //decent_log("SKU: " + sku + " " + sku.search("DE1") + " '" + Cookies.get('decent_admin') + "'");
                
                var item = {};
                item.sku = sku;

                // sort by quantity sold
                var x = decent_products[item.sku];

                if (decent_products[item.sku].showall_hide != "yes") {
                    item.sort = decent_products[item.sku].sold + 100000;
                } else {
                    item.sort = decent_products[item.sku].sold;
                }

                item.quantity = 0;
                newcart.push(item);
            }
        }

        newcart.sort((a, b) => (Number(a.sort) < Number(b.sort)) ? 1 : -1);

        //decent_log("filter: " + filter_get());
        if (filter_get() != "") {
            document.getElementById("shoppingcarttitle").innerHTML = "<div style='margin-top: -40px;margin-bottom: -20px; text-align: right'><input size=" + searchwidth + " title='" + dt("search") + "' id='filter' value='" + filter_value + "' onchange='javascript:shopping_cart_table_update();' name='filter'><div style='display:inline' title='" + dt("search") + "' class='no-print'>&nbsp;<i onclick='javascript:shopping_cart_table_update()' class='fa icon fa-search'></i>&nbsp;&nbsp;<i title='" + dt("show all") + "' onclick='javascript:filter_reset();shopping_cart_display_all_products();shopping_cart_table_update();' class='fa icon fa-cubes'></i>&nbsp;&nbsp;<i title='" + carttitle + "' onclick='javascript:window.location.href=\"/cart\";' class='fa icon fa-shopping-cart'></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<h2><div style='margin-top: -40px;margin-bottom: -20px;'>" + dt("Search") + "</h2></div>";
            //document.getElementById("shoppingcarttitle").innerHTML = "<h2>" + dt("All Decent Espresso Products") + "</h2><input size=20 id='filter' value='" + filter_value + "' onchange='javascript:shopping_cart_table_update();' name='filter'><div style='display:inline' class='no-print'>&nbsp;<i onclick='javascript:shopping_cart_table_update()' class='fa icon fa-search'></i></div><br><br>";
        } else {
