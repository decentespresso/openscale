"DE-DE1PRO220MMV8R3-00569":{	"materials":["food grade stainless steel case", "food grade ceramic water tank and drip tray", "silicone rubber feet", "solid teflon inside tubing", "no BPA plastics."],"customs_price":"500","retail_price_cad":"4169","inv_date":"20260914","discountable":"no","weight":"20500","dimensions_width":"33","sold":"72","hscode_default":"85167100","ship_date":"2026-07-27","voltage":"2","retail_price_aud":"4495","retail_price_usd":"2999","battery_chargeable":"1","ship_weight":"20500","retail_price_gbp":"2235","free_shipping":"no","multi_liner":"[dt {These MASHUP2 machines are brand new and fully warrantied.}]\n\n<br><br>\n[dt {They are offered at a significant discount because they use a unique combination of components from different production versions, including earlier design parts, non-black components, and units with minor cosmetic defects.}]\n\n[dt {Your machine may not exhibit all or even any cosmetic defects.}]\n<a href=\"\/f\/27132\/pro%20example.jpg\">[dt \"Examples of potential cosmetic defects.\"]<\/a>\n\n<br><br>\n[dt {These machines are built and shipped as they are and cannot be customized.}]\n\n<br><br>\n[dt {MASHUP 2 differences:}] \n<a href='\/photos\/DE-DE1PRO220MMV8R2-00567'>[dt {Photos}]<\/a>\n\n<li>[dt {upgraded Samsung Galaxy Tab A11 tablet included.}]\n<a href='\/photos\/DE-TABLETSAMSUNGGALTABA11-30188'>[dt {Photo of tablet.}]<\/a>\n\n<li>[dt {an earlier design for the tablet stand, where 3 screws attach it to the machine.}]\n<a href='\/photos\/DE-XLSTANDBK_R2-00318'>[dt {Photo of tablet stand.}]<\/a>\n<a href='\/photos\/DE-MAIN_COVER_R4-00321'>[dt {Photo of outer case.}]<\/a>\n\n<li>[dt {there are four different front face variations, and your machine may come with any one of the four shown in the photo.}] <a href='\/img\/DE-DE1PRO220MMV8R3-00569-add-01.jpg'>[dt {Photo}]<\/a>\n\n<li>[dt {white drip tray with a central hole, can be used both plumbed in or not.}]\n<a href='\/photos\/DE-DRIPTRAYV2CENHOLEWHITE_R1-73832'>[dt {Photo of drip tray.}]<\/a><\/li>\n\n<li>[dt {drip tray cover is our V4 model and made of steel.}] \n<a href='\/photos\/DE-DRIPTRAYCOVERV4_R1-75201'>[dt {Photo}]<\/a>\n\n<li>[dt {natural wood handles.}] [dt {As this is a natural material, the wood grain between the two handles may not match perfectly.}] \n<a href='\/photos\/DE-PFHANDLENATURALV1GRADEB-30027'>[dt {Photo}]<\/a>\n\n<br><br>\n[dt {Due to the upgraded Samsung Galaxy Tab A11 tablet included with MASHUP 2, the price has increased by approximately 1% compared with the previous MASHUP machines.}]\n\n<br><br>\n[dt {Stock is very limited.}] \n[dt {Machines are available on a first-paid, first-served basis.}]\n[dt {Once payment is received, a machine will be randomly assigned, calibrated for your country's electrical requirements, fully tested, and shipped within 3 working days of ordering.}]","url_shop":"de1pro","retail_price_eur":"2637","inventory_at_de":"100","hscode":"8471410150ES:84198100;VN:85167100;US:8471410150","dimensions_height":"61","retail_price_hkd":"23380","dimensions_length":"50","one_liner":"SALE 19%: DE1PRO black 220V MASHUP2 v1.46","morephotos":"DE-DE1PRO220MMV8R2-00567-add-01.jpg,DE-DE1PRO220MMV8R3-00569-add-01.jpg,DE-DE1PRO220MMV8R2-00567-add-02.jpg,DE-DE1PRO110MMV8-00564-add-03.jpg,mashup_versus.jpg"},
