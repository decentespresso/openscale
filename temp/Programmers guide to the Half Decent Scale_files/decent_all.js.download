function swap20_hrefed_image_radio(divname, varname, imagesrc0, href0, alt0, imagesrc1, href1, alt1, imagesrc2, href2, alt2, imagesrc3, href3, alt3, imagesrc4, href4, alt4, imagesrc5, href5, alt5, imagesrc6, href6, alt6, imagesrc7, href7, alt7, imagesrc8, href8, alt8, imagesrc9, href9, alt9, imagesrc10, href10, alt10, imagesrc11, href11, alt11, imagesrc12, href12, alt12, imagesrc13, href13, alt13, imagesrc14, href14, alt14, imagesrc15, href15, alt15, imagesrc16, href16, alt16, imagesrc17, href17, alt17, imagesrc18, href18, alt18, imagesrc19, href19, alt19, use_white_images) {

    var y = document.getElementsByName(varname);
    var x = getRadioValue(y);

    //decent_log("swap9_hrefed_image_radio: '" + divname + "' '" + varname + "' '" + x + "'");
//debugger
    if (document.getElementById(divname) == undefined) {
        debugger
    }

    //debugger
    //preloadImages(["/" + imagesrc0, "/" + imagesrc1, "/" + imagesrc2, "/" + imagesrc3, "/" + imagesrc4, "/" + imagesrc5, "/" + imagesrc6, "/" + imagesrc7, "/" + imagesrc8, "/" + imagesrc9]);

    var href, alt, imgsrc;

    if (x == 0) {
        href = href0; alt = alt0; imagesrc = imagesrc0;
    } else if (x == 1) {
        href = href1; alt = alt1; imagesrc = imagesrc1;
    } else if (x == 2) {
        href = href2; alt = alt2; imagesrc = imagesrc2;
    } else if (x == 3) {
        href = href3; alt = alt3; imagesrc = imagesrc3;
    } else if (x == 4) {
        href = href4; alt = alt4; imagesrc = imagesrc4;
    } else if (x == 5) {
        href = href5; alt = alt5; imagesrc = imagesrc5;
    } else if (x == 6) {
        href = href6; alt = alt6; imagesrc = imagesrc6;
    } else if (x == 7) {
        href = href7; alt = alt7; imagesrc = imagesrc7;
    } else if (x == 8) {
        href = href8; alt = alt8; imagesrc = imagesrc8;
    } else if (x == 9) {
        href = href9; alt = alt9; imagesrc = imagesrc9;
    } else if (x == 10) {
        href = href10; alt = alt10; imagesrc = imagesrc10;
    } else if (x == 11) {
        href = href11; alt = alt11; imagesrc = imagesrc11;
    } else if (x == 12) {
        href = href12; alt = alt12; imagesrc = imagesrc12;
    } else if (x == 13) {
        href = href13; alt = alt13; imagesrc = imagesrc13;
    } else if (x == 14) {
        href = href14; alt = alt14; imagesrc = imagesrc14;
    } else if (x == 15) {
        href = href15; alt = alt15; imagesrc = imagesrc15;
    } else if (x == 16) {
        href = href16; alt = alt16; imagesrc = imagesrc16;
    } else if (x == 17) {
        href = href17; alt = alt17; imagesrc = imagesrc17;
    } else if (x == 18) {
        href = href18; alt = alt18; imagesrc = imagesrc18;
    } else if (x == 19) {
        href = href19; alt = alt19; imagesrc = imagesrc19;
    } else if (x == 20) {
        href = href20; alt = alt20; imagesrc = imagesrc20;
    }

    var html = '';

    var skudata = decent_products[alt];
    if (skudata != undefined) {

        var altx = dt(skudata.one_liner);

        imagesrc = "/img/small/" + alt + "_880x568.avif";

        if (divname.includes("_white") == true) {
            imagesrc = "/img/small/" + alt + "_880x568.avif";
        }

        if (skudata.url_photo != undefined) {
            debugger
            var photo = skudata.url_photo.replace(/\.jpg/, "_880x568.avif");
            imagesrc = "/img/small/" + skudata.url_photo + "_880x568.avif";
        } else if (skudata.url_photo_white != undefined) {
            //var photo = skudata.url_photo_white.replace(/\.jpg/, "-grey_880x568.jpg");
            var photo = skudata.url_photo_white.replace(/\.jpg/, "_1760x1136.jpg");
            imagesrc = "/img/small/" + photo;
        }


        if (skudata.url_shop != undefined) {
            href = "/" + skudata.url_shop
        }

        html = product_img_html(href, altx, imagesrc);

        if (divname.includes("_white") != true) {
            // Multi-photo SKUs get a < / > carousel; single-photo cards unchanged.
            var carousel = product_carousel_html(alt, altx, dimgloc + imagesrc, skudata.morephotos);
            if (carousel != "") {
                html = carousel;
            }
        }

    } else {
        html = product_img_html(href, alt, imagesrc);
    }

    document.getElementById(divname).innerHTML = html;

}


