// ---------------------------------------------------------------------------
// Shop-card photo carousel (client-side).
// product_carousel_html builds the image slot for a "BUY a sku" card: the main
// product photo (a click-through link to /photos/<sku>) with < / > chevrons that
// swap through the SKU's other photos in place. Only still-image morephotos are
// included; non-main photos load on demand (their src is fetched only when the
// shopper navigates to them). Mirrors the server-side product_card_carousel in
// lib/images.tcl. dcNav() does the in-place swap; dcInjectCarouselCss() adds the
// (one-time) stylesheet.
// ---------------------------------------------------------------------------
function dcInjectCarouselCss() {
    if (document.getElementById('dc-carousel-css')) { return; }
    var s = document.createElement('style');
    s.id = 'dc-carousel-css';
    s.innerHTML =
        ".dc-carousel{position:relative}" +
        ".dc-frame{position:relative;width:100%;height:0;padding-top:64.55%;overflow:hidden;background:#fff}" +
        // two overlapping layers (active + incoming) that slide one step per click,
        // so last->first loops seamlessly with no long rewind.
        ".dc-slide-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:contain;transition:transform .35s ease;will-change:transform}" +
        // translucent white glyph + soft dark shadow: subtle over white (only the
        // faint shadow shows), clearly visible over dark photos.
        ".dc-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;font-size:42px;line-height:1;color:rgba(255,255,255,.95)!important;text-shadow:0 1px 3px rgba(0,0,0,.55);cursor:pointer;padding:6px 12px;text-decoration:none;font-weight:300;user-select:none;-webkit-tap-highlight-color:transparent;transition:opacity .2s ease}" +
        ".dc-arrow:hover{color:rgba(255,255,255,.6)!important}" +
        // fade out the opposite chevron while hovering one of them
        ".dc-carousel:has(.dc-next:hover) .dc-prev,.dc-carousel:has(.dc-prev:hover) .dc-next{opacity:0}" +
        ".dc-prev{left:0}.dc-next{right:0}" +
        "@media print{.dc-arrow{display:none}}";
    document.head.appendChild(s);
}

// Preload the two neighbours of photo i so the next slide is instant.
function dcPreload(imgs, i) {
    var n = imgs.length;
    var want = [(i + 1) % n, (i - 1 + n) % n];
    for (var q = 0; q < want.length; q++) { var im = new Image(); im.src = imgs[want[q]]; }
}

function dcNav(el, dir) {
    var c = el.parentNode;
    while (c && !(c.className && ('' + c.className).indexOf('dc-carousel') > -1)) { c = c.parentNode; }
    if (!c) { return false; }
    var raw = (c.getAttribute('data-dc-imgs') || '').split('|');
    var imgs = [];
    for (var k = 0; k < raw.length; k++) { if (raw[k]) { imgs.push(raw[k]); } }
    if (imgs.length < 2) { return false; }
    var oldI = parseInt(c.getAttribute('data-dc-idx') || '0', 10);
    if (isNaN(oldI)) { oldI = 0; }
    var i = (oldI + dir + imgs.length) % imgs.length;

    var layers = c.getElementsByClassName('dc-slide-img');
    var activeName = c.getAttribute('data-dc-active') || 'a';
    var active = (activeName === 'a') ? layers[0] : layers[1];
    var incoming = (activeName === 'a') ? layers[1] : layers[0];

    // place the incoming layer just off the side we're travelling from, load it,
    // then (next frame) slide active out and incoming in.
    incoming.src = imgs[i];
    incoming.style.transition = 'none';
    incoming.style.transform = 'translateX(' + (dir > 0 ? 100 : -100) + '%)';
    void incoming.offsetHeight;
    incoming.style.transition = '';
    requestAnimationFrame(function () {
        active.style.transform = 'translateX(' + (dir > 0 ? -100 : 100) + '%)';
        incoming.style.transform = 'translateX(0)';
    });

    c.setAttribute('data-dc-active', activeName === 'a' ? 'b' : 'a');
    c.setAttribute('data-dc-idx', i);
    dcPreload(imgs, i);
    return false;
}

// mainFull = fully-qualified URL of the resized main photo (dimgloc already applied)
// morephotos = raw comma-separated list from decent_products[sku].morephotos
// Returns "" when the SKU has only one photo, so single-photo cards are left
// exactly as they were (no arrows, no layout change).
function product_carousel_html(sku, alt, mainFull, morephotos) {
    var imgs = [mainFull];
    if (morephotos != undefined && morephotos != "") {
        var parts = ('' + morephotos).split(",");
        for (var k = 0; k < parts.length; k++) {
            var photo = parts[k].replace(/^\s+|\s+$/g, "");
            if (photo == "") { continue; }
            // still images only — skips youtube ids and PDFs
            if (!/\.(jpe?g|png|avif|webp|gif)$/i.test(photo)) { continue; }
            imgs.push(dimgloc + "/img/" + photo);
        }
    }
    if (imgs.length < 2) { return ""; }
    dcInjectCarouselCss();
    // Two layers: dc-a shows the main photo; dc-b is the staging layer (starts
    // off-screen right, no src). dcNav swaps between them one step at a time.
    var frame = "<div class='dc-frame'>" +
        "<img class='dc-slide-img dc-a' alt='" + alt + "' title='" + alt + "' src='" + imgs[0] + "'>" +
        "<img class='dc-slide-img dc-b' alt='" + alt + "' title='" + alt + "' style='transform:translateX(100%)'>" +
        "</div>";
    var arrows =
        "<a href='javascript:void(0)' class='dc-arrow dc-prev' onclick='return dcNav(this,-1)' aria-label='Previous photo'>&#10094;</a>" +
        "<a href='javascript:void(0)' class='dc-arrow dc-next' onclick='return dcNav(this,1)' aria-label='Next photo'>&#10095;</a>";
    return "<div class='dc-carousel' data-dc-idx='0' data-dc-active='a' data-dc-imgs='" + imgs.join("|") + "'>" +
        "<a class='dc-slide' style='border:0 none;display:block' href='/photos/" + sku + "'>" + frame + "</a>" +
        arrows + "</div>";
}

