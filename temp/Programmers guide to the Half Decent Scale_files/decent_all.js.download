// Show, in small text under PAY NOW, which payment methods are available for the
// shopping country/currency. Reuses the Tcl checkout logic via the server
// (/support/api/paymethods) so the cart and the checkout page never diverge.
// Fetched once per country and cached; re-applied on every cart re-render.
window.paymethods_cache = window.paymethods_cache || {};
// Cache key must include the currency: the shipping country alone is not enough,
// since the user can pay in a currency other than the country's default (e.g.
// ship to HK but pay in CAD) and that changes which methods are available.
function paymethods_key() {
    var c = (typeof my_country !== "undefined" && my_country) ? my_country.toUpperCase() : "";
    var cur = (typeof my_currency === "function") ? (my_currency() || "").toUpperCase() : "";
    return c + "|" + cur;
}
function update_paymethods_blurb() {
    if (typeof my_country === "undefined" || !my_country) return;
    var c = my_country.toUpperCase();
    var cur = (typeof my_currency === "function") ? (my_currency() || "") : "";
    var key = paymethods_key();
    function apply(el, text) {
        if (!el) return;
        el.innerHTML = text;
        el.style.display = text ? "" : "none";   // hide entirely when card is the only method
    }
    var el = document.getElementById("paymethods_blurb");
    if (window.paymethods_cache[key] !== undefined) {
        apply(el, window.paymethods_cache[key]);
        return;
    }
    $.get("/support/api/paymethods.adp", { country: c, currency: cur }, function (data) {
        window.paymethods_cache[key] = (data || "").trim();
        apply(document.getElementById("paymethods_blurb"), window.paymethods_cache[key]);
    });
}

function shopping_cart_total_quantity_count (newcart) {
    if (newcart == undefined) {
        return 0
    }
    var total_quantity = 0;
    for (var i = 0, length = newcart.length; i < length; i++) {
        if (newcart[i] == undefined) {
            decent_log("(shopping_cart_total_quantity_count) No item in cart for item #: " + i);
            continue
        }

        total_quantity += newcart[i].quantity;
    }
    return total_quantity;
}


function shopping_cart_not_discountable_count (newcart) {
    if (newcart == undefined) {
        return 0
    }
    
    var total_quantity = 0;
    for (var i = 0, length = newcart.length; i < length; i++) {
        if (newcart[i] == undefined) {
            decent_log("(shopping_cart_not_shippable_count) No item in cart for item #: " + i);
            continue
        }

        var sku = newcart[i].sku
        var skudata = decent_products[sku];
        if (skudata == undefined) {
            continue
        }


        if (typeof skudata.discountable == undefined) {
            skudata.discountable = "yes";
        }



        if (skudata.discountable == "no") {
            total_quantity += newcart[i].quantity;
            //decent_log("Not shipping for: " + newcart[i].sku);
            continue
        }

        //if (newcart[i].replaces == undefined) {
            // consider replacements as non shippable items
        //    total_quantity += newcart[i].quantity;
            //decent_log("Not shipping for: " + newcart[i].sku);
        //    continue
        //}

    }
    //decent_log("Not discountable quantity:: " + total_quantity);
    return total_quantity;
}


function shopping_cart_not_shippable_count (newcart) {
    if (newcart == undefined) {
        return 0
    }
    
    var total_quantity = 0;
    for (var i = 0, length = newcart.length; i < length; i++) {
        if (newcart[i] == undefined) {
            decent_log("(shopping_cart_not_shippable_count) No item in cart for item #: " + i);
            continue
        }

        var sku = newcart[i].sku
        var skudata = decent_products[sku];
        if (skudata == undefined) {
            continue
        }

        if (skudata.shippable == "no") {
            total_quantity += newcart[i].quantity;
            //decent_log("Not shipping for: " + newcart[i].sku);
            continue
        }

        if (newcart[i].replaces != undefined) {
            // consider replacements as non shippable items
            total_quantity += newcart[i].quantity;
            //decent_log("Not shipping for: " + newcart[i].sku);
            continue
        }

    }
    return total_quantity;
}


function shopping_cart_not_free_shipping_count (newcart) {
    if (newcart == undefined) {
        return 0
    }
    var total_quantity = 0;
    for (var i = 0, length = newcart.length; i < length; i++) {
        if (newcart[i] == undefined) {
            decent_log("(shopping_cart_not_free_shipping_count) No item in cart for item #: " + i);
            continue
        }

        var skudata = decent_products[newcart[i].sku];
        if (skudata == undefined) {
            continue
        }

        if (skudata.free_shipping != "no") {
            //decent_log("Free shipping for: " + newcart[i].sku + " " + skudata.free_shipping);
            continue
        } else {
            //decent_log("NO free shipping for: " + newcart[i].sku + " " + skudata.free_shipping);
        }
        total_quantity += newcart[i].quantity;
    }
    return total_quantity;
}

function shopping_cart_free_shipping_item_count_from_cookie () {
    var free_shipping_count = (shopping_cart_total_quantity_count(Cookies.getJSON('cart')) - shopping_cart_not_free_shipping_count(Cookies.getJSON('cart')) - shopping_cart_not_shippable_count(Cookies.getJSON('cart')));
    //decent_log("Free shipping count: " + free_shipping_count);
    return free_shipping_count;
}

// incorrect function, is deducting not-discountable from free_Shipping, but these are different things
function shopping_cart_free_shipping_item_count_from_cookie2 () {
    var free_shipping_count = (shopping_cart_total_quantity_count(Cookies.getJSON('cart')) - shopping_cart_not_free_shipping_count(Cookies.getJSON('cart')) - shopping_cart_not_discountable_count(Cookies.getJSON('cart')) - shopping_cart_not_shippable_count(Cookies.getJSON('cart')));
    //decent_log("Free shipping count: " + free_shipping_count);
    return free_shipping_count;
}


function shopping_cart_total_quantity_count_from_cookie () {
    return shopping_cart_total_quantity_count(Cookies.getJSON('cart'));
}

function shopping_cart_quantity_count_of_sku (newcart, sku) {
    if (newcart == undefined) {
        return 0;
    }

    var total_quantity = 0;
    for (var i = 0, length = newcart.length; i < length; i++) {
        if (newcart[i] == undefined) {
            decent_log ("Shopping cart has undefined part" + i);
            continue
        }
        if (newcart[i].sku == undefined) {
            decent_log ("1. Shopping cart has undefined sku for part" + i);
            continue
        }
        if (newcart[i].sku == sku) {
            return newcart[i].quantity;
        }
    }
    return 0;
}

function shopping_cart_replacement_quantity_count_of_sku (newcart, sku) {
    if (newcart == undefined) {
        return 0;
    }

    var total_quantity = 0;
    for (var i = 0, length = newcart.length; i < length; i++) {
        if (newcart[i] == undefined) {
            decent_log ("Shopping cart has undefined part" + i);
            continue
        }
        if (newcart[i].sku == undefined) {
            decent_log ("2. Shopping cart has undefined sku for part" + i);
            continue
        }

        if (newcart[i].sku == sku && newcart[i].replaces != undefined) {
            return newcart[i].quantity;
        }
    }
    return 0;
}

function sku_is_being_replaced (newcart, sku) {
    if (newcart == undefined) {
        return 0;
    }

    var total_quantity = 0;
    for (var i = 0, length = newcart.length; i < length; i++) {
        if (newcart[i] == undefined) {
            decent_log ("Shopping cart has undefined part" + i);
            continue
        }
        if (newcart[i].replaces == undefined) {
            // this occurs if the current choice to replace is the same as the sku itself, hence no replacement (or undoing replacement)
            // decent_log ("3. Shopping cart has undefined sku for part" + i + " " + sku);
            continue
        }
        if (newcart[i].replaces == sku) {
            return 1;
        }
    }
    return 0;
}


function get_free_glass_list () {

    decent_log("get_free_glass_list called");

    // determine what their free glass will be and store it in a cookie so that they don't get different free glasses by emptying their cart or reloading the page
    // the free glass cookie will get emptied when they check out, so they get a different randomized set of glasses next time
    var free_glass_list = Cookies.getJSON('free_glass_list'); 
    if (free_glass_list == undefined || free_glass_list.length == 0) {
        free_glass_list = shuffle_array(["DE-U3GLASSQ1-00076", "DE-Y3GLASSQ1-00081"]);
        // "DE-U2GLASSQ1-00075" "DE-Y1GLASSQ1-00079", "DE-V1GLASSQ1-00078", "DE-Y2GLASSQ1-00080", "DE-U4GLASSQ1-00077", 
        // "DE-U1GLASSQ1-00074", 
        Cookies.set('free_glass_list', free_glass_list, { expires: 365 });
    }
    return free_glass_list;
}

function shoppingcart_remove_free_item (sku) {
    var freeremove = Cookies.getJSON('freeremove'); 
    if (freeremove == undefined) {
        freeremove = [];
    }
    //decent_log("Removed " + sku + " from free gifts");
    freeremove.push(sku);
    Cookies.set('freeremove', sort_array_unique(freeremove), { expires: 365 });  
}




