function getRadioValueByName(name) {
    return getRadioValue(document.getElementsByName(name));
}

function getRadioValue(radioButton) {

    chosen = "";
    len = radioButton.length;

    for (i = 0; i < len; i++) {
        if (radioButton[i].checked) {
            chosen = radioButton[i].value;
            return chosen;
        }
    }
    return "";
}

