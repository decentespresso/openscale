// Empties the shopping cart + coupon and goes to /cart. Called from the nav menu
// "Empty your cart" item (adminui toolbar 10263708425) so that item is a clean
// javascript:decentEmptyCart() call instead of a wall of inline JS.
function decentEmptyCart () {
    Cookies.set('cart', '[]', { expires: 365 });
    Cookies.set('coupon', '', { expires: 365 });
    location.assign(location.origin + '/cart');
}


function currency_to_symbol (currency) {
    var symbol = "USD\$";

    if (my_country == "US") {
        symbol = "\$";
    }

    if (currency == "GBP") { 
        symbol = "&pound;";
    } else if (currency == "CAD") { 
        symbol = "C\$";
    } else if (currency == "HKD") { 
        symbol = "HK\$";
    } else if (currency == "AUD") { 
        symbol = "A\$";
    } else if (currency == "EUR") { 
        symbol = "&euro;";
    }
    return symbol;
}

function convert_number_from_hkd_to_curency(number, currency) {
    var multiplier = hkd_to_currency_divisor(currency);
    var val = +number / multiplier;
    return two_decimal_places(val);
}

function hkd_to_currency_divisor (currency) {
    var symbol = "0";
    if (currency == "GBP") { 
        symbol = "9.70966";
    } else if (currency == "CAD") { 
        symbol = "5.78673";
    } else if (currency == "USD") { 
        symbol = "7.75625";
    } else if (currency == "AUD") { 
        symbol = "5.95292";
    } else if (currency == "EUR") { 
        symbol = "8.63821";
    } else if (currency == "HKD") { 
        symbol = "1.0";
    }

    return symbol;
}


function flat_rate_shipping () {

    var expedited = Cookies.get('expedited'); 
    
    //decent_log("couuntry :'" + my_country + "'");
    if (my_country == "CA") {
        // canada postal strike
        if (canada_post_on_strike == 1) {
            expedited = 1;
            Cookies.set('expedited', expedited, { expires: 365 });  
        }
    }




    var currency = my_currency();
    //var val = 10;
    var quantity = shopping_cart_free_shipping_item_count_from_cookie();

    if (quantity == 0) {
        // if you're only buying not-free-shipping items, then don't add more for shipping
        // return 0;
    }

    // not expedited shipping
    if (quantity >= 3) {
        val = 0;
    } else {
        val = 10; // USD
        if (currency == "GBP") { val = 10 }
        if (currency == "CAD") { val = 15 }
        if (currency == "HKD") { val = 100 }
        if (currency == "AUD") { val = 25 }
        if (currency == "EUR") { val = 15 }

    }

    if (expedited == 1) {
        val = 30; // USD

        if (is_expensive_courier_shipping_country(my_country) == 1) {
            val = 55; // USD
        }
        

        if (currency == "EUR") { val = 30 }
        if (currency == "CAD") { val = 75 }
        if (currency == "USD" && my_country == "US") { 
            val = 30
        }


        if (currency == "GBP") { val = 30 }
        if (currency == "CAD") { val = 50 }
        if (currency == "HKD") { val = 250 }
        if (currency == "AUD") { val = 50 }
        if (currency == "EUR") { val = 30 }
    }

    // as of april 1 2023, free accessory shipping in HK
    if (my_country == "HK") { val = 0 }

    return val;
}

function country_to_currency (country) {

    var currency = "";
    if (country == "UK") {
        currency = "GBP";
    } else if (country == "AU") {
        currency = "AUD";
    } else if (country == "US"
        || country == "AE"
        || country == "JO"
        || country == "EG"
        || country == "KW"
        || country == "BH"
        || country == "QA"
        || country == "JP"
        || country == "SA"
        || country == "IQ"
        || country == "OM"
        ) {
        currency = "USD";
    } else if (country == "CA") {
        currency = "CAD";
    } else if (country == "BE" 
        || country == "BG"
        || country == "CZ"
        || country == "DE"
        || country == "MC"
        || country == "CH"
        || country == "DK"
        || country == "GR"
        || country == "EE"
        || country == "IE"
        || country == "ES"
        || country == "FR"
        || country == "IT"
        || country == "CY"
        || country == "LV"
        || country == "LT"
        || country == "LU"
        || country == "HU"
        || country == "MT"
        || country == "NL"
        || country == "NO"
        || country == "AT"
        || country == "PL"
        || country == "PT"
        || country == "RO"
        || country == "SI"
        || country == "SE"
        || country == "SK"
        || country == "FI"
        || country == "PL" 
        || country == "AL" 
        || country == "AD" 
        || country == "AM" 
        || country == "AZ" 
        || country == "BY" 
        || country == "BA" 
        || country == "HR"
        || country == "FO" 
        || country == "GE" 
        || country == "GI" 
        || country == "GL" 
        || country == "VA"
        || country == "IS" 
        || country == "KS" 
        || country == "LI" 
        || country == "MK"
        || country == "MD" 
        || country == "MN"  
        || country == "SJ"  
        || country == "RU" 
        || country == "SM" 
        || country == "CS" 
        || country == "RS" 
        || country == "TR" 
        || country == "UA" 
        ) {
        currency = "EUR";
    } else {
        currency = "";
    }

    return currency;
}

function html_dropdow_with_current_selection (fieldname, currentvalue, choices, onchange, inwidth) {

	var selectedname = '';
    var width = "";
    if (inwidth != undefined) {
        width = "width: " + inwidth;
    }
    //debugger
    
    var html = "<span style='width: auto' class=\"no-print xselect-wrapper\"><select style=\"" + width + "\" onchange=\"javascript:" + onchange + "\" name=\"" + fieldname + "\" id=\"" + fieldname + "\">";
    for (var i = 0, length = choices.length; i < length; i++) {
        var checked = "";
        var thisvalue = choices[i];
        i++;
        var thisname = choices[i];
        if (thisvalue == currentvalue) {
            checked = "SELECTED"
            selectedname = thisname;
        }

        html += "<option " + checked + " value=\"" + thisvalue + "\"'>" + thisname + "</option>";
    }

    html += "</select></span><span class='print-only'>" + selectedname + "</span>";
    return html;
}

function currency_to_description (currency)  {
    var description = "";
    if (currency == "EUR") {
        description = dt("Euros");
    } else if (currency == "GBP") {
        description = dt("British Pounds");
    } else if (currency == "HKD") {
        description = dt("Hong Kong Dollars");
    } else if (currency == "AUD") {
        description = dt("Australian Dollars");
    } else if (currency == "CAD") {
        description = dt("Canadian Dollars");
    } else {
        description = dt("US Dollars");
    }
    return description;
}


function show_current_currency_dropdown () {
    var current_currency_id = document.getElementById("current_currency");
    current_currency_id.innerHTML = current_currency_dropdown();;
}

function current_currency_dropdown (inwidth) {

    var choices = ["USD", "EUR", "GBP", "CAD", "AUD", "HKD" ];

    var single_currency = country_to_currency(my_country);
    if (single_currency != "") {
        choices = [ single_currency ];
        Cookies.set('currency', single_currency, { expires: 365 });  
    }

    if (my_country == "CN") {
        choices = [ "USD", "HKD" ];
        var single_currency_cookie = Cookies.get('currency'); 
        if (single_currency_cookie != "USD" && single_currency_cookie != "HKD") {
            single_currency = "USD"
            Cookies.set('currency', single_currency, { expires: 365 });  
        }

    }

    var choiceskv = [];
    for (var i = 0, length = choices.length; i < length; i++) {
        choiceskv.push(choices[i]);
        choiceskv.push(currency_to_description(choices[i]));
    }

    var html = html_dropdow_with_current_selection ("currency", my_currency(), choiceskv, "update_currency_choice()", inwidth);
    return "<span style=\"display:inline\" xclass=\"no-print\">" + html + "</span>";
}

function current_expedited_dropdown () {

    var expedited = Cookies.get('expedited'); 

    var choiceskv = [];
    var note = "";
    var quantity = shopping_cart_free_shipping_item_count_from_cookie();

    if (free_shipping_disabled != 1) { 
        choiceskv.push(0);
        if (my_country == "HK") { 

            // as of april 1 2023, free accessory shipping in HK
            choiceskv.push(dt("Free shipping:"));

        } else if (quantity >= 3) {
            choiceskv.push(dt("Free shipping:"));
        } else {
            if (is_expedited_only_accessories_country(my_country) == 1) {
                choiceskv.push(dt("Inexpensive shipping is not available to your country"));
            } else {
                choiceskv.push(dt("Normal shipping:"));
            }
            if (expedited == 0) {
                note = "<div class='no-print'>" + dt("(free shipping when you buy 3 accessories)") +"<br></div>";
            }
        }
        
    }

    if (country_without_expedited_shipping(my_country) != 1) {
        
        choiceskv.push(1);

        if (quantity >= 3) {
            choiceskv.push(dt("Expedited shipping:"));
        } else {
            choiceskv.push(dt("Expedited shipping:"));

            // if this is the only choice, then set the cookie for it
            if (free_shipping_disabled == 1) { 
                Cookies.set('expedited', 1, { expires: 365 });  
            }

        }
    } else {
        // if expedited is not permitted, make sure the expedited cookie is 0 and hard set expedited off
        Cookies.set('expedited', 0, { expires: 365 });  
        expedited = 0;
    }

    var html = html_dropdow_with_current_selection ("expedited", expedited, choiceskv, "update_expedited_choice()", "auto");


    if (my_country == "CA") {
        if (canada_post_on_strike == 1) {
            html += "<font style='background-color: yellow;'>" + dt("Free shipping is not available to Canada due to the postal strike.") + "</font><br>";
        }
    }

    return "<div style=\"display:inline\" class=\"small\">" + html + "</div>" + note;
}
function update_currency_choice () {
    var selected = document.getElementById("currency").value;
    Cookies.set('currency', selected, { expires: 365 });  
    //shopping_cart_table_update();
    window.location.reload(false); 
}

function update_expedited_choice () {
    var selected = document.getElementById("expedited").value;
    Cookies.set('expedited', selected, { expires: 365 });  
    shopping_cart_table_update();
}


function remove_from_shopping_cart (sku, quantity) {
    var cart = Cookies.getJSON('cart'); 

    if (cart == undefined) {
        decent_log("empty cart");
        return
    } 

    var newcart = [];
    var found = false;
    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];
        if (item.sku == sku && item.quantity > 0) {
            //debugger;
            item.quantity -= quantity;
            found = true;
        }

        if (item.quantity < 0) {
            item.quantity = 0
            found = false
            //found = true;
        }

        if (item.quantity != 0) {
            newcart.push(item);
        }
    }

    //if (found == false)  {
        //newcart.push(item);
    //}

    // If the espresso machine just left the cart, its bundled accessory "spots"
    // (DE-SPOT4*) and the upgrades that replace them are now orphaned -- an upgrade
    // is meaningless with no machine to grant the spot. The "-" button cascaded
    // these (via remove_replacements_from_shopping_cart), but the auto-prune paths
    // that call this function directly for an unknown/hidden/tampered SKU did NOT,
    // so an auto-pruned DE1 left the customized accessories behind (orphaned
    // machine-customizations with no machine, e.g. cart 106889). Cascade here so
    // EVERY machine-removal path is covered.
    if (sku_is_espresso_machine(sku) == 1) {
        var still_has_machine = false;
        for (var m = 0; m < newcart.length; m++) {
            if (newcart[m].quantity > 0 && sku_is_espresso_machine(newcart[m].sku) == 1) {
                still_has_machine = true;
                break;
            }
        }
        if (still_has_machine == false) {
            var kept = [];
            for (var r = 0; r < newcart.length; r++) {
                if (newcart[r].replaces != undefined) { continue; }
                kept.push(newcart[r]);
            }
            newcart = kept;
        }
    }

    newcart.sort(sku_compare);
    var result = JSON.stringify(newcart);

    //decent_log("new cart: " + result);
    
    Cookies.set('cart', result, { expires: 365 });
}


// removes any items that are replacing this sku
function remove_replacements_from_shopping_cart (sku) {

    var cart = Cookies.getJSON('cart'); 

    if (cart == undefined) {
        decent_log("empty cart");
        return
    } 

    var newcart = [];
    var found = false;
    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];

        if (sku == "*") {
            // wildcard sku removes all replacements
            if (item.replaces != undefined) {
                item.quantity = 0
            }
        } else if (item.replaces == sku && item.quantity > 0) {

            item.quantity = 0
        }

        if (item.quantity != 0) {
            newcart.push(item);
        }
    }

    newcart.sort(sku_compare);
    var result = JSON.stringify(newcart);

    //decent_log("new cart: " + result);
    
    Cookies.set('cart', result, { expires: 365 });
}

// global variable to indicate to that this is not a pasted URL but a button press to change quantity
var shoppingcart_quantity_changed = 0;
function shoppingcart_quantity_minus (sku) {
    // we clear the URL temporarily of parameters so that it doesn't look like we've pasted a new cart URL into the browser
    shoppingcart_quantity_changed = 1;
    ///ChangeUrl("Cart", "cart");

    remove_from_shopping_cart (sku, 1);

    // if there are any replacements associated with this item, remove them too 
    
    if (sku_is_espresso_machine(sku) == 1) {
        remove_replacements_from_shopping_cart("*")
    }

    update_shopping_cart_menu(1);
    shopping_cart_table_update();
}

function shoppingcart_quantity_plus (sku) {

    // we clear the URL temporarily of parameters so that it doesn't look like we've pasted a new cart URL into the browser
    //ChangeUrl("Cart", "cart");
    shoppingcart_quantity_changed = 1;

    add_to_shopping_cart (sku, 1);
    update_shopping_cart_menu(1);
    shopping_cart_table_update();
}

function add_to_shopping_cart (sku, quantity, replaces) {
    //decent_log("add_to_shopping_cart: " + sku + ":" + quantity + "x");

    if (quantity < 0) {
        decent_log("disallowing negative quantity '" + quantity + "' of " + sku);
        quantity= Math.abs(quantity);
    }

    var cart = Cookies.getJSON('cart'); 
    if (cart == undefined) {
        cart = [];
    }

    var item = {};
    item.quantity = quantity;
    item.sku = sku;

    if (replaces != undefined) {
        
        item.sku = replaces;
        item.replaces = sku;

    }

    item.time = seconds_since_epoch();
//    item.price = sku_to_price(sku);
    //cart.push(item);
    cart = add_item_to_cart (cart, item);
    var cart_json = JSON.stringify(cart);
    Cookies.set('cart', cart_json, { expires: 365 });

    update_shopping_cart_menu(1);

    //decent_log("new cart: " + cart_json);
    return shopping_cart_quantity_count_of_sku (cart, sku);
}

function update_shopping_cart_menu (force_display) {
    force_display = 1;
    cartmenu_ensure_style();
    var cartlength = shopping_cart_item_count();
    if (cartlength == 0 && force_display == 0) {
        cart_menu_html = "";
    } else {
        if (cartlength == 0) {
            // Re-rendered on every cart change, including emptying the cart --
            // no <ul>, so any previously-shown submenu is wiped.
            cart_menu_html = "<a href=\"/cart\" class=\"icon fa-shopping-cart\">" + dt("Cart") + "</a>";
        } else {
            // On the cart page itself the hover mini-cart just duplicates the
            // full cart table below it, so show the Cart link + count without
            // the dropdown submenu. (/c adds to cart then 302s to /cart, but
            // guard it too in case it is ever landed on directly.)
            var cart_path = window.location.pathname;
            var on_cart_page = (cart_path == "/cart" || cart_path == "/cart/" || cart_path == "/c" || cart_path == "/c/");
            cart_menu_html = "<a href=\"/cart\" class=\"icon fa-shopping-cart\">" + dt("Cart") + " (" + nt(cartlength.toString()) + ")</a>" + (on_cart_page ? "" : cartmenu_submenu_html());
        }
    }
    var cartmenu_id = document.getElementById("cartmenu");
    if (cartmenu_id != undefined) {
        cartmenu_id.innerHTML = cart_menu_html;
    }

    var cart_count = document.querySelector(".gi-cart-count");
    if (cart_count != undefined) {
        cart_count.innerHTML = nt(cartlength.toString());
    }

}

// Builds the hover submenu listing each cart line: product name + quantity.
// Iterates the 'cart' cookie ({sku, quantity} entries); name = dt(one_liner)
// from decent_products, falling back to the raw SKU if the product is unknown.
// Each row links to the product's shop page (or /cart). Returns "" when the cart
// is effectively empty so the caller shows no submenu.
//
// IMPORTANT: this is a <div>, NOT a <ul>. jquery.dropotron (js/init.js) grabs
// every <ul> inside #nav at page load and *detaches* it to <body> to run as its
// own hover menu. If the cart submenu were a <ul>, dropotron would move it out,
// then keep showing that stale detached copy after the cart changes (the "old
// cart flashes when moving off Cart" bug). dropotron ignores non-<ul> elements,
// so a <div> stays put inside #cartmenu, always reflects the current cart, and
// is styled by cartmenu_ensure_style to look identical to the Info pulldown.
function cartmenu_submenu_html () {
    var cart = Cookies.getJSON('cart');
    if (cart == undefined) { return ""; }
    var rows = "";
    for (var i = 0, length = cart.length; i < length; i++) {
        var item = cart[i];
        if (item == undefined || item.quantity == undefined || item.quantity <= 0) { continue; }
        var skudata = decent_products[item.sku];
        var name = (skudata != undefined && skudata.one_liner != undefined) ? dt(skudata.one_liner) : item.sku;
        var href = (skudata != undefined && skudata.url_shop != undefined && skudata.url_shop != "") ? ("/" + skudata.url_shop) : "/cart";
        var sku_js = ("" + item.sku).replace(/\\/g, "\\\\").replace(/'/g, "\\'");
        rows += "<div class=\"cartmenu-row\">"
             +  "<a class=\"cartmenu-name\" href=\"" + href + "\">" + name + "</a>"
             +  "<span class=\"cartmenu-controls\">"
             +    "<span class=\"cartmenu-qty\">&times;&nbsp;" + nt(item.quantity.toString()) + "</span>"
             +    "<i class=\"icon fa-minus-circle cartmenu-btn\" title=\"" + dt("one fewer") + "\" onclick=\"return cartmenu_adjust('" + sku_js + "', -1)\"></i>"
             +    "<i class=\"icon fa-plus-circle cartmenu-btn\" title=\"" + dt("one more") + "\" onclick=\"return cartmenu_adjust('" + sku_js + "', 1)\"></i>"
             +  "</span>"
             +  "</div>";
    }
    if (rows == "") { return ""; }
    return "<div class=\"cartmenu-sub\">" + rows + "</div>";
}

// +/- handlers for the cart dropdown rows. Reuses the same cart mutators the
// /cart page uses (add_to_shopping_cart / remove_from_shopping_cart), then
// re-renders the dropdown. shopping_cart_table_update() is only called when the
// /cart table is on the page -- it dereferences #shoppingtable with no null
// guard and would throw on every other page. Returns false to swallow the click.
function cartmenu_adjust (sku, delta) {
    if (delta > 0) {
        add_to_shopping_cart(sku, 1);
    } else {
        remove_from_shopping_cart(sku, 1);
        if (sku_is_espresso_machine(sku) == 1) {
            remove_replacements_from_shopping_cart("*");
        }
    }
    update_shopping_cart_menu(1);
    if (document.getElementById("shoppingtable") != undefined) {
        shopping_cart_table_update();
    }
    return false;
}

// One-time <style> for the cart hover submenu. Replicates the site's .dropotron
// look (white rounded box, up-caret, row separators, teal #47cdd9 hover -- values
// copied from css/style.css) so the cart menu is visually identical to the Info
// pulldown, but as a self-contained <div> menu that dropotron never touches (see
// cartmenu_submenu_html). Visibility is a pure-CSS :hover toggle.
function cartmenu_ensure_style () {
    if (document.getElementById("cartmenu-style") != undefined) { return; }
    var head = document.head || document.getElementsByTagName("head")[0];
    if (head == undefined) { return; }
    var css =
        "#cartmenu { position: relative; }" +
        "#cartmenu .cartmenu-sub {" +
        " display: none; position: absolute; right: 0; top: 100%; margin-top: 1em;" +
        " z-index: 10000; min-width: 10em; padding: 0.75em 0;" +
        " background: #fff; border-radius: 0.5em;" +
        " box-shadow: 0 0 3px 1px rgba(0,0,0,0.05);" +
        " font-size: 0.9em; text-align: left; text-transform: none; color: #444; }" +
        "#cartmenu:hover .cartmenu-sub { display: block; }" +
        // transparent bridge spanning the 1em gap between the Cart item and the
        // menu box, so moving the mouse down onto the items keeps #cartmenu:hover
        // (a pure-CSS menu has no hover-delay like dropotron's, so without this
        // the menu closes the instant the cursor enters the gap).
        "#cartmenu .cartmenu-sub:after {" +
        " content: ''; position: absolute; left: 0; right: 0; top: -1em; height: 1em; }" +
        // the up-pointing caret, matching .dropotron.level-0:before
        "#cartmenu .cartmenu-sub:before {" +
        " content: ''; display: block; position: absolute; right: 1.5em;" +
        " top: -0.375em; width: 0.75em; height: 0.75em; background: #fff;" +
        " transform: rotate(45deg); box-shadow: -1px -1px 2px 0 rgba(0,0,0,0.05); }" +
        // each row: matches .dropotron li a, name left / quantity + buttons right
        "#cartmenu .cartmenu-sub .cartmenu-row {" +
        " display: flex; align-items: center; justify-content: space-between;" +
        " white-space: nowrap; line-height: 2.25em; padding: 0 1em; color: inherit;" +
        " border: 0; box-shadow: inset 0 1px 0 0 rgba(144,144,144,0.2); transition: none; }" +
        "#cartmenu .cartmenu-sub .cartmenu-row:first-child { box-shadow: none; }" +
        "#cartmenu .cartmenu-sub .cartmenu-row:hover { background: #47cdd9; }" +
        // #fff needs !important on every part: the site's nav "a:hover" rule sets
        // link colour to teal !important, which would otherwise make the text
        // teal-on-teal (invisible) on hover. dropotron uses !important likewise.
        "#cartmenu .cartmenu-sub .cartmenu-row:hover," +
        " #cartmenu .cartmenu-sub .cartmenu-row:hover .cartmenu-name," +
        " #cartmenu .cartmenu-sub .cartmenu-row:hover .cartmenu-qty," +
        " #cartmenu .cartmenu-sub .cartmenu-row:hover .cartmenu-btn { color: #fff !important; }" +
        "#cartmenu .cartmenu-sub .cartmenu-name {" +
        " color: inherit; text-decoration: none; }" +
        "#cartmenu .cartmenu-sub .cartmenu-controls {" +
        " display: inline-flex; align-items: center; padding-left: 1.5em; }" +
        "#cartmenu .cartmenu-sub .cartmenu-qty { opacity: 0.55; margin-right: 0.7em; }" +
        "#cartmenu .cartmenu-sub .cartmenu-btn {" +
        " color: #bbb; cursor: pointer; margin-left: 0.45em; font-size: 1.1em; }" +
        "#cartmenu .cartmenu-sub .cartmenu-btn:hover { opacity: 0.75; }";
    var style = document.createElement("style");
    style.id = "cartmenu-style";
    style.type = "text/css";
    style.appendChild(document.createTextNode(css));
    head.appendChild(style);
}

function set_price_string(id, sku, firstpart) {

    var price = sku_to_price(sku);

    var cartmenu_id = document.getElementById(id);
    if (cartmenu_id != undefined) {
        if (firstpart != undefined) {
            cartmenu_id.innerHTML = firstpart + my_currency_price(price);
        } else {
            cartmenu_id.innerHTML = my_currency_price(price);
        }
    }

}

function sku_to_price(sku, customizations) {

    var skudata = decent_products[sku];
    if (skudata == undefined) {
        decent_log("Undefined SKU: '" + sku + "'");
        add_error_msg_to_title("<li>" + "No information for SKU: " + sku + "<br><br>");
        return;
    }
    var price_name = "retail_price_"+my_currency().toLowerCase();
    var usd_price_name = "retail_price_usd";
    var price = skudata[price_name]
    if (price == undefined) {
         price = skudata[usd_price_name]
    }

    var customizations_cost = 0;
    if (customizations != null) {

        var urlget_skus = array_kv_keys(customizations.split('+'));
        var urlget_quantities = array_kv_vals(customizations.split('+'));
        var urlget_quantity = array_sum(urlget_quantities);
        
        for (var i = 0, length = urlget_skus.length; i < length; i++) {

            var getskunum = urlget_skus[i];

            var getreplaces = ""
            var getquantity = urlget_quantities[i];
            if (getquantity < 0) {
                // replacements are indicated with a negative quantity which is actually the replacement sku
                var replaces = getquantity.substring(1);
                getquantity = 1
                getreplaces = convert_skunum_to_sku(replaces);
            }

            var getsku = convert_skunum_to_sku(getskunum);

            if (getsku != "") {

                var item2 = {};                    
                item2.sku = getsku;
                item2.quantity = +getquantity;

                if (getreplaces != "") {

                    
                    //  a customization
                    item2.replaces = getreplaces;
                    

                    var skudata_replacement = decent_products[item2.sku];
                    var skudata_replaces = decent_products[item2.replaces];
                    
                    var price_replacement = skudata_replacement[price_name]
                    var price_replaces = skudata_replaces[price_name]

                    var delta = price_replacement - price_replaces;
                    if (delta < 0) {
                        delta = 0;
                    }
                    customizations_cost += delta;

                } else {
                    //  not a customization
                    add_to_shopping_cart(item2.sku, item2.quantity);
                }
            }
        }

        price = (1 * price) + (1 * customizations_cost);
    }    

    

    if ( Math.floor(price) != price) {
        // if the price has something in the decimal point then display that with two digits 
        // otherwise don't display anything there
        price = two_decimal_places(price);
    }

    return price;
}

function my_currency_price (price_string) {

    //decent_log("currency: " + my_currency());

    if (my_currency() == "EUR") {
        return price_string + " " + my_currency_symbol();
    }

    return my_currency_symbol() + "" + price_string;
}

