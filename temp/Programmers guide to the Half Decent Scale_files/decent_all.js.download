function show_customize_v2() {


    var cart = Cookies.getJSON('cart'); 
    //var admin_cookie = Cookies.get('decent_admin');
    var is_v144 = document.getElementById('sku').value.search('V6')
    var is_v145 = document.getElementById('sku').value.search('V7')
    var is_v146 = document.getElementById('sku').value.search('V8')
    
    if ((is_v144 != -1 || is_v145 != -1  || is_v146 != -1 ) && customize_enabled() == 1) {
        if (cart_has_de1_how_many(cart) > 1 || cart_has_which_de1(cart) == "") {
            // can't customize DE1 if ordering more than 1 at a time, as that is too complicated for the system
            change_class_to_display_none('customize_de1')

        } else {

            var sku = document.getElementById('sku').value
            var customize_de1_url = "<a class='button no-print small' href='customize_de1?sku=" + cart_has_which_de1(cart) + "' style='background-color: #AAAAAA; color: blue; vertical-align:middle'><font color='#FFFFFF'>" + dt("Customize your DE1") + "</font></a><br><br>";
            document.getElementById('customize_de1').innerHTML = customize_de1_url
            change_class_to_display_inline('customize_de1')
        }
    }
}   


function calc_sku_v2() {

    var model = getRadioValueByName('model');
    var color = getRadioValueByName('color');

    if (model == "") {
        model = "de1pro"
    }

    if (color == "") {
        color = "black"
    }

    if (model == "bengle") {
        if (color != "wood" && color != "silver" && color != "gold") {
            color = "wood"
        }
    } else {
        // DE1 models
        if (color != "black" && color != "white" && color != "transparent") {
            color = "black"
        }
    }

    var voltage = getRadioValueByName('voltage');
    var video = "";

    change_class_to_display_inline('black');
