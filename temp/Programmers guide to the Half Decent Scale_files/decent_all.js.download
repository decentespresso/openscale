String.prototype.toIndiaDigits= function(){
 var id= ['&#x660;','&#x661;','&#x662;','&#x663;','&#x664;','&#x665;','&#x666;','&#x667;','&#x668;','&#x669;'];
 return this.replace(/[0-9]/g, function(w){
  return id[+w]
 });
}

function NumbertoArabic(enDigit) { // PERSIAN, ARABIC, URDO
    if (typeof enDigit === "number") {
        return String(enDigit).toIndiaDigits();
    }

    return enDigit.toIndiaDigits();
}

function replaceRange(s, start, end, substitute) {
    return s.substring(0, start) + substitute + s.substring(end);
}

function quotify(textarea_name) // javascript
{
    var txtarea = document.getElementById(textarea_name);
    var sel = txtarea.value.substring(txtarea.selectionStart, txtarea.selectionEnd);
    if (sel == "") {
        txtarea.value = "<quote>" + txtarea.value + "</quote>";
    } else {
        txtarea.value = replaceRange(txtarea.value, txtarea.selectionStart, txtarea.selectionEnd, "<quote>" + sel.trim() + "</quote>");
    }
}

function seconds_since_epoch() { 
    return Math.floor( Date.now() / 1000 ) 
}

function is_admin() {
    // used to hide some items on the shopping cart that aren't interesting to normal users, only interesting as parts for tech support ordering for customers
    var c = Cookies.get('decent_admin');
    if (c == "" || c == undefined) {
        return 0
    }
    return 1
}

function days_between_dates (date1, date2) {

    // To calculate the time difference of two dates 
    var Difference_In_Time = (date1 - date2); 

    // To calculate the no. of days between two dates 
    var Difference_In_Days = Math.ceil(Difference_In_Time / (1000 * 3600 * 24)); 

    return Difference_In_Days;
}

function weeks_between_dates (date1, date2) {

    // To calculate the time difference of two dates 
    var Difference_In_Time = (date1 - date2); 

    // To calculate the no. of days between two dates 
    var Difference_In_Days = Math.ceil(Difference_In_Time / (1000 * 3600 * 24 * 7)); 

    return Difference_In_Days;
}

function js_to_make_support_table_wider (tablename, verywide) {


    var w = 80
    var l = 10
    var r = 10

    if (verywide == 1) {
        w = 99
        l = 0
        r = 1
    }

    var main_table_id = document.getElementById(tablename);
    main_table_id.style["width"] = w + "%";
    main_table_id.style["margin-left"] = l + "%";
    main_table_id.style["margin-right"] = r + "%";
    main_table_id.style["padding"] = ".1em .1em;";
    main_table_id.style["line-height"] = " 160%";
}

function preloadImages(array) {
    if (!preloadImages.list) {
        preloadImages.list = [];
    }
    var list = preloadImages.list;
    for (var i = 0; i < array.length; i++) {
        var img = new Image();
        img.onload = function() {
            var index = list.indexOf(this);
            if (index !== -1) {
                // remove image from the array once it's loaded
                // for memory consumption reasons
                list.splice(index, 1);
            }
        }
        list.push(img);
        img.src = array[i];
    }
}
var free_shipping_disabled = 1;
function my_currency () {
    // currenct is either set in a cookie or defaults from geolocated country
    var c = Cookies.get('currency'); 

    var single_currency = country_to_currency(my_country);
    if (single_currency != "" && c != single_currency) {
        //decent_log("restricting currency to: " + single_currency + " country: " + my_country);
        my_currency_name = single_currency
        Cookies.set('currency', single_currency, { expires: 365 });  
    }

    if (c == undefined || c == "") {
        c = my_currency_name;
        Cookies.set('currency', c, { expires: 365 });  
    }

    //decent_log("currency: " + c + " country: " + my_country);
    return c;
}

function my_currency_symbol () {
    return currency_to_symbol(my_currency());
}

