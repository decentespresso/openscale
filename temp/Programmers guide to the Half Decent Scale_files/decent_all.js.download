                //additional_text = additional_text + "<br>+ " + dt("Shipping2 cost:") + " " + my_currency_price(nt(convert_number_from_hkd_to_curency(+remaining_cost, my_currency()))) + " " + my_currency_price(nt(convert_number_from_hkd_to_curency(+remaining_cost, my_currency())));;
                //additional_text = additional_text + "<br>+ " + dt("VAT and import tax for") + " " + dt(countries[my_country]) + ": " + my_currency_symbol() + tax + " (" + two_decimal_places(tax_percent) + "%)";
                //additional_text = additional_text + "<br>+ " + dt("Tax for") + " " + dt(countries[my_country]) + ": " + my_currency_price(nt(tax));

