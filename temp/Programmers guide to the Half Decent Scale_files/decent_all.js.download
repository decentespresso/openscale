                // now showing these items in searches, as of 26-6-23
                //skip_this = 1
            }
            if (skudata.one_liner.toLowerCase().search("refurb") != -1) {
                // now showing these items in searches, as of 26-6-23
                //skip_this = 1
            }
            //debugger;

            //decent_log("checking filter '" + filter_value + "' against one_liner '" + skudata.one_liner.toLowerCase() + "'");
        }
        if (skip_this == 0) {
            tablehtml += "<tr style=\"page-break-inside: avoid;background-color: rgba(0,0,0, 0);\"><td width=" + col1 + "% align=left >" + product_image  + "<div class='extrabr' style='display:" + extrabrdisplay + "'>" + br_before_product + "</div>" + product_html  + replaces_comment + specifications_html+ ship_warning_html + inventory_warning_html + amazon_html  + customize_de1_url  + "</td>" + quantity_area_html + "<td  width=" + col4 + "% align=middle ><div class='extrabr' style='display:" + extrabrdisplay + "'><br><br></div>" + my_currency_price(nt(price)) + printonly  + "</td></tr>";
        }

        //if (skudata.free_shipping == "economiq" && economiq_countries.indexOf(my_country) == -1) {
            //skudata.free_shipping = "no";
        //}

        if (skudata.free_shipping == "no") {
            if (typeof easyship_rates == 'undefined') {
                tablehtml += "<tr style=\"page-break-inside: avoid;background-color: rgba(0,0,0, 0);\"><td width=" + col1 + "% align=left ><br>" + dt("Please <A href='/support/submit'>contact us</a> to arrange for shipping this item to your country.") + "<div class='extrabr' style='display:" + extrabrdisplay + "'></div>" + "</td>" + "<td  width=" + col4 + "% align=middle ><div class='extrabr' style='display:" +  "'><br><br></div>" + "</td></tr>";
                continue
            }
            var rates_for_this_sku = easyship_rates[item.sku];
            
            var lowest_shipping_rate = 9999999;
            var cheapest_shipper = "";
            var choiceskv = [];

            // determine if there are shippers available besides HK Post
            var has_shippers_besides_hk_post = 0;
            for (var shipper in rates_for_this_sku) {
                if (shipper.search("HK") == -1) {
                    has_shippers_besides_hk_post = 1;
                    break;
                }
            }



            if (is_admin() == 11) {
                for (var shipper in rates_for_this_sku) {
                    if (shipper.search("UPS Worldwide Saver") != -1) {

                        var new_total_charge = 0;
                        var new_tax_charge = 0;

                        if (my_country == "US") {
                            new_total_charge = 1299;
                        } else if (my_country == "UK") {
                            new_total_charge = 2161;
                            new_tax_charge = 1178;
                        } else if (my_country == "FR") {
                            new_total_charge = 2160;
                            new_tax_charge = 984;
                        } else if (my_country == "CA") {
                            new_total_charge = 2521;
                            new_tax_charge = 1445;
                        } else if (my_country == "KR") {
                            new_total_charge = 1240;
                            new_tax_charge = 864;
                        }

                        if (new_total_charge != 0) {
                            var mine = 'UPS Discounted Rate for Decent Espresso';
                            rates_for_this_sku[mine] = rates_for_this_sku[shipper];
                            rates_for_this_sku[mine]['total_charge'] = new_total_charge;

                            rates_for_this_sku[mine]['import_tax_charge'] = new_tax_charge;
                            rates_for_this_sku[mine]['ddp_handling_fee'] = 0;
                            rates_for_this_sku[mine]['import_duty_charge'] = 0;

                            delete rates_for_this_sku[shipper];    
                        }
                    }       
                }       
            }

            var skip_hk_post_if_better_is_available = 1;
            for (var shipper in rates_for_this_sku) {
                //decent_log("Shipper: " + shipper);
                if (shipper.search("HK") != -1 && has_shippers_besides_hk_post == 1) {
                    // skip HK post if other shippers are available
                    
                    if (skip_hk_post_if_better_is_available == 1) {
                        //decent_log("Not showing shipping choice '" + shipper + "' because there are better options available");
                        continue
                    }
                }



                if (shipper.search("FedEx") != -1 && shipper.search("Economy") != -1) {
                    // skip Fedex economy because not actually available due to cargo limits                    
                    // decent_log("Removed FedEx Econonomy choice because not actually available due to cargo limits");
                    continue
                }

                if ((shipper.search("TNT") != -1 || shipper.search("Fedex") != -1) && my_country == "CN") {
                    // do not use TNT or Fedex in China
                    decent_log("Removed TNT/Fedex choice in China, because they are not reliable. Customs clearance is very bad.");
                    continue
                }

                var shipment_costs = easyship_rates[item.sku][shipper];
                if (+shipment_costs['total_charge'] < lowest_shipping_rate) {
                    lowest_shipping_rate = +shipment_costs['total_charge'];
                    cheapest_shipper = shipper;
                }


            }

            for (var shipper in rates_for_this_sku) {
                
                //decent_log("Shipper : '" + shipper.trim() + "'");
                var shipment_costs = easyship_rates[item.sku][shipper];
                if (shipper == cheapest_shipper) {
                    choiceskv.push(shipper);
                    choiceskv.push(dt("We ship via:") + " " + dt(shipper.trim()) + " : " + my_currency_price(nt(convert_number_from_hkd_to_curency(+shipment_costs['total_charge'], my_currency()))));
                    
                    var selected_shipper = Cookies.get('selected_shipper'); 
                    if (selected_shipper != "own" && selected_shipper != "pickup" && selected_shipper != "ss") {
                        Cookies.set('selected_shipper', shipper, { expires: -1 });
                    }


    //Cookies.set('shipping_fees', "", { expires: -1 });
    //Cookies.set('shipping_taxes', "", { expires: -1 });

                    //debugger
                } else {
                    choiceskv.push("");
                    choiceskv.push("- " + dt("Compare to:") + " " + dt(shipper.trim()) + " : " + my_currency_price(nt(convert_number_from_hkd_to_curency(+shipment_costs['total_charge'], my_currency()))));
                }
            }

            Cookies.set('cheapest_shipper', cheapest_shipper, { expires: 365 });
            set_shipper_to_cheapest_if_unset();
            var selected_shipper = Cookies.get('selected_shipper'); 

            // var selected_shipper = Cookies.get('selected_shipper'); 
