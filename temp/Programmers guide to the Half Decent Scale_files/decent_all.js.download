            aftermsg = dt("In stock");
            //aftermsg2 = "<a href='https://public.3.basecamp.com/p/VeRe4qUdjZ7cGrLp9mLusafK'>" + dt("See available machines") + "</a>";
            aftermsg2 = "";

            ship_warning_html = "<br>&nbsp;<br><i style=\"font-size: " + title_sub_font_size + ";color:#666666\" class=\"shipdate icon fa-check-circle-o\">&nbsp;" + aftermsg + "</i><br><br>" + aftermsg2;
        }

	} else if (skudata.maxquantity != undefined) {
        aftermsg = "<font size=1>(" + skudata.maxquantity + " " + dt("in stock") + ")</font>";
        ship_warning_html = "<br>&nbsp;" + aftermsg;

        // as of 13-2-2025 no longer displaying inventory
        ship_warning_html = "";


    } else if (skudata.inventory_qb != undefined) {
        if (skudata.inventory_qb > 0) {
            aftermsg = "<font size=1>(" + nt(skudata.inventory_qb) + "&nbsp;" + dt("in stock") + ")</font>";
            ship_warning_html = "<br>&nbsp;" + aftermsg;

            // as of 13-2-2025 no longer displaying inventory
            ship_warning_html = "";
            
        }
    } else {
        aftermsg = "<font size=1>(" + dt("In stock") + ")</font>";
        ship_warning_html = "<br>&nbsp;" + aftermsg;

        // no need to say 'in stock' as we now have a reputation for being in stock
        ship_warning_html = "";
    }

    var customizations_js = ""
    if (customizations != null) {
        customizations_js = ", '" + customizations + "'";
    }

    var toreturn = "<div class='print-only'>" + dt("Price:") + " " + my_currency_price(price_string) + "</div><div id=\"buy_" + sku + "\" style='display:inline'><a onclick=\"javascript:buy_button_do('" + sku + "'" + customizations_js + ")\" class=\"button no-print icon " + fontawesomeicon + "\">" + txt + "</a></li>" + ship_warning_html + "</div>"

		//decent_log("quantity: '" + quantity + "' for max: '" + skudata.maxquantity + "'");
	if (skudata.maxquantity != undefined &&  quantity >= skudata.maxquantity) {
        toreturn = "<div class='print-only'>" + dt("You've bought all of them") + "</div><div id=\"buy_" + sku + "\" style='display:inline'><a href='cart' class=\"button no-print icon fa-times-circle\">" + dt("No more") + " (" + my_currency_price(price_string) + ")</a></li></div>"
    } else if (decent_products[sku].our_store_status == "discontinued") {
        // john as of 8/1/17 we no longer include discontinued items
        toreturn = "<div class='print-only'>" + dt("NOT AVAILABLE") + "</div><div id=\"buy_" + sku + "\" style='display:inline'><a onclick=\"javascript:void('')\" class=\"button no-print icon fa-times-circle\">" + dt("NOT AVAILABLE") + " (" + my_currency_price(price_string) + ")</a></li></div>"
    }

    return toreturn;
}

function price_replaces(sku, replacedby) {
    var price1 = sku_to_price(sku);
    var price2 = sku_to_price(replacedby);


    var price = (price2 - price1).toFixed(2);
    var price_int = (price2 - price1).toFixed(0);

    if ((price * 100).toFixed(0) == (price_int * 100).toFixed(0)) {
        price = price_int
    }

    if (price <= 0) {
        price = 0
    }

    return price
}

