                //decent_log("Missing SKU: "+item.sku);
                continue
            }
        }


        var quantity = item.quantity;
        if (quantity == undefined) {
            decent_log("corrupt shopping cart");
            Cookies.set('cart', [], { expires: 365 });
            continue;
        } else if (item.quantity < 0) {
            // only happens if someone tampered with the URL
            remove_from_shopping_cart (item.sku, item.quantity)
