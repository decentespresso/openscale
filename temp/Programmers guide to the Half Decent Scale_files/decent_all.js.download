        document.getElementById('de1_model').innerHTML = dt(skudata.one_liner) + "<br><font color='#999999'>" + dt("customization:") + " " + dt(color) + "</font>";
    } else {
        document.getElementById('de1_model').innerHTML = dt(skudata.one_liner);
    }

    var sale_html = "";
    if (voltage == "110") {
        if (sale_voltage.search("110") != -1) {
            sale_html = "<br><a class='button small' href='/de1_sale'>" + dt("Discounted 110V machines") + "</a>";
        }
    } else {
        if (sale_voltage.search("220") != -1) {
            sale_html = "<br><a class='button small' href='/de1_sale'>" + dt("Discounted 220V machines") + "</a>";
        }
    }

    document.getElementById('sale_available').innerHTML = sale_html;

    if (model != "") {
        document.getElementById(color).value = color;
        document.getElementById(model).value = model;

        document.getElementById(color).checked = true;
        document.getElementById(model).checked = true;
    } else {

    }



}


// detects asynchronously whether youtube is accessible
//window.YT = {loading:0,loaded:0};
//var tag = document.createElement('script');
//tag.src = "https://www.youtube.com/iframe_api";
//var firstScriptTag = document.getElementsByTagName('script')[0];
//firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

function ytembed (url, mp4, bilibili, avif) {

    if (typeof avif !== 'undefined') {
        
        var div1 = "<div style='overflow:hidden; padding-bottom:56.25%; position:relative; height:0;'>"
        var div2 = "</div>"

        var isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
        var ext = ".avif"
        if (isSafari == 1) {
            ext = ".mp4"
        }

        
        var embedded = div1 + "<a href='" + dimgloc + "/img/" + avif + ext + "''><img src='" + dimgloc + "/img/" + avif + ext + "' loading='lazy' width=100% height='auto'></a>" + div2;
        return embedded

    }

    //decent_log("YT: " + JSON.stringify(window.YT));

    if (window.YT) {
        var div1 = "<div style='overflow:hidden; padding-bottom:56.25%; position:relative; height:0;'>"
        var div2 = "</div>"
        
        var embedded = div1 + "<iframe style='left:0; top:0; height:100%; width:100%; position:absolute;' src=\"https://www.youtube.com/embed/" + url + "?version=3&vq=hd1080&autoplay=1&loop=1&rel=0&controls=1&playlist=" + url + "\" xwidth=\"560\" xheight=\"315\" title=\"DE1XL black v1.44 360º\" frameborder=\"0\" allowfullscreen></iframe>" + div2
        return embedded
    } else if (bilibili != undefined) {
        var div1 = "<div style='overflow:hidden; padding-bottom:56.25%; padding-right:100%; position:relative; height:0;'>"
        var div2 = "</div>"
                
        var embedded = div1 + "<iframe src='" + bilibili + "'  style='height:100%; width:100%; position:absolute; ' scrolling='no' border='0' frameborder='no' framespacing='0' allowfullscreen='true'> </iframe>" + div2;
        return embedded
    } else if (mp4 != undefined) {
        var div1 = "<div style='overflow:hidden; padding-bottom:56.25%; position:relative; height:0;'>"
        var div2 = "</div>"
        
        var embedded = div1 + "<video loading='lazy' width=100% height='auto' id='video_' controls=true preload='metadata' ><source src='" + dimgloc + "/img/" + mp4 + "' type='video/mp4'></video>" + div2;
        return embedded
    } else {
        return ""
    }
}

