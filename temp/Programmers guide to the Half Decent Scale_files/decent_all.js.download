    if (skudata == undefined) {
        decent_log(sku + " unavailable");
        debugger;
        return
    }
    //document.getElementById('more_info').innerHTML = "";
    document.getElementById('sku').value = sku;
    document.getElementById('de1_video').innerHTML = video;

