        } else {
            txt = "undo replacement"
            fontawesomeicon = "fa-undo"
            var toreturn = "<div class='print-only'>" + txt + " " + my_currency_price(price_string) + "</div><div id=\"buy_" + replacedby + "\" style='display:inline'><a onclick=\"javascript:replace_button_do('" + sku + "','" + replacedby + "','" + button_key +"')\" class=\"button no-print icon " + fontawesomeicon + "\">" + txt + "</a></li>" + ship_warning_html + "</div>"
            setTimeout(function () { replace_button_do( sku, replacedby, button_key); }, 100);
        }
        
    } else if (replaces_quantity >= 1) {
        txt = dt("Replacement saved") + " : " + my_currency_price(price_string);

        var toreturn = "<div class='print-only'>" + txt + " " + my_currency_price(price_string) + "</div><div id=\"buy_" + replacedby + "\" style='display:inline'><a xonclick=\"javascript:void()\" style='background-color: #c5ffb7; box-shadow: 0px 0px;' class=\"button no-print icon " + fontawesomeicon + "\">" + txt + "</a></li>" + ship_warning_html + "</div>"
    } else {

        var toreturn = "<div class='print-only'>" + txt + " " + my_currency_price(price_string) + "</div><div id=\"buy_" + replacedby + "\" style='display:inline'><a style='background-color: #FFCCCC; box-shadow: 0px 0px;' onclick=\"javascript:replace_button_do('" + sku + "','" + replacedby + "','" + button_key +"')\" class=\"button no-print icon " + fontawesomeicon + "\">" + txt + "</a></li>" + ship_warning_html + "</div>"
        setTimeout(function () { replace_button_do( sku, replacedby, button_key); }, 100);
    }


        //decent_log("quantity: '" + quantity + "' for max: '" + skudata.maxquantity + "'");
    if (skudata.maxquantity != undefined &&  quantity >= skudata.maxquantity) {
