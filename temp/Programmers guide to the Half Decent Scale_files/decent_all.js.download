        tablehtml += "</td><td width=" + col4 + "%  align=middle ><nobr>" + my_currency_price(nt(flat_rate_shipping()));
        tablehtml += "</nobr></td></tr>";

        running_total = +running_total + +flat_rate_shipping();
    }

    if (force_expedited == true && Cookies.get('expedited') != 1) {
        Cookies.set('expedited', 1, { expires: 365 });  
        window.location.reload(false); 
    }
    

    if (shopping_cart_item_count() > 0) {

        if (is_accessory_duty_paid_country(my_country) == 1) {
            if (de1_is_ddp_to_usa == 0 || quantity_of_de1 == 0) {
                // dt("You will have to pay US customs duty (tax) to the courier when receiving this delivery.")
                tablehtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right>";
                //tablehtml += "<a href='https://decentespresso.com/blog/trumps_tariffs_impact_on_your_decent_espresso_purchase'>" + dt("Trump's tariffs impact on your Decent Espresso purchase.") + "</a> <br>" + "<font style='background-color: yellow;'>" + dt("We will attempt to pay the import duty for you. However, you might have to pay US customs duty (tax) to the courier when receiving this delivery, depending on the judgement of the customs officer.") + "</font>";
                var expedited = Cookies.get('expedited'); 
                if (expedited == 1) {
                    tablehtml += "<font style='background-color: yellow;'>" + dt("With expedited shipping, you will need to pay any import taxes to the courier.") + "</font>";
                } else {
                    if (my_country == "US") { 
                        tablehtml += "<a href='https://decentespresso.com/blog/trumps_tariffs_impact_on_your_decent_espresso_purchase'>" + dt("Trump's tariffs impact on your Decent Espresso purchase.") + "</a> <br>" + "<font style='background-color: yellow;'>" + dt("We pay the import tariff for you.  This is the price, delivered to your door.") + "</font>";
                    } else {
                        tablehtml += "<font style='background-color: yellow;'>" + dt("We pay the import tariff for you.  This is the price, delivered to your door.") + "</font>";
                    }

                }
                tablehtml += "</nobr></td></tr>";
            }
        }
    }


    //decent_log("quantity: " + total_quantity);
    var discounthtml = "";
    if (cart_has_accessories(cart) == 1) {
        if (discountable_quantity >= 80) {
            var discount = two_decimal_places(+discountable_total * +0.30);
            running_total = +running_total - +discount;
            discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("30% discount:") +  " (" + discountable_quantity.toString() + " " + dt("discountable items") + ")"  + "</i></td><td align=middle >" + "-&nbsp;" + my_currency_price(nt(discount)) + "</td></tr>";
        } else if (discountable_quantity >= 40) {
            var discount = two_decimal_places(+discountable_total * +0.25);
            running_total = +running_total - +discount;
            discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("25% discount:") + " (" + discountable_quantity.toString() + " " + dt("discountable items") + ")" +  "<br> " + dt("(get a 30% discount at 80+ accessories)") + "</i></td><td align=middle ><nobr>" + "-&nbsp;" + my_currency_price(nt(discount)) + "</nobr></td></tr>";
        } else if (discountable_quantity >= 20) {
            var discount = two_decimal_places(+discountable_total * +0.20);
            running_total = +running_total - +discount;
            discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("20% discount:") + " (" + discountable_quantity.toString() + " " + dt("discountable items") + ")" + "<br> " + dt("(get a 25% discount at 40+ accessories)") + "</i></td><td  align=middle ><nobr>" + "-&nbsp;" + my_currency_price(nt(discount)) + "</nobr></td></tr>";
        } else if (discountable_quantity >= 10) {
            var discount = two_decimal_places(+discountable_total * +0.15);
            running_total = +running_total - +discount;
            discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("15% discount:")  + " (" + discountable_quantity.toString() + " " + dt("discountable items") + ")" +  "<br> " + dt("(get a 20% discount at 20+ accessories)") + "</i></td><td  align=middle ><nobr>" + "-&nbsp;" + my_currency_price(nt(discount)) + "</nobr></td></tr>";
        } else if (discountable_quantity >= 5) {
            var discount = two_decimal_places(+discountable_total * +0.10);
            running_total = +running_total - +discount;
            discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("10% discount:") + " (" + discountable_quantity.toString() + " " + dt("discountable items") + ")" +  "<br> " + dt("(get a 15% discount at 10+ accessories)") + "</i></td><td  align=middle ><nobr>" + "-&nbsp;" + my_currency_price(nt(discount)) + "</nobr></td></tr>";
        } else {
            //discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 class='no-print' align=right><i>" + dt("Get a 10% discount when you buy 5 accessories") + "</i></td><td align=middle ><nobr>" + "- " + my_currency_price(nt(0)) + "</nobr></td></tr>";
        }

    }

    //decent_log("Discount" + discounthtml);

    if (my_country == "obs-CA") {
        decent_log("Canada, so shipping expedited");
        //discounthtml += "<br>" + dt("Due to COVID, there is no postal service to Canada.  Expedited shipping is the only option.");
        discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("There is no postal service to Canada from Hong Kong.  Expedited shipping is the only option.") + "</i></td></tr>";
        Cookies.set('expedited', 1, { expires: 365 });  
    } else if (my_country == "obs-US") {
        decent_log("USA, so shipping expedited");
        //discounthtml += "<br>" + dt("Due to COVID, there is no postal service to Canada.  Expedited shipping is the only option.");
        discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("There is no low cost postal service to the USA from Hong Kong.") + "<br>" + dt("Expedited shipping (i.e. UPS/FEDEX) is unfortunately the only way we can send packages to you, until this changes.") + "</i></td></tr>";
//        Cookies.set('expedited', 1, { expires: 365 });  

        if (Cookies.get('expedited') != 1) {
            Cookies.set('expedited', 1, { expires: 365 });  
            window.location.reload(false); 
        }

    } else if (my_country == "obs-DK" || my_country == "obs-MY" || my_country == "obs-IE" || my_country == "obs-IT" || my_country == "obs-BN" || my_country == "obs-SI") {
        decent_log("no postal service to this country " + my_country + ", so shipping expedited");
        //discounthtml += "<br>" + dt("Due to COVID, there is no postal service to Canada.  Expedited shipping is the only option.");
        discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("There is no postal service between Hong Kong and your country.") + "<br>" + dt("Expedited shipping (i.e. UPS/FEDEX) is unfortunately the only way we can send packages to you, until this changes.") + "</i></td></tr>";
        Cookies.set('expedited', 1, { expires: 365 });  
    } else {

        // all free shipping temporarily disabled
        if (free_shipping_disabled == 1 && cart_has_accessories(cart) == 1) {
            decent_log("no postal service to " + my_country + ", so shipping expedited");
            //discounthtml += "<br>" + dt("Due to COVID, there is no postal service to Canada.  Expedited shipping is the only option.");
            discounthtml += "<tr style=\"background-color: rgba(0,0,0, 0);\"><td width=" + (col1 + col2 + col3) + "% colspan=2 align=right><i>" + dt("There is no postal service between Hong Kong and your country.") + "<br>" + dt("Expedited shipping (i.e. UPS/FEDEX) is unfortunately the only way we can send packages to you, until this changes.") + "</i></td></tr>";

            if (Cookies.get('expedited') != 1) {
                Cookies.set('expedited', 1, { expires: 365 });  
                window.location.reload(false); 
            }

          }
    }

    tablehtml += discounthtml; 

    if (showall != "all") {
        //////////////////
        // change the URL to be able to share this cart via just the URL
        var new_url = "c" + shopping_cart_url_version(newcart, freeremove);
        //var new_url = "cart" + shopping_cart_url_version(newcart, freeremove);

        var reload = getUrlVars()['reload'];
        if (reload != undefined) {
            new_url += "&reload=" + reload;
        }


        ChangeUrl(dt("Decent Espresso Shopping Cart"), new_url);
        //decent_log("changed url to: " + new_url);
        var self_url_id = document.getElementById("selfurl");
        self_url_id.innerHTML = "<a href='https://decentespresso.com/" + new_url + "'>https://decentespresso.com/" + new_url + "</a>";
        //////////////////
    }

    var pay_now_button = "";
    var paynowanyway = ""

    if (running_total > 0) {
        pay_now_button += "<div class='no-print'>";
        if (no_direct_shipping == 1) {
            pay_now_button += "<a xhref='/support/checkout' class=\"button special big icon fa-sign-out\"><div style=\"display:inline\" class=\"no-print\">" + dt("We do not ship directly to") + " " + dt(countries[my_country.toUpperCase()]) + ". " + " </div>" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</a></li>";
        } else if (quantity_of_de1 > 1) {
            pay_now_button += "<h3 style='background-color:FFCCCC'>" + dt("For easier customs clearance, please buy only one machine at a time.") + "</h3>" + paynowanyway + "</li>";

        } else if (quantity_of_de1 == 1 && cart_has_accessories(cart) == 1) {
            //  && my_country != "US"
            pay_now_button += "<h3 style='background-color:FFCCCC'>" + dt("For easier customs clearance, please buy accessories separately from your espresso machine.") + "</h3>" + paynowanyway + "</li>";
        } else if ((shop_and_ship_available == 0 && ushops_available == 0 && myus_available == 0 && tiptrans_available == 0)) {

            paynowanyway = "<h3><div style=\"display:inline\" class=\"no-print\">" + dt("total") + " : </div>" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</h3>"

            if (cart_has_accessories(cart) == 1 && running_total > 700 && my_currency() == "USD" && my_country == "CN") {
                pay_now_button += "<h3 style='background-color:FFCCCC'>" + dt("For easier customs clearance, please purchase less than $700 in accessories at one time.") + "</h3>" + paynowanyway + "</li>";
            } else if (customize_enabled() != 1 && has_replacements == 1) {
                pay_now_button += "<h3 style='background-color:FFCCCC'>" + dt("The 'Customize your DE1' feature is not yet available.") + "</h3><br></li>";
            } else if (quantity_of_de1 == 1 && cart_has_accessories(cart) == 0) {

                if (my_country != "US") {                
                    pay_now_button += "<a href='/support/checkout' onclick=\"javascript:set_shipper_to_cheapest_if_unset()\" class=\"button special big icon fa-sign-out\"><div style=\"display:inline\" class=\"no-print\">" + dt("Pay now") + "</div>&nbsp;" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</a><br>" + dt("This is your final cost, shipped to your address.") + "<br>" + dt("All taxes are prepaid.  There will be no other fees.") + "</li>";
                } else {
                    //pay_now_button += "<a href='/support/checkout' onclick=\"javascript:set_shipper_to_cheapest_if_unset()\" class=\"button special big icon fa-sign-out\"><div style=\"display:inline\" class=\"no-print\">" + dt("Pay now") + "</div>&nbsp;" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</a><br>" + dt("This is your final cost, shipped to your address.") + "<br>" + dt("New tariffs imposed by the USA have not yet been fully implemented nor clarified.") + dt("You might have an additional $180 tax bill to pay after you receive your machine, or you might not: at this point in time things are unclear.") + "</li>";
                    pay_now_button += "<a href='/support/checkout' onclick=\"javascript:set_shipper_to_cheapest_if_unset()\" class=\"button special big icon fa-sign-out\"><div style=\"display:inline\" class=\"no-print\">" + dt("Pay now") + "</div>&nbsp;" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</a><br>" + "</li>";
                }
            } else if (quantity_of_de1 == 0 && cart_has_accessories(cart) == 1) {
                pay_now_button += "<a href='/support/checkout' onclick=\"javascript:set_shipper_to_cheapest_if_unset()\" class=\"button special big icon fa-sign-out\"><div style=\"display:inline\" class=\"no-print\">" + dt("Pay now") + " </div>" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</a></li>";
                if (my_country != "US") {

                    if (we_pay_taxes == 1 && is_full_declaration_country(my_country) != 1 ) {
                        pay_now_button += "<br>" + dt("You will not have any taxes to pay. We will pay them for you before shipping.");
                    } else if (is_accessory_duty_paid_country(my_country) == 1 && Cookies.get('expedited') != 1) {
                        // "We pay the import tariff for you." is already shown above for this
                        // country/cart — don't contradict it with the postman import-tax note.
                    } else if (my_country == "HK") {
                        // Hong Kong is domestic (we ship from HK) — no import tax to pay.
                    } else {
                        pay_now_button += "<br>" + dt("You may need to pay import tax to your postman on delivery of this order.");
                    }
                }

            } else {
                pay_now_button += "<a href='/support/checkout' onclick=\"javascript:set_shipper_to_cheapest_if_unset()\" class=\"button special big icon fa-sign-out\"><div style=\"display:inline\" class=\"no-print\">" + dt("Pay now") + " </div>" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</a></li>";
            }


        } else if (ushops_available != 0 || shop_and_ship_available != 0 || myus_available != 0 || tiptrans_available != 0) {

            if (cart_has_accessories(cart) == 1 && is_expedited_only_accessories_country(my_country) != 1) {
                pay_now_button += "<a xhref='/support/checkout' style='background-color: #FFFF00;' class=\"button special big icon fa-sign-out\"><div style=\"display:inline\" class=\"no-print\">" + dt("We do not ship coffee accessories directly to") + " " + dt(countries[my_country.toUpperCase()]) + " </div>" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</a></li><h3 style='background-color: #FFFF00;' >"+dt("Please remove the coffee accessories from your cart or ship to another country and use a reshipping service.") + "</h3>";
            } else {
                pay_now_button += "<a href='/support/checkout' onclick=\"javascript:set_shipper_to_cheapest_if_unset()\" class=\"button special big icon fa-sign-out\"><div style=\"display:inline\" class=\"no-print\">" + dt("Pay now") + " </div>" + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</a></li>";
            }
        } 

        // small text under PAY NOW listing the payment methods available for this
        // country/currency (only when a real Pay-now button was rendered).
        if (pay_now_button.indexOf("set_shipper_to_cheapest_if_unset") != -1) {
            pay_now_button += "<div id='paymethods_blurb' class='no-print' style='font-size:smaller;color:#777;margin-top:6px'>" + ((window.paymethods_cache && window.paymethods_cache[paymethods_key()]) ? window.paymethods_cache[paymethods_key()] : "") + "</div>";
        }
        pay_now_button += "<br><a class='button small' href='/contact?savecart=1&subject=" + dt("Cart") + " %23cartid" + "&body=" + dt("I have a question about this shopping cart.") + "'>" + dt("or contact us about this order") + "</a>"
        pay_now_button += "</div>"

        // printer only version
        pay_now_button += "<div class='print-only'><b>" + " = " + my_currency_price(numberWithCommas(nt(two_decimal_places(running_total)))) + "</b></div>";
    }


    
    if (shipping_disabled_countries.indexOf(my_country) > -1) {
        var warning = "<b><h2><font style='background-color: pink;'>" + dt(shipping_disabled_message) + "<br></font></h2>";
        tablehtml += "<tr bgcolor=FFFFFF><td width=100% xbgcolor=FFFFFF colspan=12 align=right style='background-color: #ffffff'  bgcolor=FFFFFF >" + warning + "</b></td></tr>";
        pay_now_button = "";
    }


    //tablehtml += "<tr bgcolor=FFFFFF><td width=100% xbgcolor=FFFFFF colspan=4 align=right bgcolor=FFFFFF >" + pay_now_button + "</b>" + dt("We accept most credit cards, Paypal and bank wires") + "</td></tr>";
    tablehtml += "<tr bgcolor=FFFFFF><td width=100% xbgcolor=FFFFFF colspan=4 align=right style='background-color: #ffffff'  bgcolor=FFFFFF >" + pay_now_button + "</b></td></tr>";
    tablehtml += "</table>";

    return tablehtml;
}

function customize_enabled () {
    return 1
}

function check_shipto_change () {

    var value = dropdown_selected_value('shipto');
    if (value == 0) {
        window.location = '/support/address';
    } else {
        window.location = '/support/checkout?addressid=' + value;
    }

}

function check_cart_change () {
    var value = dropdown_selected_value('cartid');
    window.location = '/support/carts?cartid=' + value;
}

function check_cart_admin_change () {
    var value = dropdown_selected_value('cartid');
    window.location = '/admin/carts?cartid=' + value + "&userid=" + document.getElementById("userid").value;
}

function check_cart_shipwhen_change () {
    var value = dropdown_selected_value('cartid');
    window.location = '/admin/carts?cartid=' + value + "&userid=" + document.getElementById("userid").value + "&ship_when=" + document.getElementById("ship_when").value;
}

function check_cart_payment_admin_change () {
    var value = dropdown_selected_value('cartid');
    window.location = '/admin/carts?newpayment=' + document.getElementById("newpaymentid").value + '&cartid=' + value + "&userid=" + document.getElementById("userid").value;
}

function check_orders_change () {
    var value = dropdown_selected_value('cartid');
    window.location = '/support/orders?cartid=' + value;
}

function check_packinglist_admin_change () {
    var value = dropdown_selected_value('cartid');
    var sort = getUrlVars()['sort'];
    if (sort == "sku") {
        window.location = '?cartid=' + value + "&sort=" + sort;
    } else {
        window.location = '?cartid=' + value;

    }
}


function shopping_cart_reset () {
    Cookies.remove('cart');
    Cookies.remove('freeremove');
    Cookies.remove('free_glass_list');
}

function setdims (l, w, h) {
    document.getElementById("length").value = l;
    document.getElementById("width").value = w;
    document.getElementById("height").value = h;
}



function show_hide_section_with_checkbox (checkboxname, sectionshow, sectionhide) {
    if (CheckboxTo01(checkboxname) == 1) {
        change_class_to_display_inline(sectionshow);
        change_class_to_display_none(sectionhide);
    } else {
        change_class_to_display_none(sectionshow);
        change_class_to_display_inline(sectionhide);
    }
}

function show_hide_billing_address () {

    show_hide_section_with_checkbox('shipaddroptions', 'billaddrbtn', 'shippaddrbtn');

    if (CheckboxTo01('shipaddroptions') == 0) {
        document.getElementById("billing_full_name").value = "";
        document.getElementById("billing_phone").value = "";
        document.getElementById("billing_address_line_1").value = "";
        document.getElementById("billing_address_line_2").value = "";
        document.getElementById("billing_postal_code").value = "";
        document.getElementById("billing_city").value = "";
        document.getElementById("billing_state").value = "";
        document.getElementById("billing_country").value = document.getElementById("country").value;
    }
}

function country_dropdown (inwidth) {
    var choiceskv = [];
    var choicesk = [];
    var choicesk2 = [];
    var choicesk3 = [];


    choiceskv.push("", dt("We ship directly to:"));
	choiceskv.push("", "---");
    choiceskv.push("pickup", dt("Pick up at Decent HK Factory"));
    //for (var abbrev in countries) {
    for (var i = 0; i < countries_we_send_directly.length; i++) {
    	var abbrev = countries_we_send_directly[i];
        var full = countries[abbrev];
        var f = dt(full);
        //choicesk[f + "/" + abbrev] =abbrev;
        choicesk[f] =abbrev;
    }

    var keys = object_keys(choicesk).sort(locale_sort);

    for (var i = 0; i < keys.length; i++) {
        //decent_log(keys[i] + " " + choicesk[ keys[i] ]);
        choiceskv.push(choicesk[ keys[i] ], keys[i]);
    }


	choiceskv.push("", "---");
	choiceskv.push("", dt("We ship indirectly to:"));
	choiceskv.push("", "---");
    for (var i = 0; i < countries_we_send_indirectly.length; i++) {
    	var abbrev = countries_we_send_indirectly[i];
		//decent_log("c: '" + abbrev + "'");

    	if (countries_we_send_directly.includes(abbrev) == true) {
    		// should not happen if list of countries correctly maintained with no overlap
    		//decent_log("skipping country: " + abbrev);
    		continue
    	}
        var full = countries[abbrev];
        var f = dt(full);
        choicesk2[f] =abbrev;
    }

    var keys = object_keys(choicesk2).sort(locale_sort);

    for (var i = 0; i < keys.length; i++) {
        choiceskv.push(choicesk2[ keys[i] ], keys[i]);
    }


    var show_other_countries = 0;

    if (show_other_countries == 1) {
    	choiceskv.push("", "---");
    	choiceskv.push("", dt("Other countries:"));
    	choiceskv.push("", "---");

        for (var abbrev in countries) {
            var full = countries[abbrev];

        	if (countries_we_send_directly.includes(abbrev) == true) {
        		//decent_log("skipping dir country: " + abbrev);
        		continue
        	}

        	if (countries_we_send_indirectly.includes(abbrev) == true) {
        		//decent_log("skipping ind country: " + abbrev);
        		continue
        	}

            var f = dt(full);
            choicesk3[f] =abbrev;
        }

        var keys = object_keys(choicesk3).sort(locale_sort);

        for (var i = 0; i < keys.length; i++) {
            //decent_log(keys[i] + " " + choicesk[ keys[i] ]);
            choiceskv.push(choicesk3[ keys[i] ], keys[i]);
        }
    }


    var html = html_dropdow_with_current_selection ("country", my_country, choiceskv, "update_shipto_country()", inwidth);
    return html;
}



function update_shipper (nm) {
    var shipper = document.getElementById(nm);
    var selected_shipper = document.getElementById(nm).value;
    Cookies.set('selected_shipper', selected_shipper, { expires: 365 });
    shopping_cart_table_update();
}

function admin_change_payment_type () {
    //debugger;

    document.getElementById("credit_amount").readonly = false;
    document.getElementById("actual_amount").readonly = false;
    document.getElementById("fee_amount").readonly = false;

    if (document.getElementById("service").value == "decentllc") {
        document.getElementById("credit_currency").value = "USD";
        document.getElementById("actual_amount_currency").value = "USD";
        document.getElementById("fee_amount_currency").value = "USD";
        document.getElementById("actual_amount").value = two_decimal_places(document.getElementById("credit_amount").value * .90);
        document.getElementById("fee_amount").value = two_decimal_places(document.getElementById("credit_amount").value * .10);
    } else if (document.getElementById("service").value == "stripe") {
        document.getElementById("credit_currency").value = "USD";
        document.getElementById("actual_amount_currency").value = "HKD";
        document.getElementById("fee_amount_currency").value = "HKD";
    } else if (document.getElementById("service").value == "check") {
        document.getElementById("credit_currency").value = "HKD";
        document.getElementById("actual_amount_currency").value = "HKD";
        document.getElementById("fee_amount_currency").value = "HKD";
        document.getElementById("fee_amount").value = "0";
    } else if (document.getElementById("service").value == "free") {
        document.getElementById("credit_amount").value = "0";
        document.getElementById("actual_amount").value = "0";
        document.getElementById("fee_amount").value = "0";

        document.getElementById("credit_amount").readonly = true;
        document.getElementById("actual_amount").readonly = true;
        document.getElementById("fee_amount").readonly = true;

    } else if (document.getElementById("service").value == "cash") {
        document.getElementById("fee_amount").value = "0";
        document.getElementById("fee_amount").readonly = true;

    } else if (document.getElementById("service").value == "credit") {
        document.getElementById("credit_amount").value = "";
        document.getElementById("actual_amount").value = "0";
        document.getElementById("fee_amount").value = "0";
        document.getElementById("fee_amount").readonly = true;
        document.getElementById("actual_amount").readonly = true;
    }
}



function admin_change_refund_amount () {
    //debugger;
    if (document.getElementById("service2").value == "paypal") {
        if (document.getElementById("credit_amount2").value > 0) {
            document.getElementById("credit_amount2").value = document.getElementById("credit_amount2").value * -1;
        }
        if (document.getElementById("fee_amount2").value > 0) {
            document.getElementById("fee_amount2").value = document.getElementById("fee_amount2").value * -1;
        }
        document.getElementById("actual_amount2").value = document.getElementById("credit_amount2").value - document.getElementById("fee_amount2").value;
    } else if (document.getElementById("service2").value == "stripe") {
        if (document.getElementById("credit_amount2").value > 0) {
            document.getElementById("credit_amount2").value = document.getElementById("credit_amount2").value * -1;
        }
        if (document.getElementById("fee_amount2").value > 0) {
            document.getElementById("fee_amount2").value = document.getElementById("fee_amount2").value * -1;
        }
        if (document.getElementById("actual_amount2").value > 0) {
            document.getElementById("actual_amount2").value = document.getElementById("actual_amount2").value * -1;
        }
    } else {
        // other services, such as amazon
        if (document.getElementById("credit_amount2").value > 0) {
            document.getElementById("credit_amount2").value = document.getElementById("credit_amount2").value * -1;
        }
        if (document.getElementById("fee_amount2").value > 0) {
            document.getElementById("fee_amount2").value = document.getElementById("fee_amount2").value * -1;
        }
        document.getElementById("actual_amount2").value = document.getElementById("credit_amount2").value - document.getElementById("fee_amount2").value;
    }

}

function changed_model () {
