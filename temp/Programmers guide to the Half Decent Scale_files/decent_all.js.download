    // de1+ discontinud, so this test is no longer doing anything
    if (modelnumber == 0) {
        if (volume != 0) {
            //document.getElementById('de1_volume').checked = false;
            //decent_log("DE1+ chosen so checking low volume");
        }
    } else {
        if (volume == 0) {
            //document.getElementById('de1_volume').checked = true;
            //decent_log("DE1PRO/XL chosen so checking high volume");
        }
    }

    calc_sku();
}

function changed_volume () {
    return;
    // obsolete
    var modelnumber = getRadioValueByName('de1pro_xl_black');
    //var volume = CheckboxTo01('de1_volume');

    if (volume == 0) {
        if (modelnumber != 0) {
            //document.getElementById('de1plus').click();
            document.getElementById('de1plus').checked = true;
            decent_log("Low volume to changing to DE1+");
        }
    } else {
        if (modelnumber == 0) {
            //document.getElementById('de1pro').click() = true;
            document.getElementById('de1pro').checked = true;
            decent_log("High volume changing so switching to DE1PRO");
        }
    }

    calc_sku();
}

